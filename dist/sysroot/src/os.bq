# std.os — environment and arguments
module std.os

extern c {
    fn buraaq_os_getenv(name: c.text) -> c.text
    fn buraaq_os_argc() -> c.int
    fn buraaq_os_argv(index: c.int) -> c.text
    fn buraaq_exit(code: c.int) -> void
}

# Stop the process with an exit code. Does not return.
pub fn exit(code: int) {
    unsafe { buraaq_exit(code) }
}

pub fn getenv(name: text) -> text {
    unsafe { buraaq_os_getenv(name.to_c()) }
}

pub fn args() -> int {
    unsafe { buraaq_os_argc() }
}

pub fn arg(i: int) -> text {
    unsafe { buraaq_os_argv(i) }
}
