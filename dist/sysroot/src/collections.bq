# std.collections — dynamic data structures
#
# A vector is a sequence that grows on push. One slot holds either an int or a
# text, so there is an int and a text call for each operation; the vector does
# not remember which was stored, and reading an int slot as text misinterprets
# it. Push and read the same kind.
#
#   v = vec_new()
#   vec_push_int(v, 3)
#   n = vec_get_int(v, 0)
#   vec_free(v)
#
# Reads outside the vector give 0 or "" rather than failing.
module std.collections

# A set holds text keys and answers membership without scanning, so building up
# a collection of names costs the same per name however many are already in it.
#
#   s = set_new()
#   set_add(s, "x")        # 1 the first time, 0 after
#   if set_has(s, "x") { ... }
#   set_free(s)

extern c {
    fn buraaq_set_new() -> c.text
    fn buraaq_set_add(s: c.text, key: c.text) -> c.int
    fn buraaq_set_has(s: c.text, key: c.text) -> c.int
    fn buraaq_set_add_csv(s: c.text, csv: c.text) -> void
    fn buraaq_set_len(s: c.text) -> c.int
    fn buraaq_set_free(s: c.text) -> void
    fn buraaq_vec_new() -> c.text
    fn buraaq_vec_len(v: c.text) -> c.int
    fn buraaq_vec_push_int(v: c.text, x: c.int) -> void
    fn buraaq_vec_push_text(v: c.text, s: c.text) -> void
    fn buraaq_vec_get_int(v: c.text, i: c.int) -> c.int
    fn buraaq_vec_get_text(v: c.text, i: c.int) -> c.text
    fn buraaq_vec_set_int(v: c.text, i: c.int, x: c.int) -> void
    fn buraaq_vec_set_text(v: c.text, i: c.int, s: c.text) -> void
    fn buraaq_vec_free(v: c.text) -> void
}

pub fn set_new() -> text {
    unsafe { buraaq_set_new() }
}

# 1 when the key was added, 0 when it was already there.
pub fn set_add(s: text, key: text) -> int {
    unsafe { buraaq_set_add(s, key) }
}

pub fn set_has(s: text, key: text) -> int {
    unsafe { buraaq_set_has(s, key) }
}

# Add every comma-separated entry of `csv`, ignoring empty ones.
pub fn set_add_csv(s: text, csv: text) {
    unsafe { buraaq_set_add_csv(s, csv) }
}

pub fn set_len(s: text) -> int {
    unsafe { buraaq_set_len(s) }
}

pub fn set_free(s: text) {
    unsafe { buraaq_set_free(s) }
}

pub fn vec_new() -> text {
    unsafe { buraaq_vec_new() }
}

pub fn vec_len(v: text) -> int {
    unsafe { buraaq_vec_len(v.to_c()) }
}

pub fn vec_push_int(v: text, x: int) {
    unsafe { buraaq_vec_push_int(v.to_c(), x) }
}

pub fn vec_push_text(v: text, s: text) {
    unsafe { buraaq_vec_push_text(v.to_c(), s.to_c()) }
}

pub fn vec_get_int(v: text, i: int) -> int {
    unsafe { buraaq_vec_get_int(v.to_c(), i) }
}

pub fn vec_get_text(v: text, i: int) -> text {
    unsafe { buraaq_vec_get_text(v.to_c(), i) }
}

pub fn vec_set_int(v: text, i: int, x: int) {
    unsafe { buraaq_vec_set_int(v.to_c(), i, x) }
}

pub fn vec_set_text(v: text, i: int, s: text) {
    unsafe { buraaq_vec_set_text(v.to_c(), i, s) }
}

pub fn vec_free(v: text) {
    unsafe { buraaq_vec_free(v.to_c()) }
}
