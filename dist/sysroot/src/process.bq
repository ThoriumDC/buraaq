# std.process — child processes
#
# Arguments go through an argv builder rather than a command string, so no
# shell is involved and nothing needs escaping:
#
#   a = argv_new()
#   argv_push(a, "clang")
#   argv_push(a, "-o")
#   argv_push(a, "out.exe")
#   code = argv_run(a)
#   argv_free(a)
module std.process

extern c {
    fn buraaq_process_exit_code(cmd: c.text) -> c.int
    fn buraaq_argv_new() -> c.int
    fn buraaq_argv_push(handle: c.int, arg: c.text) -> c.int
    fn buraaq_process_run(handle: c.int) -> c.int
    fn buraaq_argv_free(handle: c.int) -> void
}

pub struct Command {
    program: text

    fn run(self) -> int {
        unsafe { buraaq_process_exit_code(self.program.to_c()) }
    }
}

pub fn cmd(program: text) -> Command {
    Command { program: program }
}

# Open an argument vector. Returns a handle, or -1 if none are free.
pub fn argv_new() -> int {
    unsafe { buraaq_argv_new() }
}

# Append one argument. The first is the program to run. Spaces and quotes are
# passed through literally — there is no shell to re-interpret them.
pub fn argv_push(handle: int, arg: text) -> int {
    unsafe { buraaq_argv_push(handle, arg.to_c()) }
}

# Run to completion and return the exit code, or -1 if it could not start.
pub fn argv_run(handle: int) -> int {
    unsafe { buraaq_process_run(handle) }
}

pub fn argv_free(handle: int) {
    unsafe { buraaq_argv_free(handle) }
}
