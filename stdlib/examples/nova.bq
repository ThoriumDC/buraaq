# NOVA — neon arena shooter. Click the NOVA window, then play.
fn overlap(ax: int, ay: int, aw: int, ah: int, bx: int, by: int, bw: int, bh: int) -> int {
    if ax + aw < bx {
        return 0
    }
    if bx + bw < ax {
        return 0
    }
    if ay + ah < by {
        return 0
    }
    if by + bh < ay {
        return 0
    }
    1
}

fn glow(x: int, y: int, w: int, h: int, r: int, g: int, b: int) {
    ink(r / 6, g / 6, b / 6)
    box(x - 4, y - 4, w + 8, h + 8)
    ink(r / 2, g / 2, b / 2)
    box(x - 2, y - 2, w + 4, h + 4)
    ink(r, g, b)
    box(x, y, w, h)
}

fn ship(x: int, y: int, flash: int) {
    if flash == 1 {
        ink(255, 255, 255)
        box(x - 8, y - 12, 16, 22)
    } else {
        glow(x - 7, y - 2, 14, 12, 40, 220, 255)
        ink(20, 80, 100)
        box(x - 10, y + 2, 6, 8)
        box(x + 4, y + 2, 6, 8)
        ink(180, 255, 255)
        box(x - 2, y - 12, 4, 10)
    }
}

fn digit(n: int, x: int, y: int) {
    a = 0
    b = 0
    c = 0
    d = 0
    e = 0
    f = 0
    g = 0
    if n == 0 {
        a = 1
        b = 1
        c = 1
        d = 1
        e = 1
        f = 1
    }
    if n == 1 {
        b = 1
        c = 1
    }
    if n == 2 {
        a = 1
        b = 1
        g = 1
        e = 1
        d = 1
    }
    if n == 3 {
        a = 1
        b = 1
        g = 1
        c = 1
        d = 1
    }
    if n == 4 {
        f = 1
        g = 1
        b = 1
        c = 1
    }
    if n == 5 {
        a = 1
        f = 1
        g = 1
        c = 1
        d = 1
    }
    if n == 6 {
        a = 1
        f = 1
        g = 1
        e = 1
        c = 1
        d = 1
    }
    if n == 7 {
        a = 1
        b = 1
        c = 1
    }
    if n == 8 {
        a = 1
        b = 1
        c = 1
        d = 1
        e = 1
        f = 1
        g = 1
    }
    if n == 9 {
        a = 1
        b = 1
        c = 1
        d = 1
        f = 1
        g = 1
    }
    ink(90, 230, 255)
    if a == 1 {
        box(x + 1, y, 10, 2)
    }
    if b == 1 {
        box(x + 10, y + 1, 2, 10)
    }
    if c == 1 {
        box(x + 10, y + 13, 2, 10)
    }
    if d == 1 {
        box(x + 1, y + 22, 10, 2)
    }
    if e == 1 {
        box(x + 0, y + 13, 2, 10)
    }
    if f == 1 {
        box(x + 0, y + 1, 2, 10)
    }
    if g == 1 {
        box(x + 1, y + 11, 10, 2)
    }
}

fn scoreboard(v: int, x: int, y: int) {
    digit((v / 1000) % 10, x, y)
    digit((v / 100) % 10, x + 16, y)
    digit((v / 10) % 10, x + 32, y)
    digit(v % 10, x + 48, y)
}

fn logo(x: int, y: int) {
    ink(40, 220, 255)
    box(x, y, 6, 48)
    box(x + 30, y, 6, 48)
    dash(x + 4, y + 4, x + 32, y + 44)
    dash(x + 5, y + 4, x + 33, y + 44)
    box(x + 48, y, 36, 6)
    box(x + 48, y + 42, 36, 6)
    box(x + 48, y, 6, 48)
    box(x + 78, y, 6, 48)
    dash(x + 100, y + 4, x + 118, y + 46)
    dash(x + 136, y + 4, x + 118, y + 46)
    dash(x + 101, y + 4, x + 119, y + 46)
    dash(x + 137, y + 4, x + 119, y + 46)
    box(x + 152, y + 18, 6, 30)
    box(x + 186, y + 18, 6, 30)
    box(x + 152, y + 18, 40, 6)
    dash(x + 154, y + 18, x + 170, y)
    dash(x + 188, y + 18, x + 172, y)
}

fn main() {
    println("NOVA — click the NOVA window")
    println("A/D or arrows move, space fire, escape quit")
    canvas(640, 360, "NOVA")

    starx = [20]
    stary = [40]
    stard = [1]
    i = 1
    while i < 36 {
        starx.push((i * 91 + 17) % 640)
        stary.push((i * 47 + 9) % 360)
        stard.push(1 + (i % 3))
        i = i + 1
    }

    balive = [0]
    bx = [0]
    by = [0]
    i = 1
    while i < 18 {
        balive.push(0)
        bx.push(0)
        by.push(0)
        i = i + 1
    }

    ealive = [0]
    ex = [0]
    ey = [0]
    ehp = [0]
    i = 1
    while i < 14 {
        ealive.push(0)
        ex.push(0)
        ey.push(0)
        ehp.push(0)
        i = i + 1
    }

    palive = [0]
    px = [0]
    py = [0]
    pvx = [0]
    pvy = [0]
    i = 1
    while i < 40 {
        palive.push(0)
        px.push(0)
        py.push(0)
        pvx.push(0)
        pvy.push(0)
        i = i + 1
    }

    # x y cool hp hurt score wave spawn seed shake kills flash mode
    p = [320, 300, 0, 3, 0, 0, 1, 16, 19, 0, 0, 0, 0]
    cam = [0, 0]
    tmp = [0, 0, 0, 0]
    z = [0]

    while held("quit") == 0 {
        if held("escape") {
            break
        }

        ink(6, 8, 16)
        wipe()
        i = 0
        while i < starx.len() {
            stary[i] = stary[i] + stard[i]
            if stary[i] > 360 {
                stary[i] = 0
                starx[i] = (starx[i] + 47) % 640
            }
            ink(40 + stard[i] * 40, 50 + stard[i] * 40, 70 + stard[i] * 50)
            plot(starx[i], stary[i])
            i = i + 1
        }

        cam[0] = 0
        cam[1] = 0
        if p[9] > 0 {
            cam[0] = p[9] % 3
            cam[0] = cam[0] - 1
            cam[1] = p[9] / 2
            cam[1] = cam[1] % 3
            cam[1] = cam[1] - 1
            p[9] = p[9] - 1
        }

        if p[12] == 0 {
            logo(210, 70)
            ink(70, 140, 180)
            box(248, 210, 144, 3)
            z[0] = pulse()
            z[0] = z[0] / 20
            z[0] = z[0] % 2
            if z[0] == 0 {
                ink(200, 240, 255)
                box(268, 240, 8, 8)
                box(280, 240, 8, 8)
                box(292, 240, 8, 8)
                box(316, 240, 8, 8)
                box(328, 240, 8, 8)
                box(340, 240, 8, 8)
                box(352, 240, 8, 8)
            }
            ink(90, 160, 190)
            box(80, 320, 480, 2)
            if held("space") {
                p[0] = 320
                p[1] = 300
                p[2] = 0
                p[3] = 3
                p[4] = 0
                p[5] = 0
                p[6] = 1
                p[7] = 16
                p[9] = 0
                p[10] = 0
                p[11] = 0
                p[12] = 1
                i = 0
                while i < balive.len() {
                    balive[i] = 0
                    i = i + 1
                }
                i = 0
                while i < ealive.len() {
                    ealive[i] = 0
                    i = i + 1
                }
                i = 0
                while i < palive.len() {
                    palive[i] = 0
                    i = i + 1
                }
            }
        } elif p[12] == 2 {
            logo(210, 50)
            scoreboard(p[5], 286, 140)
            ink(220, 70, 90)
            box(220, 190, 200, 4)
            z[0] = pulse()
            z[0] = z[0] / 18
            z[0] = z[0] % 2
            if z[0] == 0 {
                ink(255, 200, 200)
                box(270, 230, 100, 8)
            }
            if held("space") {
                p[12] = 0
            }
        } else {
            if held("left") {
                p[0] = p[0] - 6
            }
            if held("a") {
                p[0] = p[0] - 6
            }
            if held("right") {
                p[0] = p[0] + 6
            }
            if held("d") {
                p[0] = p[0] + 6
            }
            if held("up") {
                p[1] = p[1] - 6
            }
            if held("w") {
                p[1] = p[1] - 6
            }
            if held("down") {
                p[1] = p[1] + 6
            }
            if p[0] < 18 {
                p[0] = 18
            }
            if p[0] > 622 {
                p[0] = 622
            }
            if p[1] < 40 {
                p[1] = 40
            }
            if p[1] > 338 {
                p[1] = 338
            }

            if p[2] > 0 {
                p[2] = p[2] - 1
            }
            if held("space") {
                if p[2] == 0 {
                    i = 0
                    tmp[0] = 0
                    while i < balive.len() {
                        if tmp[0] == 0 {
                            if balive[i] == 0 {
                                balive[i] = 1
                                bx[i] = p[0]
                                by[i] = p[1] - 16
                                tmp[0] = 1
                                p[2] = 7
                            }
                        }
                        i = i + 1
                    }
                }
            }

            i = 0
            while i < balive.len() {
                if balive[i] == 1 {
                    by[i] = by[i] - 10
                    if by[i] < 8 {
                        balive[i] = 0
                    }
                }
                i = i + 1
            }

            p[7] = p[7] - 1
            if p[7] < 1 {
                p[8] = p[8] * 41
                p[8] = p[8] + 7
                if p[8] < 0 {
                    p[8] = p[8] * 0
                    p[8] = p[8] + 19
                }
                i = 0
                tmp[0] = 0
                while i < ealive.len() {
                    if tmp[0] == 0 {
                        if ealive[i] == 0 {
                            ealive[i] = 1
                            ex[i] = 30 + p[8] % 580
                            ey[i] = 12
                            ehp[i] = 1 + p[6] / 3
                            tmp[0] = 1
                            p[7] = 28 - p[6] * 2
                            if p[7] < 8 {
                                p[7] = 8
                            }
                        }
                    }
                    i = i + 1
                }
            }

            i = 0
            while i < ealive.len() {
                if ealive[i] == 1 {
                    tmp[1] = p[6] / 5
                    if ex[i] < p[0] {
                        ex[i] = ex[i] + 1 + tmp[1]
                    }
                    if ex[i] > p[0] {
                        ex[i] = ex[i] - 1 - tmp[1]
                    }
                    tmp[1] = p[6] / 4
                    ey[i] = ey[i] + 1 + tmp[1]
                    if ey[i] > 370 {
                        ealive[i] = 0
                    }
                    j = 0
                    while j < balive.len() {
                        if balive[j] == 1 {
                            if overlap(bx[j] - 2, by[j] - 6, 4, 12, ex[i] - 8, ey[i] - 8, 16, 16) == 1 {
                                balive[j] = 0
                                ehp[i] = ehp[i] - 1
                                k = 0
                                tmp[2] = 0
                                while k < palive.len() {
                                    if tmp[2] < 6 {
                                        if palive[k] == 0 {
                                            palive[k] = 10
                                            px[k] = ex[i]
                                            py[k] = ey[i]
                                            pvx[k] = k % 5
                                            pvx[k] = pvx[k] - 2
                                            pvy[k] = k % 3
                                            pvy[k] = pvy[k] - 2
                                            tmp[2] = tmp[2] + 1
                                        }
                                    }
                                    k = k + 1
                                }
                                if ehp[i] < 1 {
                                    ealive[i] = 0
                                    p[5] = p[5] + 10 + p[6] * 2
                                    p[10] = p[10] + 1
                                    p[9] = 5
                                    tmp[3] = p[6] * 8
                                    if p[10] > tmp[3] {
                                        p[6] = p[6] + 1
                                        p[10] = 0
                                    }
                                }
                            }
                        }
                        j = j + 1
                    }
                    if p[4] == 0 {
                        if overlap(p[0] - 8, p[1] - 10, 16, 20, ex[i] - 8, ey[i] - 8, 16, 16) == 1 {
                            ealive[i] = 0
                            p[3] = p[3] - 1
                            p[4] = 40
                            p[9] = 12
                            if p[3] < 1 {
                                p[12] = 2
                            }
                        }
                    }
                }
                i = i + 1
            }

            if p[4] > 0 {
                p[4] = p[4] - 1
            }
            p[11] = 0
            if p[4] > 0 {
                z[0] = p[4] / 3
                z[0] = z[0] % 2
                if z[0] == 0 {
                    p[11] = 1
                }
            }

            i = 0
            while i < palive.len() {
                if palive[i] > 0 {
                    px[i] = px[i] + pvx[i]
                    py[i] = py[i] + pvy[i]
                    palive[i] = palive[i] - 1
                }
                i = i + 1
            }

            i = 0
            while i < ealive.len() {
                if ealive[i] == 1 {
                    glow(ex[i] - 7 + cam[0], ey[i] - 7 + cam[1], 14, 14, 255, 60, 110)
                    ink(255, 180, 80)
                    box(ex[i] - 3 + cam[0], ey[i] - 3 + cam[1], 6, 6)
                }
                i = i + 1
            }
            i = 0
            while i < balive.len() {
                if balive[i] == 1 {
                    glow(bx[i] - 2 + cam[0], by[i] - 8 + cam[1], 4, 12, 255, 230, 90)
                }
                i = i + 1
            }
            i = 0
            while i < palive.len() {
                if palive[i] > 0 {
                    ink(255, 120 + palive[i] * 8, 80)
                    box(px[i] + cam[0], py[i] + cam[1], 3, 3)
                }
                i = i + 1
            }
            ship(p[0] + cam[0], p[1] + cam[1], p[11])

            ink(10, 16, 28)
            box(0, 0, 640, 28)
            scoreboard(p[5], 12, 2)
            ink(40, 220, 255)
            box(100, 10, p[6] * 8, 8)
            h = 0
            while h < p[3] {
                glow(560 + h * 22, 8, 14, 10, 40, 255, 160)
                h = h + 1
            }
        }

        flip()
        wait(16)
    }
    hush()
}
