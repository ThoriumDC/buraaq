# Constructs the bootstrap parser recognises, for M4 event parity.
# Must parse cleanly on the host: this is real code, not a token soup.

fn ops(a: int, b: int) -> int {
    s = a + b
    d = a - b
    m = a * b
    q = a / b
    r = a % b
    return s + d + m + q + r
}

fn compares(a: int, b: int) -> bool {
    lt = a < b
    le = a <= b
    gt = a > b
    ge = a >= b
    eqx = a == b
    ne = a != b
    return lt && le || gt && ge || eqx || ne
}

fn control(n: int) -> int {
    total = 0
    i = 0
    while i < n {
        total = total + i
        i = i + 1
    }
    for k in 0..n {
        total = total + k
    }
    if total > 100 {
        total = 100
    } elif total > 50 {
        total = 50
    } else {
        total = 0
    }
    return total
}

fn jumps(n: int) -> int {
    seen = 0
    while seen < n {
        seen = seen + 1
        if seen > 3 {
            break
        }
        continue
    }
    return seen
}

fn values(flag: bool) -> int {
    yes = true
    no = false
    label = "text"
    neg = 0 - 7
    if flag {
        return 1
    }
    return 0
}

fn main() {
    print(ops(2, 3))
    print(control(4))
    print(jumps(9))
    print(values(true))
}
