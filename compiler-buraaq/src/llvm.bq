fn l_windows() -> int {
    if eq(getenv("OS"), "Windows_NT") {
        return 1
    }
    0
}

fn l_have_lld() -> int {
    if exists("C:\\Program Files\\LLVM\\bin\\lld-link.exe") {
        return 1
    }
    if exists("/usr/bin/ld.lld") {
        return 1
    }
    0
}

# Compile `src` to `exe` by finding clang and the runtime.
fn build_with(src: text, exe: text, opt: text, g: int) -> int {
    clang = find_clang()
    rt = find_rt()
    st = find_std()
    ll = concat(exe, ".ll")
    write(ll, "")
    ll_emit_module(src, ll)
    a = argv_new()
    argv_push(a, clang)
    argv_push(a, "-Wno-override-module")
    argv_push(a, "-Wno-deprecated-declarations")
    argv_push(a, opt)
    if g == 1 {
        argv_push(a, "-g")
        done = 1
    }
    if l_have_lld() == 1 {
        argv_push(a, "-fuse-ld=lld")
        done = 1
    }
    argv_push(a, "-o")
    argv_push(a, exe)
    argv_push(a, ll)
    argv_push(a, rt)
    if len(st) > 0 {
        argv_push(a, st)
        done = 1
    }
    bd = find_board()
    if len(bd) > 0 {
        argv_push(a, bd)
        done = 1
    }
    ai = find_ai()
    if len(ai) > 0 {
        argv_push(a, ai)
        done = 1
    }
    gd = find_grid()
    if len(gd) > 0 {
        argv_push(a, gd)
        done = 1
    }
    hd = find_hold()
    if len(hd) > 0 {
        argv_push(a, hd)
        done = 1
    }
    sm = find_stream()
    if len(sm) > 0 {
        argv_push(a, sm)
        done = 1
    }
    gx = find_gfx()
    if len(gx) > 0 {
        argv_push(a, gx)
        done = 1
    }
    lm = find_lumen()
    if len(lm) > 0 {
        argv_push(a, lm)
        done = 1
    }
    if l_windows() == 1 {
        argv_push(a, "-D_CRT_SECURE_NO_WARNINGS")
        argv_push(a, "-lwininet")
        argv_push(a, "-ladvapi32")
        argv_push(a, "-lws2_32")
        argv_push(a, "-lgdi32")
        argv_push(a, "-luser32")
        argv_push(a, "-lwinmm")
        argv_push(a, "-Wl,/STACK:16777216")
        done = 1
    } else {
        argv_push(a, "-lpthread")
        argv_push(a, "-lm")
        argv_push(a, "-lssl")
        argv_push(a, "-lcrypto")
        done = 1
    }
    code = argv_run(a)
    argv_free(a)
    if code != 0 {
        eprintln(concat("buraaq-boot: clang failed linking ", exe))
        done = 1
    }
    code
}

pub fn build_auto(src: text, exe: text) -> int {
    build_with(src, exe, "-O2", 0)
}

pub fn build_debug(src: text, exe: text) -> int {
    build_with(src, exe, "-O0", 1)
}

pub fn run_auto(src: text) -> int {
    exe = getenv("BURAAQ_RUN_OUT")
    if len(exe) == 0 {
        tmp = getenv("TEMP")
        if len(tmp) == 0 {
            tmp = getenv("TMP")
            done = 1
        }
        if len(tmp) == 0 {
            tmp = "/tmp"
            done = 1
        }
        exe = concat(tmp, "/buraaq-run.exe")
        done = 1
    }
    code = build_auto(src, exe)
    if code != 0 {
        return code
    }
    a = argv_new()
    argv_push(a, exe)
    code = argv_run(a)
    argv_free(a)
    code
}

pub fn build_file(src: text, exe: text, rt: text, clang: text) {
    ll = concat(exe, ".ll")
    write(ll, "")
    ll_emit_module(src, ll)
    a = argv_new()
    argv_push(a, clang)
    argv_push(a, "-Wno-override-module")
    argv_push(a, "-O0")
    if l_have_lld() == 1 {
        argv_push(a, "-fuse-ld=lld")
        done = 1
    }
    argv_push(a, "-o")
    argv_push(a, exe)
    argv_push(a, ll)
    argv_push(a, rt)
    code = argv_run(a)
    argv_free(a)
    if code == 0 {
        println(concat("buraaq-boot build -> ", exe))
    } else {
        println(concat("buraaq-boot build failed: ", clang))
    }
}

pub fn joinp(a: text, b: text) -> text {
    n = len(a)
    if n == 0 {
        return b
    }
    last = byte(a, n - 1)
    if last == 47 {
        return concat(a, b)
    }
    if last == 92 {
        return concat(a, b)
    }
    concat(a, concat("/", b))
}

pub fn mkdir_all(path: text) {
    n = len(path)
    i = 1
    while i < n {
        c = byte(path, i)
        if c == 47 {
            mkdir(slice(path, 0, i))
            done = 1
        }
        if c == 92 {
            mkdir(slice(path, 0, i))
            done = 1
        }
        i = i + 1
    }
    mkdir(path)
    done = 1
}

fn pkg_key(src: text, key: text) -> text {
    n = len(src)
    kn = len(key)
    i = 0
    while i < n {
        if i + kn <= n {
            if eq(slice(src, i, i + kn), key) {
                j = scan_skip(src, i + kn, n)
                if byte(src, j) == 61 {
                    j = scan_skip(src, j + 1, n)
                    if byte(src, j) == 34 {
                        j = j + 1
                        e = j
                        while e < n {
                            if byte(src, e) == 34 {
                                return slice(src, j, e)
                            }
                            e = e + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    ""
}

pub fn project_entry(root: text) -> text {
    a = joinp(root, "src/main.bq")
    if exists(a) {
        return a
    }
    b = joinp(root, "main.bq")
    if exists(b) {
        return b
    }
    ""
}

pub fn project_name(root: text) -> text {
    pkg = read(joinp(root, "buraaq.pkg"))
    name = pkg_key(pkg, "name")
    if len(name) > 0 {
        return name
    }
    "app"
}

pub fn project_out(root: text) -> text {
    dir = joinp(root, "target/debug")
    mkdir_all(dir)
    joinp(dir, concat(project_name(root), ".exe"))
}

pub fn run_project(root: text) -> int {
    if len(root) > 0 {
        chdir(root)
        done = 1
    }
    src = project_entry(root)
    if len(src) == 0 {
        eprintln("buraaq-boot: no src/main.bq — try `buraaq new myapp --cli`")
        return 1
    }
    run_auto(src)
}

pub fn build_project(root: text) -> int {
    src = project_entry(root)
    if len(src) == 0 {
        eprintln("buraaq-boot: no src/main.bq — try `buraaq new myapp --cli`")
        return 1
    }
    out = project_out(root)
    code = build_auto(src, out)
    if code == 0 {
        println(concat("buraaq-boot build -> ", out))
        done = 1
    }
    code
}

pub fn cmd_new_cli(parent: text, name: text) -> int {
    if len(name) == 0 {
        eprintln("buraaq-boot: buraaq new NAME [--cli]")
        return 1
    }
    root = name
    if len(parent) > 0 {
        root = joinp(parent, name)
    }
    mkdir_all(joinp(root, "src"))
    q = char_of(34)
    nl = char_of(10)
    pkg = concat("[package]", nl)
    pkg = concat(pkg, "name = ")
    pkg = concat(pkg, q)
    pkg = concat(pkg, name)
    pkg = concat(pkg, q)
    pkg = concat(pkg, nl)
    pkg = concat(pkg, "version = ")
    pkg = concat(pkg, q)
    pkg = concat(pkg, "0.1.0")
    pkg = concat(pkg, q)
    pkg = concat(pkg, nl)
    pkg = concat(pkg, "entry = ")
    pkg = concat(pkg, q)
    pkg = concat(pkg, "main")
    pkg = concat(pkg, q)
    pkg = concat(pkg, nl)
    pkg = concat(pkg, "type = ")
    pkg = concat(pkg, q)
    pkg = concat(pkg, "bin")
    pkg = concat(pkg, q)
    pkg = concat(pkg, nl)
    write(joinp(root, "buraaq.pkg"), pkg)
    lb = char_of(123)
    rb = char_of(125)
    body = concat("# ", name)
    body = concat(body, nl)
    body = concat(body, "module main")
    body = concat(body, nl)
    body = concat(body, nl)
    body = concat(body, "fn main() ")
    body = concat(body, lb)
    body = concat(body, nl)
    body = concat(body, "    println(")
    body = concat(body, q)
    body = concat(body, "Hello from ")
    body = concat(body, name)
    body = concat(body, "!")
    body = concat(body, q)
    body = concat(body, ")")
    body = concat(body, nl)
    body = concat(body, rb)
    body = concat(body, nl)
    write(joinp(root, "src/main.bq"), body)
    println(concat("Created `", concat(name, concat("` at ", root))))
    println("  buraaq run")
    0
}