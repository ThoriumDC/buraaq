# M7–M9 LLVM: golden sample + lexer.bq + parser.bq subset (i32/text/bool, while, if/elif/else)
use scan.scan_ident_end
use scan.scan_is_digit
use scan.scan_is_ident_start
use scan.scan_skip
use scan.scan_skip_string
use scan.scan_skip_type
use scan.scan_word_is
use std.collections.set_add
use std.collections.set_add_csv
use std.collections.set_free
use std.collections.set_has
use std.collections.set_new
use std.collections.vec_free
use std.collections.vec_get_text
use std.collections.vec_len
use std.collections.vec_new
use std.collections.vec_push_text
use std.fs.append
use std.fs.exists
use std.fs.mkdir
use std.fs.read
use std.fs.write
use std.io.eprintln
use std.io.println
use std.os.arg
use std.os.exit
use std.os.getenv
use std.process.argv_free
use std.process.argv_new
use std.process.argv_push
use std.process.argv_run
use std.text.byte
use std.text.char_of
use std.text.concat
use std.text.eq
use std.text.len
use std.text.slice

# Append, never read-modify-write: a module is ~30k lines, and re-reading what
# has been emitted so far on each one makes emission quadratic in module size.
# build_file truncates the sink first, so appending starts from empty.
fn l_emit(sink: text, line: text) {
    lined = concat(line, "\n")
    if eq(sink, "-") {
        println(lined)
    } else {
        append(sink, lined)
    }
    done = 1
}

# `{`, `}` and `"` cannot be written as literals here — a brace opens an
# interpolation and a quote closes the string — so they are built from their
# byte values. These used to search `src` for the character, which is a scan of
# the whole file per function and was most of the compiler's running time.
fn l_open(src: text, n: int) -> text {
    char_of(123)
}

fn l_close(src: text, n: int) -> text {
    char_of(125)
}

# Is `name` one of the comma-separated entries of `bag`?
#
# Compares bytes in place. The previous version built `,name,` and `,`+bag and
# then took a fresh slice of the haystack at every offset to compare it, so a
# single lookup allocated once per character of the bag. This is the most called
# function in the compiler — every identifier goes through it — and the bags grow
# with the program.
#
# End of string counts as a separator, so the last entry matches whether or not
# the bag has a trailing comma. It did not before, which quietly meant the final
# keyword of the unsupported list was never rejected.
fn l_bag_has(bag: text, name: text) -> bool {
    nn = len(name)
    hn = len(bag)
    if nn == 0 {
        return false
    }
    k = 0
    while k < hn {
        start = 0
        if k == 0 {
            start = 1
        }
        if k > 0 {
            if byte(bag, k - 1) == 44 {
                start = 1
            }
        }
        if start == 1 {
            if k + nn < hn + 1 {
                j = 0
                while j < nn {
                    if byte(bag, k + j) != byte(name, j) {
                        break
                    }
                    j = j + 1
                }
                if j == nn {
                    if k + nn == hn {
                        return true
                    }
                    if byte(bag, k + nn) == 44 {
                        return true
                    }
                }
            }
        }
        k = k + 1
    }
    false
}

# Constructs this emitter has no lowering for. It parses far enough past them to
# keep going, then emits references to values it never defined, so the failure
# used to surface as a clang error about the generated IR rather than as a
# complaint about the source. Refusing them here keeps the gap visible.
#
# Anything added to the emitter must come off this list in the same change.
fn l_unsupported(nm: text) -> bool {
    if eq(nm, "yield") {
        return true
    }
    false
}

# Reject before emitting anything, reporting every offending line rather than
# only the first, so one run tells you the whole distance to compiling a file.
fn l_check(src: text, n: int, path: text) {
    i = 0
    lno = 1
    bad = 0
    while i < n {
        c = byte(src, i)
        if c == 10 {
            lno = lno + 1
            i = i + 1
        } elif c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    break
                }
                i = i + 1
            }
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                if byte(src, i) == 10 {
                    lno = lno + 1
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            if l_unsupported(nm) {
                eprintln("{path}:{lno}: buraaq-boot cannot lower `{nm}`")
                bad = 1
            }
            i = e
        } else {
            i = i + 1
        }
    }
    if bad == 1 {
        eprintln("buraaq-boot: the bootstrap compiler handles int/text/bool, if/elif/else, while, loop, for, match, const, continue, defer, spawn, fn, modules and calls")
        exit(1)
    }
    done = 1
}

# Value of a `name:value` entry in a bag, or "" when absent. Struct-typed locals
# are recorded as both `p` and `p:Point`, so the plain l_bag_has lookup still
# sees `p` as pointer-shaped while this recovers which struct it is.
fn l_bag_get(bag: text, name: text) -> text {
    needle = concat(",", concat(name, ":"))
    hay = concat(",", bag)
    hn = len(hay)
    nn = len(needle)
    k = 0
    while k < hn {
        if k + nn > hn {
            break
        }
        if eq(slice(hay, k, k + nn), needle) {
            e = k + nn
            while e < hn {
                if byte(hay, e) == 44 {
                    break
                }
                e = e + 1
            }
            return slice(hay, k + nn, e)
        }
        k = k + 1
    }
    ""
}

# Byte offset of `fname` within `sname`, or -1 if there is no such field.
#
# There are no globals in the subset this compiler is written in, so there is no
# struct table to consult; `src` is threaded through every emit function already,
# so the declaration is re-read on each lookup. Fields are one eight-byte slot
# each, wide enough for an i32 or a pointer, which keeps offsets independent of
# field types.
fn l_field_off(src: text, n: int, sname: text, fname: text) -> int {
    i = l_struct_body(src, n, sname)
    if i < 0 {
        return 0 - 1
    }
    slot = 0
    while i < n {
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 125 {
            break
        }
        if scan_word_is(src, i, n, "fn") {
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "drop") {
            i = l_skip_braced(src, i, n)
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            if eq(slice(src, i, e), fname) {
                return slot * 8
            }
            slot = slot + 1
            i = scan_skip(src, e, n)
            if byte(src, i) == 58 {
                i = scan_skip_type(src, i + 1, n)
            }
        } else {
            i = i + 1
        }
    }
    0 - 1
}

# Number of fields in `sname`, which is how many slots to allocate.
fn l_field_count(src: text, n: int, sname: text) -> int {
    i = l_struct_body(src, n, sname)
    if i < 0 {
        return 0
    }
    slot = 0
    while i < n {
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 125 {
            break
        }
        if scan_word_is(src, i, n, "fn") {
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "drop") {
            i = l_skip_braced(src, i, n)
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            slot = slot + 1
            i = scan_skip(src, e, n)
            if byte(src, i) == 58 {
                i = scan_skip_type(src, i + 1, n)
            }
        } else {
            i = i + 1
        }
    }
    slot
}

# Does `sname.fname` hold text? Decides which slot shape to load and store.
fn l_field_is_text(src: text, n: int, sname: text, fname: text) -> bool {
    i = l_struct_body(src, n, sname)
    if i < 0 {
        return false
    }
    while i < n {
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 125 {
            break
        }
        if scan_word_is(src, i, n, "fn") {
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "drop") {
            i = l_skip_braced(src, i, n)
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            hit = 0
            if eq(slice(src, i, e), fname) {
                hit = 1
            }
            i = scan_skip(src, e, n)
            if byte(src, i) == 58 {
                te = scan_skip_type(src, i + 1, n)
                tn = slice(src, scan_skip(src, i + 1, n), scan_ident_end(src, scan_skip(src, i + 1, n), n))
                i = te
                if hit == 1 {
                    return l_type_is_ptr(src, n, tn)
                }
            }
        } else {
            i = i + 1
        }
    }
    false
}

# Declared type name of `sname.fname`, or "" when there is no such field.
fn l_field_type_name(src: text, n: int, sname: text, fname: text) -> text {
    i = l_struct_body(src, n, sname)
    if i < 0 {
        return ""
    }
    while i < n {
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 125 {
            break
        }
        if scan_word_is(src, i, n, "fn") {
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "drop") {
            i = l_skip_braced(src, i, n)
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            hit = 0
            if eq(slice(src, i, e), fname) {
                hit = 1
            }
            i = scan_skip(src, e, n)
            if byte(src, i) == 58 {
                tstart = scan_skip(src, i + 1, n)
                te = scan_ident_end(src, tstart, n)
                tn = slice(src, tstart, te)
                i = scan_skip_type(src, i + 1, n)
                if hit == 1 {
                    return tn
                }
            }
        } else {
            i = i + 1
        }
    }
    ""
}

# Offset just past the `{` of `struct sname`, or -1 when it is not declared.
#
# Comments and string literals are skipped. This compiler's own source contains
# the word `struct` in both — it has to, to compile structs — and matching one of
# those would read a declaration out of prose.
fn l_struct_body(src: text, n: int, sname: text) -> int {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    break
                }
                i = i + 1
            }
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "struct") {
            j = scan_skip(src, i + 6, n)
            e = scan_ident_end(src, j, n)
            if eq(slice(src, j, e), sname) {
                j = scan_skip(src, e, n)
                if byte(src, j) == 91 {
                    j = l_bracket_end(src, j, n)
                    j = scan_skip(src, j, n)
                }
                if byte(src, j) == 123 {
                    return j + 1
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    0 - 1
}

# `type Name = real` → `real`, or `tn` when there is no alias.
fn l_resolve_type(src: text, n: int, tn: text) -> text {
    if len(tn) == 0 {
        return tn
    }
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "type") {
            j = scan_skip(src, i + 4, n)
            e = scan_ident_end(src, j, n)
            if eq(slice(src, j, e), tn) {
                j = scan_skip(src, e, n)
                if byte(src, j) == 61 {
                    j = scan_skip(src, j + 1, n)
                    te = scan_ident_end(src, j, n)
                    if te > j {
                        return slice(src, j, te)
                    }
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    tn
}

fn l_type_is_ptr(src: text, n: int, tn: text) -> bool {
    t = l_resolve_type(src, n, tn)
    if eq(t, "text") {
        return true
    }
    if eq(t, "List") {
        return true
    }
    if l_struct_body(src, n, t) >= 0 {
        return true
    }
    false
}

# Decimal digits to an int. Anything else in the text ends the number.
fn l_int_of(s: text) -> int {
    n = len(s)
    v = 0
    i = 0
    while i < n {
        c = byte(s, i)
        if scan_is_digit(c) {
            v = v * 10 + (c - 48)
            i = i + 1
        } else {
            break
        }
    }
    v
}

# Position just inside `enum <ename> {`, or -1 when there is no such enum.
# Comments and string literals are stepped over so the emitter's own source,
# which names these keywords, does not look like a declaration.
fn l_enum_body(src: text, n: int, ename: text) -> int {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    break
                }
                i = i + 1
            }
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "enum") {
            j = scan_skip(src, i + 4, n)
            e = scan_ident_end(src, j, n)
            if eq(slice(src, j, e), ename) {
                j = scan_skip(src, e, n)
                if byte(src, j) == 91 {
                    j = l_bracket_end(src, j, n)
                    j = scan_skip(src, j, n)
                }
                if byte(src, j) == 123 {
                    return j + 1
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    0 - 1
}

# The value of `<ename>.<vname>`: its position in the declaration, or -1.
#
# A unit variant is a tag. `Enum.Tuple(x)` / `Enum.Struct { f: x }` is a two-slot
# heap object: tag at 0, payload at 8. `match` on that pointer compares the tag
# and binds the payload.
fn l_enum_tag(src: text, n: int, ename: text, vname: text) -> int {
    i = l_enum_body(src, n, ename)
    if i < 0 {
        return 0 - 1
    }
    tag = 0
    while i < n {
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 125 {
            return 0 - 1
        }
        if c == 44 {
            i = i + 1
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            if eq(slice(src, i, e), vname) {
                return tag
            }
            tag = tag + 1
            i = e
        } else {
            i = i + 1
        }
    }
    0 - 1
}

fn l_enum_tag_any(src: text, n: int, vname: text) -> int {
    i = 0
    while i < n {
        if scan_word_is(src, i, n, "enum") {
            j = scan_skip(src, i + 4, n)
            e = scan_ident_end(src, j, n)
            tag = l_enum_tag(src, n, slice(src, j, e), vname)
            if tag >= 0 {
                return tag
            }
        }
        i = i + 1
    }
    0 - 1
}

# Runtime and stdlib names that are not `fn` in the unit. A function defined in
# the source overlays these: l_bag_get takes the first `name:` it sees, so
# collected signatures are concatenated in front.
fn l_builtin_sigs() -> text {
    ",print:0,println:0,print_int:0,print_float:0,print_bool:0,eprintln:0,exit:0,set_add_csv:0,set_free:0,vec_push_int:0,vec_push_text:0,vec_set_int:0,vec_set_text:0,vec_free:0,argv_free:0,stow:0,read:2,slice:2,arg:2,concat:2,char_of:2,set_new:2,vec_new:2,vec_get_text:2,getenv:2,parse:2,stringify:2,sha256:2,field:2,item:2,as_text:2,chat:2,pick:2,lsp_read:2,jpath_text:2,len:1,byte:1,eq:1,set_add:1,set_has:1,set_len:1,vec_len:1,vec_get_int:1,args:1,argv_new:1,argv_push:1,argv_run:1,write:1,append:1,exists:1,mkdir:1,chdir:1,abs_int:1,model:1,on:0,off:0,wait:0,printf:0,system:0,row:1,eye:1,hold:1,rows:1,as_int:1,kind:1,count:1,jpath_int:1,bur_pack:1,bur_launch:1,put_file:1,dock_run:1,index_run:1,sin:3,sqrt:3,clamp:3,dot:3,at:3,col_mean:3,async_io_read_line:2,read_line:2,page:0,api:0,run:0,store:0,key:0,origin:0,call:2,zeros:1,ones:1,from_csv:1,stream:1,hail:1,wire:1,say:1,hear:2,hangup:0,run_stream:0,clip:1,shot:1,heard:2,canvas:1,ink:0,wipe:0,plot:0,box:0,dash:0,flip:0,held:1,pulse:1,play:0,tone:0,hush:0,lsp_write:0,"
}

# Std module leaf names. `use io` means std.io unless the project has src/io.bq.
# std.service is an alias of keel and is not counted in uniqueness.
fn l_std_mod(m: text) -> int {
    if eq(m, "io") {
        return 1
    }
    if eq(m, "fs") {
        return 1
    }
    if eq(m, "text") {
        return 1
    }
    if eq(m, "os") {
        return 1
    }
    if eq(m, "math") {
        return 1
    }
    if eq(m, "grid") {
        return 1
    }
    if eq(m, "hold") {
        return 1
    }
    if eq(m, "stream") {
        return 1
    }
    if eq(m, "keel") {
        return 1
    }
    if eq(m, "service") {
        return 1
    }
    if eq(m, "http") {
        return 1
    }
    if eq(m, "json") {
        return 1
    }
    if eq(m, "crypto") {
        return 1
    }
    if eq(m, "time") {
        return 1
    }
    if eq(m, "net") {
        return 1
    }
    if eq(m, "db") {
        return 1
    }
    if eq(m, "led") {
        return 1
    }
    if eq(m, "ai") {
        return 1
    }
    if eq(m, "process") {
        return 1
    }
    if eq(m, "collections") {
        return 1
    }
    if eq(m, "sync") {
        return 1
    }
    if eq(m, "async") {
        return 1
    }
    if eq(m, "thread") {
        return 1
    }
    if eq(m, "lumen") {
        return 1
    }
    if eq(m, "flowdesk") {
        return 1
    }
    if eq(m, "gfx") {
        return 1
    }
    0
}

fn l_user_module(dir: text, m: text) -> int {
    leaf = concat(m, ".bq")
    if exists(concat(dir, leaf)) {
        return 1
    }
    if exists(concat(dir, concat("src/", leaf))) {
        return 1
    }
    0
}

# A `use` line names this std leaf (`use db` or `use std.db`).
fn l_has_std_use(src: text, mod: text) -> int {
    n = len(src)
    i = 0
    while i < n {
        if scan_word_is(src, i, n, "use") {
            k = scan_skip(src, i + 3, n)
            e = scan_ident_end(src, k, n)
            m = slice(src, k, e)
            if eq(m, "std") {
                if byte(src, e) == 46 {
                    k2 = e + 1
                    e2 = scan_ident_end(src, k2, n)
                    m = slice(src, k2, e2)
                }
            }
            if eq(m, mod) {
                return 1
            }
        }
        while i < n {
            if byte(src, i) == 10 {
                i = i + 1
                break
            }
            i = i + 1
        }
    }
    0
}

# Names exported by more than one real std module. service is keel, so it
# does not collide. Hint is empty when the name is unique.
fn l_std_collide(name: text) -> text {
    if eq(name, "connect") {
        return "connect is db.connect and net.connect; write use db or use net"
    }
    if eq(name, "show") {
        return "show is lumen.show and flowdesk.show; write use lumen or use flowdesk"
    }
    if eq(name, "keep") {
        return "keep is hold.keep and lumen.keep; write use hold or use lumen"
    }
    ""
}

# Every `fn name(...) -> T` in `src` as `name:0` (void), `name:1` (int/bool) or
# `name:2` (text). No list of compiler functions remains; a newly written
# `fn greet() -> text` is text because its signature says so.
fn l_collect_sigs(src: text, n: int, bag: text) -> text {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    break
                }
                i = i + 1
            }
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "fn") {
            j = scan_skip(src, i + 2, n)
            e = scan_ident_end(src, j, n)
            fname = slice(src, j, e)
            j = scan_skip(src, e, n)
            if byte(src, j) == 91 {
                bag = concat(bag, concat("g$", concat(fname, ":1,")))
                while j < n {
                    if byte(src, j) == 93 {
                        j = j + 1
                        break
                    }
                    j = j + 1
                }
                j = scan_skip(src, j, n)
            }
            if byte(src, j) == 40 {
                d = 1
                j = j + 1
                while j < n {
                    pc = byte(src, j)
                    if pc == 40 {
                        d = d + 1
                    }
                    if pc == 41 {
                        d = d - 1
                        if d == 0 {
                            j = j + 1
                            break
                        }
                    }
                    if pc == 34 {
                        j = l_str_skip_esc(src, j, n)
                    } else {
                        j = j + 1
                    }
                }
            }
            j = scan_skip(src, j, n)
            if scan_word_is(src, j, n, "throws") {
                j = scan_skip(src, j + 6, n)
                j = scan_skip_type(src, j, n)
                j = scan_skip(src, j, n)
            }
            tag = "0"
            if byte(src, j) == 45 {
                if byte(src, j + 1) == 62 {
                    j = scan_skip(src, j + 2, n)
                    te = scan_ident_end(src, j, n)
                    tn = slice(src, j, te)
                    tag = "1"
                    if scan_word_is(src, j, n, "c") {
                        j2 = scan_skip(src, j + 1, n)
                        if byte(src, j2) == 46 {
                            j = scan_skip(src, j2 + 1, n)
                            te = scan_ident_end(src, j, n)
                            tn = slice(src, j, te)
                        }
                    }
                    if eq(tn, "text") {
                        tag = "2"
                    }
                    if eq(tn, "Option") {
                        tag = "2"
                    }
                    if eq(tn, "Result") {
                        tag = "2"
                    }
                    if eq(tn, "float") {
                        tag = "3"
                    }
                    if eq(tn, "f64") {
                        tag = "3"
                    }
                    if eq(tn, "f32") {
                        tag = "3"
                    }
                    if eq(tn, "void") {
                        tag = "0"
                    }
                    j = scan_skip_type(src, j, n)
                }
            }
            bag = concat(bag, concat(fname, concat(":", concat(tag, ","))))
            i = j
        } elif scan_word_is(src, i, n, "dyn") {
            i = i + 3
        } else {
            i = i + 1
        }
    }
    bag
}

# First `dyn Trait` parameter of each function, as `d$fname:Trait`.
fn l_collect_dyn(src: text, n: int, bag: text) -> text {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "fn") {
            j = scan_skip(src, i + 2, n)
            e = scan_ident_end(src, j, n)
            fname = slice(src, j, e)
            j = scan_skip(src, e, n)
            if byte(src, j) == 91 {
                j = l_bracket_end(src, j, n)
                j = scan_skip(src, j, n)
            }
            if byte(src, j) == 40 {
                j = j + 1
            }
            hops = 0
            while j < n {
                hops = hops + 1
                if hops > n {
                    break
                }
                j = scan_skip(src, j, n)
                if byte(src, j) == 41 {
                    break
                }
                if scan_word_is(src, j, n, "dyn") {
                    j = scan_skip(src, j + 3, n)
                    te = scan_ident_end(src, j, n)
                    tn = slice(src, j, te)
                    if len(tn) > 0 {
                        bag = concat(bag, concat("d$", concat(fname, concat(":", concat(tn, ",")))))
                    }
                    break
                }
                if byte(src, j) == 44 {
                    j = j + 1
                } else {
                    j = j + 1
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    bag
}

fn l_skip_line(src: text, idx: int, n: int) -> int {
    i = idx
    while i < n {
        if byte(src, i) == 10 {
            return i + 1
        }
        i = i + 1
    }
    i
}

fn l_store_const(sink: text, seen: text, nm: text, v: int) -> text {
    if len(nm) == 0 {
        return seen
    }
    seen = l_need_local(sink, seen, nm)
    head = "  store i32 {v}, i32* %"
    l_emit(sink, concat(head, concat(nm, ".i")))
    seen
}

fn l_take_const_spill(src: text, n: int, j: int, sink: text, seen: text) -> text {
    if j >= n {
        return seen
    }
    if scan_is_ident_start(byte(src, j)) {
        k = scan_ident_end(src, j, n)
        nm = slice(src, j, k)
        k = scan_skip(src, k, n)
        if k < n {
            if byte(src, k) == 58 {
                k = scan_skip(src, k + 1, n)
                k = scan_ident_end(src, k, n)
                k = scan_skip(src, k, n)
            }
        }
        if k < n {
            if byte(src, k) == 61 {
                k = scan_skip(src, k + 1, n)
                neg = 0
                if k < n {
                    if byte(src, k) == 45 {
                        neg = 1
                        k = k + 1
                    }
                }
                v = 0
                while k < n {
                    if scan_is_digit(byte(src, k)) {
                        d = byte(src, k)
                        d = d - 48
                        v = v * 10
                        v = v + d
                        k = k + 1
                    } else {
                        break
                    }
                }
                if neg == 1 {
                    v = 0 - v
                }
                seen = l_store_const(sink, seen, nm, v)
            }
        }
        done = 1
    }
    seen
}

# Integer `const` / `static` into every function as `%NAME.i`.
fn l_spill_consts(sink: text, seen: text, src: text, n: int) -> text {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_word_is(src, i, n, "const") {
            seen = l_take_const_spill(src, n, scan_skip(src, i + 5, n), sink, seen)
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "static") {
            seen = l_take_const_spill(src, n, scan_skip(src, i + 6, n), sink, seen)
            i = l_skip_line(src, i, n)
        } elif scan_is_ident_start(c) {
            i = scan_ident_end(src, i, n)
        } else {
            i = i + 1
        }
    }
    seen
}

fn l_rt(name: text, sigs: text) -> int {
    v = l_bag_get(sigs, name)
    if eq(v, "0") {
        return 0
    }
    if eq(v, "2") {
        return 2
    }
    if eq(v, "3") {
        return 3
    }
    1
}

fn l_skip_mut(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    hops = 0
    while hops < 4 {
        hops = hops + 1
        if scan_word_is(src, i, n, "mut") {
            i = scan_skip(src, i + 3, n)
        } elif scan_word_is(src, i, n, "ref") {
            i = scan_skip(src, i + 3, n)
        } else {
            break
        }
    }
    i
}

fn l_is_float_at(src: text, idx: int, n: int) -> int {
    i = idx
    if byte(src, i) == 45 {
        i = i + 1
    }
    if scan_is_digit(byte(src, i)) {
        return l_num_is_float(src, idx, n)
    }
    0
}

# Past `if cond {` so a peek can see the then-arm's value.
fn l_skip_if_cond(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if scan_word_is(src, i, n, "if") {
        i = scan_skip(src, i + 2, n)
    }
    if scan_word_is(src, i, n, "elif") {
        i = scan_skip(src, i + 4, n)
    }
    while i < n {
        c = byte(src, i)
        if c == 123 {
            return scan_skip(src, i + 1, n)
        }
        if c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } else {
            i = i + 1
        }
    }
    i
}

# Walk `.meth()` / `[]` after a primary so `c.get().to_text()` and
# `lock()[].to_text()` are text, not the first hop's int.
fn l_peek_dots(src: text, idx: int, n: int, ptxt: text, sigs: text, last: int, curty: text) -> int {
    j = scan_skip(src, idx, n)
    hops = 0
    cur = last
    ty = curty
    while hops < 6 {
        hops = hops + 1
        if byte(src, j) == 91 {
            j = l_bracket_end(src, j, n)
            cur = 1
            j = scan_skip(src, j, n)
        } elif byte(src, j) == 46 {
            fe = scan_ident_end(src, j + 1, n)
            meth = slice(src, j + 1, fe)
            j = scan_skip(src, fe, n)
            if byte(src, j) != 40 {
                nxt = l_field_type_name(src, n, ty, meth)
                if l_field_is_text(src, n, ty, meth) {
                    cur = 2
                } elif l_type_is_ptr(src, n, nxt) {
                    cur = 2
                } else {
                    cur = 1
                }
                if len(nxt) > 0 {
                    ty = nxt
                }
            } elif eq(meth, "to_text") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "field") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "chat") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "to_c") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "new") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "bounded") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "lock") {
                cur = 2
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "len") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "is_empty") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "is_null") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "lt") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "recv") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } elif eq(meth, "send") {
                cur = 1
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            } else {
                mrt = l_rt(meth, sigs)
                if mrt == 2 {
                    cur = 2
                } elif mrt == 3 {
                    cur = 3
                } else {
                    cur = 1
                }
                j = l_skip_call_args(src, j, n)
                j = scan_skip(src, j, n)
            }
        } else {
            return cur
        }
    }
    cur
}

fn l_peek_want(src: text, idx: int, n: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 34 {
        return 2
    }
    if byte(src, i) == 38 {
        return 2
    }
    if byte(src, i) == 91 {
        return 2
    }
    if byte(src, i) == 123 {
        return 2
    }
    if l_is_float_at(src, i, n) == 1 {
        return 3
    }
    if scan_word_is(src, i, n, "true") {
        return 4
    }
    if scan_word_is(src, i, n, "false") {
        return 4
    }
    if scan_word_is(src, i, n, "await") {
        return l_peek_want(src, scan_skip(src, i + 5, n), n, ptxt, sigs)
    }
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        name = slice(src, i, e)
        j = scan_skip(src, e, n)
        if byte(src, j) == 40 {
            last = 1
            rt = l_rt(name, sigs)
            if rt == 2 {
                last = 2
            }
            if rt == 3 {
                last = 3
            }
            if eq(l_bag_get(sigs, concat("g$", name)), "1") {
                argw = l_peek_want(src, scan_skip(src, j + 1, n), n, ptxt, sigs)
                if argw == 2 {
                    last = 2
                }
                if argw == 3 {
                    last = 3
                }
            }
            if eq(name, "some") {
                last = l_peek_want(src, scan_skip(src, j + 1, n), n, ptxt, sigs)
            }
            if eq(name, "Some") {
                last = l_peek_want(src, scan_skip(src, j + 1, n), n, ptxt, sigs)
            }
            if eq(name, "ok") {
                last = l_peek_want(src, scan_skip(src, j + 1, n), n, ptxt, sigs)
            }
            if eq(name, "Ok") {
                last = l_peek_want(src, scan_skip(src, j + 1, n), n, ptxt, sigs)
            }
            return l_peek_dots(src, l_skip_call_args(src, j, n), n, ptxt, sigs, last, "")
        }
        if eq(name, "if") {
            return l_peek_want(src, l_skip_if_cond(src, i, n), n, ptxt, sigs)
        }
        if eq(name, "none") {
            return 2
        }
        if eq(name, "None") {
            return 2
        }
        if eq(name, "new") {
            return 2
        }
        if eq(name, "spawn") {
            return 2
        }
        if eq(name, "spawn_task") {
            k = scan_skip(src, e, n)
            if scan_word_is(src, k, n, "async") {
                k = scan_skip(src, k + 5, n)
            }
            if byte(src, k) == 123 {
                return l_peek_want(src, scan_skip(src, k + 1, n), n, ptxt, sigs)
            }
            return 2
        }
        if eq(name, "async") {
            k = scan_skip(src, e, n)
            if byte(src, k) == 123 {
                return l_peek_want(src, scan_skip(src, k + 1, n), n, ptxt, sigs)
            }
            return 2
        }
        if eq(name, "unsafe") {
            return l_peek_want(src, scan_skip(src, e, n), n, ptxt, sigs)
        }
        if byte(src, j) == 91 {
            br = l_bracket_end(src, j, n)
            after = scan_skip(src, br, n)
            if byte(src, after) == 123 {
                j = after
            }
            if byte(src, after) == 46 {
                j = after
            }
        }
        # A struct value is a pointer, so it lands in the same slot as text.
        if byte(src, j) == 123 {
            if l_looks_struct(name) {
                if l_struct_body(src, n, name) >= 0 {
                    return 2
                }
            }
        }
        if byte(src, j) == 46 {
            fe = scan_ident_end(src, j + 1, n)
            meth = slice(src, j + 1, fe)
            last = 1
            if eq(meth, "to_text") {
                last = 2
            } elif eq(meth, "field") {
                last = 2
            } elif eq(meth, "chat") {
                last = 2
            } elif eq(meth, "to_c") {
                last = 2
            } elif eq(meth, "new") {
                last = 2
            } elif eq(meth, "bounded") {
                last = 2
            } elif eq(meth, "lock") {
                last = 2
            } elif eq(meth, "len") {
                last = 1
            } else {
                mrt = l_rt(meth, sigs)
                if mrt == 2 {
                    last = 2
                } elif mrt == 3 {
                    last = 3
                } elif l_enum_tag(src, n, name, meth) >= 0 {
                    last = 1
                    ke = scan_skip(src, fe, n)
                    if byte(src, ke) == 40 {
                        last = 2
                    }
                    if byte(src, ke) == 123 {
                        last = 2
                    }
                } elif l_field_is_text(src, n, l_bag_get(ptxt, name), meth) {
                    last = 2
                } else {
                    last = 1
                }
            }
            k = scan_skip(src, fe, n)
            curty = ""
            if byte(src, k) == 40 {
                k = l_skip_call_args(src, k, n)
            } else {
                curty = l_field_type_name(src, n, l_bag_get(ptxt, name), meth)
            }
            return l_peek_dots(src, k, n, ptxt, sigs, last, curty)
        }
        # `xs[i]` is an int unless the local was filled with a text vec.
        if byte(src, j) == 91 {
            tag = l_bag_get(ptxt, name)
            if eq(tag, "vt") {
                return 2
            }
            if eq(tag, "mt") {
                return 2
            }
            return 1
        }
        # ptxt holds this function's text parameters plus the locals l_text_locals
        # inferred from their assignments, so spelling no longer decides a type.
        if eq(l_bag_get(ptxt, name), "b") {
            return 4
        }
        if eq(l_bag_get(ptxt, name), "f") {
            return 3
        }
        if eq(l_bag_get(ptxt, name), "r") {
            return 1
        }
        if l_bag_has(ptxt, name) {
            return 2
        }
        return 1
    }
    1
}

fn l_val(want: int, pos: int) -> text {
    if want == 2 {
        return "%p{pos}"
    }
    if want == 3 {
        return "%t{pos}f"
    }
    "%t{pos}l"
}

fn l_is_call(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        j = scan_skip(src, e, n)
        if byte(src, j) == 40 {
            return 1
        }
        done = 1
    }
    0
}

fn l_arg_slot(src: text, start: int, end: int, want: int, n: int) -> int {
    slot = start
    if want == 1 {
        slot = l_plus_in(src, start, end)
        done = 1
    }
    if want == 2 {
        slot = l_plus_in(src, start, end)
        done = 1
    }
    if want == 3 {
        slot = l_plus_in(src, start, end)
        done = 1
    }
    slot
}

# Position of the last operator at the top level of src[a..b), or a if there is
# none. The result of a binary expression is named after its operator, so this
# is the slot the value lands in. Operators nested in parentheses or inside a
# string belong to a subexpression and must not be picked.
fn l_plus_in(src: text, a: int, b: int) -> int {
    plus = a
    k = a
    depth = 0
    while k < b {
        c = byte(src, k)
        # The expression ends at the line break; a trailing comment is not part
        # of it and its prose can contain operator bytes.
        if c == 10 {
            break
        }
        if c == 35 {
            break
        }
        if c == 34 {
            k = k + 1
            while k < b {
                if byte(src, k) == 34 {
                    break
                }
                k = l_str_skip_esc(src, k, b)
            }
        } elif c == 40 {
            depth = depth + 1
        } elif c == 41 {
            depth = depth - 1
        } elif depth == 0 {
            if scan_word_is(src, k, b, "as") {
                k = scan_skip_type(src, scan_skip(src, k + 2, b), b)
                k = k - 1
            } elif c == 43 {
                plus = k
            }
            if c == 45 {
                plus = k
            }
            if c == 42 {
                plus = k
            }
            if c == 47 {
                plus = k
            }
            if c == 37 {
                plus = k
            }
            # `??` is one operator, named at its first `?`. A lone `?` is
            # postfix propagation and must not steal the value slot.
            if c == 63 {
                if byte(src, k + 1) == 63 {
                    plus = k
                    k = k + 1
                }
            }
        }
        k = k + 1
    }
    plus
}

fn l_load(sink: text, name: text, want: int, pos: int, ptxt: text) {
    if eq(l_bag_get(ptxt, name), "r") {
        l_emit(sink, "  %t{pos}l = load i32, i32* %{name}")
        done = 1
    } elif want == 2 {
        l_emit(sink, "  %p{pos} = load i8*, i8** %{name}.p")
        done = 1
    }
    if want == 1 {
        if eq(l_bag_get(ptxt, name), "r") {
            done = 1
        } else {
            l_emit(sink, "  %t{pos}l = load i32, i32* %{name}.i")
            done = 1
        }
    }
    if want == 4 {
        l_emit(sink, "  %t{pos}l = load i32, i32* %{name}.i")
        done = 1
    }
    if want == 3 {
        l_emit(sink, "  %t{pos}f = load double, double* %{name}.f")
        done = 1
    }
    done = 1
}

# Position just past the `]` that closes the `[` at `idx`.
fn l_bracket_end(src: text, idx: int, n: int) -> int {
    i = idx + 1
    d = 1
    while i < n {
        c = byte(src, i)
        if c == 91 {
            d = d + 1
            done = 1
        }
        if c == 93 {
            d = d - 1
            if d == 0 {
                return i + 1
            }
            done = 1
        }
        i = i + 1
    }
    i
}

fn l_rparen(src: text, idx: int, n: int) -> int {
    i = idx
    d = 1
    while i < n {
        c = byte(src, i)
        if c == 40 {
            d = d + 1
            done = 1
        }
        if c == 41 {
            d = d - 1
            if d == 0 {
                return i + 1
            }
            done = 1
        }
        i = i + 1
    }
    i
}

fn l_paren_alias(sink: text, pos: int, inner: int, want: int) {
    if want == 2 {
        l_emit(sink, "  %p{pos} = bitcast i8* %p{inner} to i8*")
        done = 1
    }
    if want == 1 {
        l_emit(sink, "  %t{pos}l = add i32 %t{inner}c, 0")
        done = 1
    }
    done = 1
}

fn l_to_text(sink: text, pos: int) {
    l_emit(sink, "  %p{pos} = call i8* @buraaq_i32_to_text(i32 %t{pos}l)")
    done = 1
}

# Marker bags (`f`, `r`, `vt`…) are not type names. A real struct or impl
# type is used to mangle `obj.meth` → `Type_meth` so two `greet` impls
# do not emit the same `@greet`.
fn l_recv_fn(recv: text, meth: text) -> text {
    if len(recv) == 0 {
        return meth
    }
    if eq(recv, "f") {
        return meth
    }
    if eq(recv, "r") {
        return meth
    }
    if eq(recv, "vt") {
        return meth
    }
    if eq(recv, "mt") {
        return meth
    }
    if eq(recv, "mi") {
        return meth
    }
    if eq(recv, "b") {
        return meth
    }
    if eq(recv, "d") {
        return meth
    }
    if eq(recv, "t") {
        return meth
    }
    concat(recv, concat("_", meth))
}

fn l_recv_tag(ptxt: text, name: text) -> text {
    tag = l_bag_get(ptxt, name)
    if l_bag_has(ptxt, name) {
        if len(tag) == 0 {
            return "t"
        }
    }
    tag
}

fn l_quote(src: text, n: int) -> text {
    char_of(34)
}

fn l_llvm_esc_byte(b: int, q: text) -> text {
    if b == 92 {
        return "\\\\"
    }
    if b == 10 {
        return "\\0A"
    }
    if b == 13 {
        return "\\0D"
    }
    if b == 9 {
        return "\\09"
    }
    if b == 0 {
        return "\\00"
    }
    if b == 34 {
        return concat("\\", q)
    }
    slice("?", 0, 0)
}

fn l_decoded_len(src: text, a: int, b: int) -> int {
    k = a
    n = 0
    while k < b {
        if byte(src, k) == 92 {
            if k + 1 < b {
                k = k + 2
                n = n + 1
            } else {
                k = k + 1
                n = n + 1
            }
        } else {
            k = k + 1
            n = n + 1
        }
    }
    n
}

fn l_llvm_esc_span(src: text, a: int, b: int, q: text) -> text {
    out = slice(src, 0, 0)
    k = a
    while k < b {
        if byte(src, k) == 92 {
            if k + 1 < b {
                nxt = byte(src, k + 1)
                ch = nxt
                if nxt == 110 {
                    ch = 10
                }
                if nxt == 116 {
                    ch = 9
                }
                if nxt == 114 {
                    ch = 13
                }
                if nxt == 48 {
                    ch = 0
                }
                if nxt == 92 {
                    ch = 92
                }
                if nxt == 34 {
                    ch = 34
                }
                piece = l_llvm_esc_byte(ch, q)
                if eq(piece, slice(src, 0, 0)) {
                    piece = slice(src, k + 1, k + 2)
                }
                out = concat(out, piece)
                k = k + 2
            } else {
                out = concat(out, "\\\\")
                k = k + 1
            }
        } else {
            b0 = byte(src, k)
            piece = l_llvm_esc_byte(b0, q)
            if eq(piece, slice(src, 0, 0)) {
                piece = slice(src, k, k + 1)
            }
            out = concat(out, piece)
            k = k + 1
        }
    }
    out
}

fn l_intern_span(src: text, a: int, b: int, sink: text, q: text) {
    ln = l_decoded_len(src, a, b) + 1
    esc = l_llvm_esc_span(src, a, b, q)
    g = concat("@.s{a} = private unnamed_addr constant [{ln} x i8] c", q)
    g = concat(g, esc)
    g = concat(g, "\\00")
    g = concat(g, q)
    l_emit(sink, g)
    done = 1
}

fn l_str_skip_esc(src: text, i: int, n: int) -> int {
    if byte(src, i) == 92 {
        if i + 1 < n {
            return i + 2
        }
    }
    i + 1
}

fn l_str(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    i = idx + 1
    s = i
    step = 0
    lastw = 0
    while i < n {
        if byte(src, i) == 34 {
            if s < i {
                ln = l_decoded_len(src, s, i) + 1
                if step == 0 {
                    l_emit(sink, "  %p{idx} = getelementptr [{ln} x i8], [{ln} x i8]* @.s{s}, i32 0, i32 0")
                    done = 1
                } else {
                    l_emit(sink, "  %pt{idx}{step} = getelementptr [{ln} x i8], [{ln} x i8]* @.s{s}, i32 0, i32 0")
                    l_emit(sink, "  %p{idx} = call i8* @buraaq_text_concat(i8* %w{idx}{lastw}, i8* %pt{idx}{step})")
                    done = 1
                }
            } else {
                if step == 0 {
                    l_emit(sink, "  %p{idx} = getelementptr [1 x i8], [1 x i8]* @.s{s}, i32 0, i32 0")
                    done = 1
                } else {
                    l_emit(sink, "  %p{idx} = bitcast i8* %w{idx}{lastw} to i8*")
                    done = 1
                }
            }
            l_emit(sink, "  %t{idx}l = add i32 0, 0")
            return i + 1
        }
        if byte(src, i) == 123 {
            if s < i {
                ln = l_decoded_len(src, s, i) + 1
                if step == 0 {
                    l_emit(sink, "  %w{idx}0 = getelementptr [{ln} x i8], [{ln} x i8]* @.s{s}, i32 0, i32 0")
                    lastw = 0
                    step = 1
                } else {
                    l_emit(sink, "  %pt{idx}{step} = getelementptr [{ln} x i8], [{ln} x i8]* @.s{s}, i32 0, i32 0")
                    l_emit(sink, "  %w{idx}{step} = call i8* @buraaq_text_concat(i8* %w{idx}{lastw}, i8* %pt{idx}{step})")
                    lastw = step
                    step = step + 1
                }
            }
            j = i + 1
            closed = 0
            while j < n {
                if byte(src, j) == 125 {
                    inner = i + 1
                    txt = l_peek_want(src, inner, n, ptxt, sigs)
                    l_or(src, inner, n, sink, txt, ptxt, sigs)
                    ip = l_arg_slot(src, inner, j, txt, n)
                    if txt == 2 {
                        l_emit(sink, "  %pi{idx}{step} = bitcast i8* %p{ip} to i8*")
                        done = 1
                    } elif txt == 4 {
                        l_emit(sink, "  %bc{idx}{step} = icmp eq i32 %t{ip}l, 1")
                        l_emit(sink, "  %pi{idx}{step} = select i1 %bc{idx}{step}, i8* getelementptr ([5 x i8], [5 x i8]* @.true, i32 0, i32 0), i8* getelementptr ([6 x i8], [6 x i8]* @.false, i32 0, i32 0)")
                        done = 1
                    } else {
                        l_emit(sink, "  %pi{idx}{step} = call i8* @buraaq_i32_to_text(i32 %t{ip}l)")
                        done = 1
                    }
                    if step == 0 {
                        l_emit(sink, "  %w{idx}0 = bitcast i8* %pi{idx}{step} to i8*")
                        lastw = 0
                        step = 1
                    } else {
                        l_emit(sink, "  %w{idx}{step} = call i8* @buraaq_text_concat(i8* %w{idx}{lastw}, i8* %pi{idx}{step})")
                        lastw = step
                        step = step + 1
                    }
                    i = j + 1
                    s = i
                    closed = 1
                    break
                }
                j = j + 1
            }
            # `{` with no `}` before the end of the file left `i` on the brace,
            # and the scan around it never moved again.
            if closed == 0 {
                i = n
                s = n
            }
        } else {
            i = l_str_skip_esc(src, i, n)
        }
    }
    i
}

# Value of a digit in base 16, or -1 when the byte is not one.
fn l_hex_digit(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    0 - 1
}

# `0x` / `0b` literal starting at idx, or -1 when there is none. Returns the
# radix so the caller can both measure and evaluate it.
fn l_radix_of(src: text, idx: int, n: int) -> int {
    if byte(src, idx) != 48 {
        return 0 - 1
    }
    c = byte(src, idx + 1)
    if c == 120 {
        return 16
    }
    if c == 88 {
        return 16
    }
    if c == 98 {
        return 2
    }
    if c == 66 {
        return 2
    }
    0 - 1
}

fn l_radix_end(src: text, idx: int, n: int, radix: int) -> int {
    i = idx + 2
    while i < n {
        c = byte(src, i)
        if c == 95 {
            i = i + 1
        } else {
            d = l_hex_digit(c)
            if d < 0 {
                break
            }
            if d >= radix {
                break
            }
            i = i + 1
        }
    }
    i
}

fn l_radix_value(src: text, idx: int, n: int, radix: int) -> int {
    v = 0
    i = idx + 2
    while i < n {
        c = byte(src, i)
        if c == 95 {
            i = i + 1
        } else {
            d = l_hex_digit(c)
            if d < 0 {
                break
            }
            if d >= radix {
                break
            }
            v = v * radix + d
            i = i + 1
        }
    }
    v
}

# Run of digits, `_` separators included.
fn l_digits_end(src: text, idx: int, n: int) -> int {
    i = idx
    while i < n {
        c = byte(src, i)
        if scan_is_digit(c) {
            i = i + 1
        } elif c == 95 {
            i = i + 1
        } else {
            break
        }
    }
    i
}

# End of the numeric literal at idx, counting `_` separators, a fractional part,
# and an exponent. Stopping at the separator left `_000_000` and `e23` behind as
# identifiers, and the emitter then loaded locals by those names.
fn l_num_end(src: text, idx: int, n: int) -> int {
    i = idx
    if byte(src, i) == 45 {
        i = i + 1
    }
    rx = l_radix_of(src, i, n)
    if rx > 0 {
        return l_radix_end(src, i, n, rx)
    }
    i = l_digits_end(src, i, n)
    if i + 1 < n {
        if byte(src, i) == 46 {
            if scan_is_digit(byte(src, i + 1)) {
                i = l_digits_end(src, i + 1, n)
            }
        }
    }
    c = byte(src, i)
    isexp = 0
    if c == 101 {
        isexp = 1
    }
    if c == 69 {
        isexp = 1
    }
    if isexp == 1 {
        j = i + 1
        if byte(src, j) == 43 {
            j = j + 1
        } elif byte(src, j) == 45 {
            j = j + 1
        }
        if scan_is_digit(byte(src, j)) {
            i = l_digits_end(src, j, n)
        }
    }
    i
}

fn l_num_is_float(src: text, idx: int, n: int) -> int {
    i = idx
    if byte(src, i) == 45 {
        i = i + 1
    }
    if l_radix_of(src, i, n) > 0 {
        return 0
    }
    i = l_digits_end(src, i, n)
    if i + 1 < n {
        if byte(src, i) == 46 {
            if scan_is_digit(byte(src, i + 1)) {
                return 1
            }
        }
    }
    c = byte(src, i)
    if c == 101 {
        return 1
    }
    if c == 69 {
        return 1
    }
    0
}

# Integer literal text with separators removed, so LLVM is handed a number.
fn l_num_text(src: text, a: int, b: int) -> text {
    out = ""
    i = a
    while i < b {
        c = byte(src, i)
        if c == 95 {
            i = i + 1
        } else {
            out = concat(out, char_of(c))
            i = i + 1
        }
    }
    out
}

# Float literal text, normalised for LLVM: separators dropped, `E` lowercased,
# and a `.0` inserted when there is an exponent but no fractional part, because
# LLVM rejects `1e23` while accepting `1.0e23`.
fn l_float_text(src: text, a: int, b: int) -> text {
    out = ""
    sawdot = 0
    i = a
    while i < b {
        c = byte(src, i)
        isexp = 0
        if c == 101 {
            isexp = 1
        }
        if c == 69 {
            isexp = 1
        }
        if c == 95 {
            i = i + 1
        } elif c == 46 {
            sawdot = 1
            out = concat(out, char_of(c))
            i = i + 1
        } elif isexp == 1 {
            if sawdot == 0 {
                out = concat(out, ".0")
                sawdot = 1
            }
            out = concat(out, "e")
            i = i + 1
        } else {
            out = concat(out, char_of(c))
            i = i + 1
        }
    }
    out
}

fn l_emit_num(sink: text, pos: int, src: text, i: int, n: int) -> int {
    start = i
    e = l_num_end(src, i, n)
    # LLVM writes integer constants in decimal, so `0xFF` is evaluated here and
    # interpolated as its value rather than passed through.
    neg = 0
    b = i
    if byte(src, b) == 45 {
        neg = 1
        b = b + 1
    }
    rx = l_radix_of(src, b, n)
    if rx > 0 {
        v = l_radix_value(src, b, n, rx)
        if neg == 1 {
            v = 0 - v
        }
        l_emit(sink, "  %t{pos} = add i32 {v}, 0")
        l_emit(sink, "  %t{pos}l = add i32 %t{pos}, 0")
        return e
    }
    if l_num_is_float(src, i, n) == 1 {
        num = l_float_text(src, start, e)
        l_emit(sink, concat("  %t{pos}f = fadd double ", concat(num, ", 0.0")))
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        return e
    }
    num = l_num_text(src, start, e)
    l_emit(sink, concat("  %t{pos} = add i32 ", concat(num, ", 0")))
    l_emit(sink, "  %t{pos}l = add i32 %t{pos}, 0")
    e
}

fn l_skip_call_args(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        return l_rparen(src, i + 1, n)
    }
    i
}

# Method calls chained onto the value already in `pos`: `n.to_text()`,
# `doc.field("k")`, `t.wait()`.
#
# Returns `idx` untouched when there is no `.name(` here. Skipping whitespace
# before returning would move the end of the expression past the line break, and
# the caller scans that range for the operator its result is named after — which
# is how a `+` on the following line became the slot a block returned.
# `Mutex.new(v)` boxes `v`; `Channel[T].bounded(n)` is a queue (a vec).
fn l_type_ctor(src: text, meth: text, par: int, n: int, sink: text, pos: int, ptxt: text, sigs: text) -> int {
    ap = scan_skip(src, par + 1, n)
    if eq(meth, "new") {
        ae = l_or(src, ap, n, sink, 1, ptxt, sigs)
        aval = l_val(1, l_arg_slot(src, ap, ae, 1, n))
        l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 2)")
        l_emit(sink, "  %vr{pos} = bitcast i8* %p{pos} to i8*")
        l_emit(sink, "  %nf{pos} = bitcast i8* %p{pos} to i32*")
        l_emit(sink, concat("  store i32 ", concat(aval, ", i32* %nf{pos}")))
        l_emit(sink, "  %mu{pos} = call i8* @buraaq_mutex_new()")
        l_emit(sink, "  %ms{pos} = getelementptr i8, i8* %p{pos}, i32 8")
        l_emit(sink, "  %mp{pos} = bitcast i8* %ms{pos} to i8**")
        l_emit(sink, "  store i8* %mu{pos}, i8** %mp{pos}")
        return l_skip_call_args(src, par, n)
    }
    if eq(meth, "bounded") {
        ae = l_or(src, ap, n, sink, 1, ptxt, sigs)
        aval = l_val(1, l_arg_slot(src, ap, ae, 1, n))
        l_emit(sink, concat("  %p{pos} = call i8* @buraaq_chan_new(i32 ", concat(aval, ")")))
        l_emit(sink, "  %vr{pos} = bitcast i8* %p{pos} to i8*")
        return l_skip_call_args(src, par, n)
    }
    par
}

# `lock()[]` reads the boxed i32 through the receiver already in `%vr{pos}`.
fn l_tail_index(src: text, idx: int, n: int, sink: text, pos: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 91 {
        nxt = scan_skip(src, i + 1, n)
        if byte(src, nxt) == 93 {
            l_emit(sink, "  %gd{pos} = bitcast i8* %vr{pos} to i32*")
            l_emit(sink, "  %t{pos}l = load i32, i32* %gd{pos}")
            return nxt + 1
        }
    }
    i
}

fn l_methods_on(src: text, idx: int, n: int, sink: text, pos: int, ptxt: text, sigs: text, recv: text) -> int {
    i = idx
    hops = 0
    while hops < 6 {
        hops = hops + 1
        d = scan_skip(src, i, n)
        if byte(src, d) != 46 {
            return i
        }
        fe = scan_ident_end(src, d + 1, n)
        meth = slice(src, d + 1, fe)
        j = scan_skip(src, fe, n)
        if byte(src, j) != 40 {
            return i
        }
        ap = scan_skip(src, j + 1, n)
        if eq(meth, "to_text") {
            if eq(recv, "f") {
                l_emit(sink, "  %p{pos} = call i8* @buraaq_f64_to_text(double %t{pos}f)")
                done = 1
            } else {
                l_to_text(sink, pos)
                done = 1
            }
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "to_c") {
            l_emit(sink, "  %p{pos} = bitcast i8* %vr{pos} to i8*")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "len") {
            l_emit(sink, "  %t{pos}l = call i32 @buraaq_vec_len(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "is_empty") {
            l_emit(sink, "  %ln{pos} = call i32 @buraaq_vec_len(i8* %vr{pos})")
            l_emit(sink, "  %ie{pos} = icmp eq i32 %ln{pos}, 0")
            l_emit(sink, "  %t{pos}l = zext i1 %ie{pos} to i32")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "send") {
            aspos = ap
            ae = l_or(src, ap, n, sink, 1, ptxt, sigs)
            aval = l_val(1, l_arg_slot(src, aspos, ae, 1, n))
            l_emit(sink, concat("  %t{pos}l = call i32 @buraaq_chan_send(i8* %vr{pos}, i32 ", concat(aval, ")")))
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "recv") {
            l_emit(sink, "  %t{pos}l = call i32 @buraaq_chan_recv(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "is_null") {
            l_emit(sink, "  %nl{pos} = icmp eq i8* %vr{pos}, null")
            l_emit(sink, "  %t{pos}l = zext i1 %nl{pos} to i32")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "lt") {
            if eq(recv, "t") {
                aspos = ap
                ae = l_or(src, ap, n, sink, 2, ptxt, sigs)
                aval = l_val(2, l_arg_slot(src, aspos, ae, 2, n))
                l_emit(sink, concat("  %t{pos}l = call i32 @buraaq_text_lt(i8* %p{pos}, i8* ", concat(aval, ")")))
                i = l_skip_call_args(src, j, n)
            } elif eq(recv, "f") {
                aspos = ap
                ae = l_or(src, ap, n, sink, 3, ptxt, sigs)
                aval = l_val(3, l_arg_slot(src, aspos, ae, 3, n))
                l_emit(sink, concat("  %lt{pos} = fcmp olt double %t{pos}f, ", aval))
                l_emit(sink, "  %t{pos}l = zext i1 %lt{pos} to i32")
                i = l_skip_call_args(src, j, n)
            } elif l_struct_body(src, n, recv) >= 0 {
                aspos = ap
                ae = l_or(src, ap, n, sink, 2, ptxt, sigs)
                aval = l_val(2, l_arg_slot(src, aspos, ae, 2, n))
                cal = concat(recv, "_lt")
                l_emit(sink, concat("  %t{pos}l = call i32 @{cal}(i8* %vr{pos}, i8* ", concat(aval, ")")))
                i = l_skip_call_args(src, j, n)
            } else {
                aspos = ap
                ae = l_or(src, ap, n, sink, 1, ptxt, sigs)
                aval = l_val(1, l_arg_slot(src, aspos, ae, 1, n))
                l_emit(sink, concat("  %lt{pos} = icmp slt i32 %la{pos}, ", aval))
                l_emit(sink, "  %t{pos}l = zext i1 %lt{pos} to i32")
                i = l_skip_call_args(src, j, n)
            }
        } elif eq(meth, "push") {
            w = l_peek_want(src, ap, n, ptxt, sigs)
            aspos = ap
            ae = l_or(src, ap, n, sink, w, ptxt, sigs)
            aval = l_val(w, l_arg_slot(src, aspos, ae, w, n))
            if w == 2 {
                l_emit(sink, concat("  call void @buraaq_vec_push_text(i8* %vr{pos}, i8* ", concat(aval, ")")))
                done = 1
            } else {
                l_emit(sink, concat("  call void @buraaq_vec_push_int(i8* %vr{pos}, i32 ", concat(aval, ")")))
                done = 1
            }
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "join") {
            l_emit(sink, "  %jh{pos} = bitcast i8* %vr{pos} to i8**")
            l_emit(sink, "  %jt{pos} = load i8*, i8** %jh{pos}")
            l_emit(sink, "  call void @buraaq_thread_join(i8* %jt{pos})")
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "wait") {
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "field") {
            w = 2
            aspos = ap
            ae = l_or(src, ap, n, sink, w, ptxt, sigs)
            aval = l_val(w, l_arg_slot(src, aspos, ae, w, n))
            l_emit(sink, concat("  %p{pos} = call i8* @buraaq_json_field(i8* %vr{pos}, i8* ", concat(aval, ")")))
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "item") {
            aspos = ap
            ae = l_or(src, ap, n, sink, 1, ptxt, sigs)
            aval = l_val(1, l_arg_slot(src, aspos, ae, 1, n))
            l_emit(sink, concat("  %p{pos} = call i8* @buraaq_json_item(i8* %vr{pos}, i32 ", concat(aval, ")")))
            l_emit(sink, "  %vr{pos} = bitcast i8* %p{pos} to i8*")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "as_int") {
            l_emit(sink, "  %t{pos}l = call i32 @buraaq_json_as_int(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "as_text") {
            l_emit(sink, "  %p{pos} = call i8* @buraaq_json_as_text(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "kind") {
            l_emit(sink, "  %t{pos}l = call i32 @buraaq_json_kind(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "count") {
            l_emit(sink, "  %t{pos}l = call i32 @buraaq_json_count(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "stringify") {
            l_emit(sink, "  %p{pos} = call i8* @buraaq_json_stringify(i8* %vr{pos})")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "model") {
            w = 2
            aspos = ap
            ae = l_or(src, ap, n, sink, w, ptxt, sigs)
            aval = l_val(w, l_arg_slot(src, aspos, ae, w, n))
            l_emit(sink, concat("  %t{pos}l = call i32 @buraaq_ai_model(i8* ", concat(aval, ")")))
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "system") {
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            i = l_skip_call_args(src, j, n)
        } elif eq(meth, "chat") {
            w = 2
            aspos = ap
            ae = l_or(src, ap, n, sink, w, ptxt, sigs)
            aval = l_val(w, l_arg_slot(src, aspos, ae, w, n))
            l_emit(sink, concat("  %p{pos} = call i8* @buraaq_ai_chat(i32 %t{pos}l, i8* ", concat(aval, ")")))
            i = l_skip_call_args(src, j, n)
        } else {
            if eq(recv, "d") {
                slot = l_trait_meth_idx(src, n, meth)
                l_emit(sink, "  %vt{pos} = bitcast i8* %vr{pos} to i8**")
                l_emit(sink, "  %vp{pos} = load i8*, i8** %vt{pos}")
                l_emit(sink, "  %va{pos} = bitcast i8* %vp{pos} to i8**")
                l_emit(sink, "  %vs{pos} = getelementptr i8*, i8** %va{pos}, i32 {slot}")
                l_emit(sink, "  %fp{pos} = load i8*, i8** %vs{pos}")
                l_emit(sink, "  %dd{pos} = getelementptr i8, i8* %vr{pos}, i32 8")
                l_emit(sink, "  %do{pos} = bitcast i8* %dd{pos} to i8**")
                l_emit(sink, "  %dx{pos} = load i8*, i8** %do{pos}")
                rt = l_rt(meth, sigs)
                if byte(src, ap) == 41 {
                    if rt == 2 {
                        l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i8* (i8*)*")
                        l_emit(sink, "  %p{pos} = call i8* %fc{pos}(i8* %dx{pos})")
                        l_emit(sink, "  %t{pos}l = add i32 0, 0")
                        done = 1
                    } elif rt == 0 {
                        l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to void (i8*)*")
                        l_emit(sink, "  call void %fc{pos}(i8* %dx{pos})")
                        l_emit(sink, "  %t{pos}l = add i32 0, 0")
                        done = 1
                    } else {
                        l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i32 (i8*)*")
                        l_emit(sink, "  %t{pos}l = call i32 %fc{pos}(i8* %dx{pos})")
                        done = 1
                    }
                } else {
                    w = l_peek_want(src, ap, n, ptxt, sigs)
                    aspos = ap
                    ae = l_or(src, ap, n, sink, w, ptxt, sigs)
                    aval = l_val(w, l_arg_slot(src, aspos, ae, w, n))
                    if w == 2 {
                        if rt == 2 {
                            l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i8* (i8*, i8*)*")
                            l_emit(sink, concat("  %p{pos} = call i8* %fc{pos}(i8* %dx{pos}, i8* ", concat(aval, ")")))
                            done = 1
                        } else {
                            l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i32 (i8*, i8*)*")
                            l_emit(sink, concat("  %t{pos}l = call i32 %fc{pos}(i8* %dx{pos}, i8* ", concat(aval, ")")))
                            done = 1
                        }
                    } else {
                        if rt == 2 {
                            l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i8* (i8*, i32)*")
                            l_emit(sink, concat("  %p{pos} = call i8* %fc{pos}(i8* %dx{pos}, i32 ", concat(aval, ")")))
                            done = 1
                        } else {
                            l_emit(sink, "  %fc{pos} = bitcast i8* %fp{pos} to i32 (i8*, i32)*")
                            l_emit(sink, concat("  %t{pos}l = call i32 %fc{pos}(i8* %dx{pos}, i32 ", concat(aval, ")")))
                            done = 1
                        }
                    }
                }
                i = l_skip_call_args(src, j, n)
            } else {
                cal = l_recv_fn(recv, meth)
                rt = l_rt(meth, sigs)
                if rt == 2 {
                    l_emit(sink, "  %p{pos} = call i8* @{cal}(i8* %vr{pos})")
                    l_emit(sink, "  %t{pos}l = add i32 0, 0")
                    done = 1
                } elif rt == 0 {
                    l_emit(sink, "  call void @{cal}(i8* %vr{pos})")
                    l_emit(sink, "  %t{pos}l = add i32 0, 0")
                    done = 1
                } else {
                    l_emit(sink, "  %t{pos}l = call i32 @{cal}(i8* %vr{pos})")
                    done = 1
                }
                i = l_skip_call_args(src, j, n)
            }
        }
    }
    i
}

# Kind of the first element of `[...]` at idx, or 0 when the list is empty
# or this is not a list. Used to mark text vecs so `xs[i]` and `for` load
# `i8*` instead of `i32`.
fn l_array_elem_want(src: text, idx: int, n: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) != 91 {
        return 0
    }
    i = scan_skip(src, i + 1, n)
    if byte(src, i) == 93 {
        return 0
    }
    l_peek_want(src, i, n, ptxt, sigs)
}

fn l_array_lit(src: text, idx: int, n: int, sink: text, pos: int, ptxt: text, sigs: text) -> int {
    i = idx
    if byte(src, i) == 91 {
        i = i + 1
    }
    l_emit(sink, "  %p{pos} = call i8* @buraaq_vec_new()")
    hops = 0
    i = scan_skip(src, i, n)
    while i < n {
        hops = hops + 1
        if hops > 64 {
            break
        }
        if byte(src, i) == 93 {
            i = i + 1
            break
        }
        if byte(src, i) == 44 {
            i = scan_skip(src, i + 1, n)
        }
        if byte(src, i) == 93 {
            i = i + 1
            break
        }
        aspos = i
        w = l_peek_want(src, i, n, ptxt, sigs)
        i = l_or(src, i, n, sink, w, ptxt, sigs)
        aval = l_val(w, l_arg_slot(src, aspos, i, w, n))
        if w == 2 {
            l_emit(sink, concat("  call void @buraaq_vec_push_text(i8* %p{pos}, i8* ", concat(aval, ")")))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_vec_push_int(i8* %p{pos}, i32 ", concat(aval, ")")))
            done = 1
        }
        i = scan_skip(src, i, n)
    }
    l_methods_on(src, i, n, sink, pos, ptxt, sigs, "")
}

# First value kind of `{ k: v, ... }` at idx, or 0 when this is not a map.
fn l_map_val_want(src: text, idx: int, n: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) != 123 {
        return 0
    }
    i = scan_skip(src, i + 1, n)
    if byte(src, i) == 125 {
        return 1
    }
    if byte(src, i) == 34 {
        i = scan_skip_string(src, i, n)
    } elif scan_is_ident_start(byte(src, i)) {
        i = scan_ident_end(src, i, n)
    } else {
        return 0
    }
    i = scan_skip(src, i, n)
    if byte(src, i) != 58 {
        return 0
    }
    l_peek_want(src, scan_skip(src, i + 1, n), n, ptxt, sigs)
}

fn l_map_key(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 34 {
        return l_str(src, i, n, sink, ptxt, sigs)
    }
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        q = l_quote(src, n)
        l_intern_span(src, i, e, sink, q)
        ln = l_decoded_len(src, i, e) + 1
        l_emit(sink, "  %p{i} = getelementptr [{ln} x i8], [{ln} x i8]* @.s{i}, i32 0, i32 0")
        l_emit(sink, "  %t{i}l = add i32 0, 0")
        return e
    }
    i
}

fn l_map_lit(src: text, idx: int, n: int, sink: text, pos: int, ptxt: text, sigs: text) -> int {
    i = idx
    if byte(src, i) == 123 {
        i = i + 1
    }
    l_emit(sink, "  %p{pos} = call i8* @buraaq_map_new()")
    hops = 0
    i = scan_skip(src, i, n)
    while i < n {
        hops = hops + 1
        if hops > 64 {
            break
        }
        if byte(src, i) == 125 {
            i = i + 1
            break
        }
        if byte(src, i) == 44 {
            i = scan_skip(src, i + 1, n)
        }
        if byte(src, i) == 125 {
            i = i + 1
            break
        }
        kpos = i
        i = l_map_key(src, i, n, sink, ptxt, sigs)
        kval = l_val(2, kpos)
        i = scan_skip(src, i, n)
        if byte(src, i) == 58 {
            i = scan_skip(src, i + 1, n)
        }
        aspos = i
        w = l_peek_want(src, i, n, ptxt, sigs)
        i = l_or(src, i, n, sink, w, ptxt, sigs)
        aval = l_val(w, l_arg_slot(src, aspos, i, w, n))
        if w == 2 {
            l_emit(sink, concat("  call void @buraaq_map_set_text(i8* %p{pos}, i8* ", concat(kval, concat(", i8* ", concat(aval, ")")))))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_map_set_int(i8* %p{pos}, i8* ", concat(kval, concat(", i32 ", concat(aval, ")")))))
            done = 1
        }
        i = scan_skip(src, i, n)
    }
    i
}

fn l_prefix(src: text, idx: int, n: int, sink: text, want: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    pos = i
    if scan_word_is(src, i, n, "await") {
        i = scan_skip(src, i + 5, n)
    }
    if byte(src, i) == 33 {
        inner = scan_skip(src, i + 1, n)
        i = l_prefix(src, inner, n, sink, 1, ptxt, sigs)
        l_emit(sink, "  %t{pos}l = xor i32 %t{inner}l, 1")
        return l_qmark(src, i, n, sink, pos, want, ptxt)
    }
    if scan_word_is(src, i, n, "if") {
        return l_qmark(src, l_if_expr(src, i, n, sink, want, ptxt, sigs, 2), n, sink, pos, want, ptxt)
    }
    if scan_word_is(src, i, n, "match") {
        return l_qmark(src, l_match(src, i, n, sink, 0, 0, ptxt, sigs, 0, want), n, sink, pos, want, ptxt)
    }
    if scan_word_is(src, i, n, "unsafe") {
        return l_qmark(src, l_unsafe_expr(src, i, n, sink, want, ptxt, sigs), n, sink, pos, want, ptxt)
    }
    c = byte(src, i)
    if c == 38 {
        i = scan_skip(src, i + 1, n)
        if scan_word_is(src, i, n, "mut") {
            i = scan_skip(src, i + 3, n)
        }
        if scan_is_ident_start(byte(src, i)) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            l_emit(sink, "  %p{pos} = bitcast i32* %{nm}.i to i8*")
            i = scan_skip(src, e, n)
            if scan_word_is(src, i, n, "as") {
                i = scan_skip_type(src, scan_skip(src, i + 2, n), n)
            }
            return l_qmark(src, i, n, sink, pos, want, ptxt)
        }
    }
    if c == 42 {
        star_num = 0
        if scan_is_digit(byte(src, i + 1)) {
            star_num = 1
        }
        if star_num == 0 {
            inner = scan_skip(src, i + 1, n)
            if scan_is_ident_start(byte(src, inner)) {
                e = scan_ident_end(src, inner, n)
                nm = slice(src, inner, e)
                l_emit(sink, "  %vr{pos} = load i8*, i8** %{nm}.p")
                l_emit(sink, "  %gd{pos} = bitcast i8* %vr{pos} to i32*")
                l_emit(sink, "  %t{pos}l = load i32, i32* %gd{pos}")
                i = scan_skip(src, e, n)
                if scan_word_is(src, i, n, "as") {
                    i = scan_skip_type(src, scan_skip(src, i + 2, n), n)
                }
                return l_qmark(src, i, n, sink, pos, want, ptxt)
            }
        }
    }
    if scan_is_digit(c) {
        return l_emit_num(sink, pos, src, i, n)
    }
    if c == 45 {
        if scan_is_digit(byte(src, i + 1)) {
            return l_emit_num(sink, pos, src, i, n)
        }
    }
    if c == 34 {
        return l_str(src, i, n, sink, ptxt, sigs)
    }
    if c == 40 {
        inner = scan_skip(src, i + 1, n)
        l_or(src, inner, n, sink, want, ptxt, sigs)
        l_paren_alias(sink, pos, inner, want)
        return l_methods_on(src, l_rparen(src, i + 1, n), n, sink, pos, ptxt, sigs, "")
    }
    if c == 91 {
        return l_array_lit(src, i, n, sink, pos, ptxt, sigs)
    }
    if c == 123 {
        return l_map_lit(src, i, n, sink, pos, ptxt, sigs)
    }
    if scan_word_is(src, i, n, "true") {
        l_emit(sink, "  %t{pos} = add i32 1, 0")
        l_emit(sink, "  %t{pos}l = add i32 1, 0")
        return i + 4
    }
    if scan_word_is(src, i, n, "false") {
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        return i + 5
    }
    if scan_is_ident_start(c) {
        e = scan_ident_end(src, i, n)
        name = slice(src, i, e)
        i = scan_skip(src, e, n)
        if eq(l_bag_get(ptxt, name), "h") {
            if byte(src, i) != 46 {
                l_emit(sink, "  %hb{pos} = load i8*, i8** %{name}.p")
                l_emit(sink, "  %ht{pos} = bitcast i8* %hb{pos} to i8**")
                l_emit(sink, "  %hh{pos} = load i8*, i8** %ht{pos}")
                l_emit(sink, "  call void @buraaq_thread_join(i8* %hh{pos})")
                l_emit(sink, "  %he{pos} = getelementptr i8, i8* %hb{pos}, i32 8")
                l_emit(sink, "  %hn{pos} = bitcast i8* %he{pos} to i8**")
                l_emit(sink, "  %hv{pos} = load i8*, i8** %hn{pos}")
                if want == 2 {
                    l_emit(sink, "  %hr{pos} = bitcast i8* %hv{pos} to i8**")
                    l_emit(sink, "  %p{pos} = load i8*, i8** %hr{pos}")
                    done = 1
                } else {
                    l_emit(sink, "  %hi{pos} = bitcast i8* %hv{pos} to i32*")
                    l_emit(sink, "  %t{pos}l = load i32, i32* %hi{pos}")
                    done = 1
                }
                return l_qmark(src, i, n, sink, pos, want, ptxt)
            }
        }
        if eq(name, "none") {
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            l_emit(sink, "  %p{pos} = bitcast i8* null to i8*")
            return l_qmark(src, e, n, sink, pos, want, ptxt)
        }
        if eq(name, "None") {
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            l_emit(sink, "  %p{pos} = bitcast i8* null to i8*")
            return l_qmark(src, e, n, sink, pos, want, ptxt)
        }
        if eq(name, "new") {
            i = scan_skip_type(src, e, n)
            i = scan_skip(src, i, n)
            l_emit(sink, "  %p{pos} = call i8* @buraaq_vec_new()")
            l_emit(sink, "  %t{pos}l = add i32 0, 0")
            if byte(src, i) == 40 {
                i = l_skip_call_args(src, i, n)
            }
            return l_qmark(src, i, n, sink, pos, want, ptxt)
        }
        wrap = 0
        if eq(name, "some") {
            wrap = 1
        }
        if eq(name, "Some") {
            wrap = 1
        }
        if eq(name, "ok") {
            wrap = 1
        }
        if eq(name, "Ok") {
            wrap = 1
        }
        if eq(name, "err") {
            wrap = 1
        }
        if eq(name, "Err") {
            wrap = 1
        }
        if wrap == 1 {
            if byte(src, i) == 40 {
                inner = scan_skip(src, i + 1, n)
                iw = l_peek_want(src, inner, n, ptxt, sigs)
                i = l_or(src, inner, n, sink, iw, ptxt, sigs)
                ip = l_arg_slot(src, inner, i, iw, n)
                l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 2)")
                l_emit(sink, "  %ot{pos} = bitcast i8* %p{pos} to i32*")
                l_emit(sink, "  store i32 1, i32* %ot{pos}")
                l_emit(sink, "  %op{pos} = getelementptr i8, i8* %p{pos}, i32 8")
                if iw == 2 {
                    l_emit(sink, "  %oq{pos} = bitcast i8* %op{pos} to i8**")
                    l_emit(sink, "  store i8* %p{ip}, i8** %oq{pos}")
                    done = 1
                } else {
                    l_emit(sink, "  %oi{pos} = bitcast i8* %op{pos} to i32*")
                    l_emit(sink, "  store i32 %t{ip}l, i32* %oi{pos}")
                    done = 1
                }
                l_emit(sink, "  %t{pos}l = add i32 1, 0")
                return l_qmark(src, l_rparen(src, inner, n), n, sink, pos, want, ptxt)
            }
        }
        is_sp = 0
        if eq(name, "spawn") {
            is_sp = 1
        }
        if eq(name, "spawn_task") {
            is_sp = 1
        }
        if eq(name, "async") {
            is_sp = 1
        }
        if is_sp == 1 {
            if scan_word_is(src, i, n, "async") {
                i = scan_skip(src, i + 5, n)
            }
            if byte(src, i) == 123 {
                if eq(name, "async") {
                    brace = i
                    inner = scan_skip(src, i + 1, n)
                    after = l_skip_stmt(src, inner, n)
                    after = scan_skip(src, after, n)
                    if byte(src, after) == 125 {
                        ww = want
                        if ww == 0 {
                            ww = 1
                        }
                        i = l_or(src, inner, n, sink, ww, ptxt, sigs)
                        ip = l_arg_slot(src, inner, i, ww, n)
                        if ww == 2 {
                            l_emit(sink, "  %p{pos} = bitcast i8* %p{ip} to i8*")
                            l_emit(sink, "  %t{pos}l = add i32 0, 0")
                            done = 1
                        } elif ww == 3 {
                            l_emit(sink, "  %t{pos}f = fadd double %t{ip}f, 0.0")
                            done = 1
                        } else {
                            l_emit(sink, "  %t{pos}l = add i32 %t{ip}l, 0")
                            done = 1
                        }
                        return l_skip_braced(src, brace, n)
                    }
                    dv2 = vec_new()
                    i = l_block(src, i, n, sink, 0, 0, 0, ptxt, 0, sigs, dv2, 0)
                    vec_free(dv2)
                    l_emit(sink, "  %t{pos}l = add i32 0, 0")
                    return i
                }
                brace = i
                end = l_skip_braced(src, brace, n)
                caps = l_spawn_caps(src, brace, end, ptxt)
                l_emit(sink, "  %en{pos} = call i8* @buraaq_obj_new(i32 8)")
                l_caps_pack(sink, caps, pos)
                l_emit(sink, "  %fp{pos} = bitcast void (i8*)* @bq_sp_{pos} to i8*")
                l_emit(sink, "  %th{pos} = call i8* @buraaq_thread_spawn(i8* %fp{pos}, i8* %en{pos})")
                l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 2)")
                l_emit(sink, "  %hs{pos} = bitcast i8* %p{pos} to i8**")
                l_emit(sink, "  store i8* %th{pos}, i8** %hs{pos}")
                l_emit(sink, "  %he{pos} = getelementptr i8, i8* %p{pos}, i32 8")
                l_emit(sink, "  %hp{pos} = bitcast i8* %he{pos} to i8**")
                l_emit(sink, "  store i8* %en{pos}, i8** %hp{pos}")
                l_emit(sink, "  %t{pos}l = add i32 1, 0")
                return end
            }
            inner = i
            i = l_prefix(src, inner, n, sink, want, ptxt, sigs)
            l_emit(sink, "  %t{pos}l = add i32 %t{inner}l, 0")
            l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 1)")
            return i
        }
        if byte(src, i) == 40 {
            i = l_call(src, name, i, n, sink, pos, ptxt, sigs)
            after = l_methods_on(src, i, n, sink, pos, ptxt, sigs, "")
            if want == 2 {
                if after == i {
                    if l_rt(name, sigs) != 2 {
                        if eq(l_bag_get(sigs, concat("g$", name)), "1") {
                            done = 1
                        } else {
                            l_emit(sink, "  %p{pos} = inttoptr i32 %t{pos}l to i8*")
                        }
                    }
                }
            }
            return l_qmark(src, after, n, sink, pos, want, ptxt)
        }
        if byte(src, i) == 91 {
            br = l_bracket_end(src, i, n)
            after = scan_skip(src, br, n)
            skip_ty = 0
            if byte(src, after) == 123 {
                skip_ty = 1
            }
            if byte(src, after) == 46 {
                me = scan_ident_end(src, after + 1, n)
                m = slice(src, after + 1, me)
                if eq(m, "new") {
                    skip_ty = 1
                }
                if eq(m, "bounded") {
                    skip_ty = 1
                }
            }
            inner0 = scan_skip(src, i + 1, n)
            if scan_is_digit(byte(src, inner0)) {
                skip_ty = 0
            }
            if skip_ty == 1 {
                i = after
            }
        }
        # `Name { ... }` builds a struct; only a declared struct can, so an
        # unknown name followed by `{` is still a plain load and a later error.
        if byte(src, i) == 123 {
            if l_looks_struct(name) {
                if l_struct_body(src, n, name) >= 0 {
                    return l_qmark(src, l_struct_lit(src, name, i, n, sink, pos, ptxt, sigs), n, sink, pos, want, ptxt)
                }
            }
        }
        if byte(src, i) == 46 {
            # `Color.Red` is a constant, not a field of a local named Color.
            fe = scan_ident_end(src, i + 1, n)
            meth = slice(src, i + 1, fe)
            tag = l_enum_tag(src, n, name, meth)
            if tag >= 0 {
                l_emit(sink, "  %t{pos} = add i32 {tag}, 0")
                l_emit(sink, "  %t{pos}l = add i32 {tag}, 0")
                j2 = scan_skip(src, fe, n)
                if byte(src, j2) == 40 {
                    inner = scan_skip(src, j2 + 1, n)
                    iw = l_peek_want(src, inner, n, ptxt, sigs)
                    i = l_or(src, inner, n, sink, iw, ptxt, sigs)
                    ip = l_arg_slot(src, inner, i, iw, n)
                    l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 2)")
                    l_emit(sink, "  %et{pos} = bitcast i8* %p{pos} to i32*")
                    l_emit(sink, "  store i32 {tag}, i32* %et{pos}")
                    l_emit(sink, "  %ep{pos} = getelementptr i8, i8* %p{pos}, i32 8")
                    if iw == 2 {
                        l_emit(sink, "  %eq{pos} = bitcast i8* %ep{pos} to i8**")
                        l_emit(sink, "  store i8* %p{ip}, i8** %eq{pos}")
                        done = 1
                    } else {
                        l_emit(sink, "  %ei{pos} = bitcast i8* %ep{pos} to i32*")
                        l_emit(sink, "  store i32 %t{ip}l, i32* %ei{pos}")
                        done = 1
                    }
                    return l_qmark(src, l_rparen(src, inner, n), n, sink, pos, want, ptxt)
                }
                if byte(src, j2) == 123 {
                    inner = scan_skip(src, j2 + 1, n)
                    if scan_is_ident_start(byte(src, inner)) {
                        ie = scan_ident_end(src, inner, n)
                        inner = scan_skip(src, ie, n)
                        if byte(src, inner) == 58 {
                            inner = scan_skip(src, inner + 1, n)
                        }
                    }
                    iw = l_peek_want(src, inner, n, ptxt, sigs)
                    i = l_or(src, inner, n, sink, iw, ptxt, sigs)
                    ip = l_arg_slot(src, inner, i, iw, n)
                    l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 2)")
                    l_emit(sink, "  %et{pos} = bitcast i8* %p{pos} to i32*")
                    l_emit(sink, "  store i32 {tag}, i32* %et{pos}")
                    l_emit(sink, "  %ep{pos} = getelementptr i8, i8* %p{pos}, i32 8")
                    if iw == 2 {
                        l_emit(sink, "  %eq{pos} = bitcast i8* %ep{pos} to i8**")
                        l_emit(sink, "  store i8* %p{ip}, i8** %eq{pos}")
                        done = 1
                    } else {
                        l_emit(sink, "  %ei{pos} = bitcast i8* %ep{pos} to i32*")
                        l_emit(sink, "  store i32 %t{ip}l, i32* %ei{pos}")
                        done = 1
                    }
                    return l_qmark(src, l_skip_braced(src, j2, n), n, sink, pos, want, ptxt)
                }
                l_emit(sink, "  %p{pos} = inttoptr i32 %t{pos}l to i8*")
                return l_qmark(src, fe, n, sink, pos, want, ptxt)
            }
            j = scan_skip(src, fe, n)
            if byte(src, j) == 40 {
                if eq(meth, "new") {
                    return l_qmark(src, l_type_ctor(src, meth, j, n, sink, pos, ptxt, sigs), n, sink, pos, want, ptxt)
                }
                if eq(meth, "bounded") {
                    return l_qmark(src, l_type_ctor(src, meth, j, n, sink, pos, ptxt, sigs), n, sink, pos, want, ptxt)
                }
                if eq(meth, "lock") {
                    l_emit(sink, "  %vr{pos} = load i8*, i8** %{name}.p")
                    l_emit(sink, "  %ls{pos} = getelementptr i8, i8* %vr{pos}, i32 8")
                    l_emit(sink, "  %lp{pos} = bitcast i8* %ls{pos} to i8**")
                    l_emit(sink, "  %lm{pos} = load i8*, i8** %lp{pos}")
                    l_emit(sink, "  call void @buraaq_mutex_lock(i8* %lm{pos})")
                    i = l_skip_call_args(src, j, n)
                    nxt = l_tail_index(src, i, n, sink, pos)
                    if nxt != scan_skip(src, i, n) {
                        return l_qmark(src, l_methods_on(src, nxt, n, sink, pos, ptxt, sigs, l_bag_get(ptxt, name)), n, sink, pos, want, ptxt)
                    }
                    l_emit(sink, "  %p{pos} = bitcast i8* %vr{pos} to i8*")
                    return l_qmark(src, nxt, n, sink, pos, want, ptxt)
                }
                if eq(meth, "to_text") {
                    if eq(l_bag_get(ptxt, name), "f") {
                        l_load(sink, name, 3, pos, ptxt)
                        done = 1
                    } else {
                        l_load(sink, name, 1, pos, ptxt)
                        done = 1
                    }
                    done = 1
                } elif eq(meth, "lt") {
                    if eq(l_recv_tag(ptxt, name), "t") {
                        l_emit(sink, "  %p{pos} = load i8*, i8** %{name}.p")
                        done = 1
                    } elif eq(l_recv_tag(ptxt, name), "f") {
                        l_emit(sink, "  %t{pos}f = load double, double* %{name}.f")
                        done = 1
                    } elif l_struct_body(src, n, l_recv_tag(ptxt, name)) >= 0 {
                        l_emit(sink, "  %vr{pos} = load i8*, i8** %{name}.p")
                        done = 1
                    } else {
                        l_emit(sink, "  %la{pos} = load i32, i32* %{name}.i")
                        done = 1
                    }
                } else {
                    l_emit(sink, "  %vr{pos} = load i8*, i8** %{name}.p")
                    done = 1
                }
                return l_qmark(src, l_methods_on(src, i, n, sink, pos, ptxt, sigs, l_recv_tag(ptxt, name)), n, sink, pos, want, ptxt)
            }
            fr = l_field_read(src, name, i, n, sink, want, pos, ptxt, sigs)
            return l_qmark(src, l_methods_on(src, fr, n, sink, pos, ptxt, sigs, l_bag_get(ptxt, name)), n, sink, pos, want, ptxt)
        }
        if byte(src, i) == 91 {
            nxt = scan_skip(src, i + 1, n)
            if byte(src, nxt) == 93 {
                if l_bag_has(ptxt, name) {
                    l_emit(sink, "  %vr{pos} = load i8*, i8** %{name}.p")
                    l_emit(sink, "  %gd{pos} = bitcast i8* %vr{pos} to i32*")
                    l_emit(sink, "  %t{pos}l = load i32, i32* %gd{pos}")
                    done = 1
                } else {
                    l_load(sink, name, 1, pos, ptxt)
                    done = 1
                }
                return l_methods_on(src, nxt + 1, n, sink, pos, ptxt, sigs, "")
            }
            i = l_index_read(src, name, i, n, sink, want, pos, ptxt, sigs)
            return l_methods_on(src, i, n, sink, pos, ptxt, sigs, "")
        }
        l_load(sink, name, want, pos, ptxt)
        return l_qmark(src, l_methods_on(src, e, n, sink, pos, ptxt, sigs, l_bag_get(ptxt, name)), n, sink, pos, want, ptxt)
    }
    return l_qmark(src, i, n, sink, pos, want, ptxt)
}

# Postfix `?` — if this value is empty (null text / 0 int), leave the
# function. A typed `ret` matches the define (`:?p` / `:?i` on ptxt).
# Void `main` still exits so the empty path stays well-typed. `??` defaults.
fn l_qmark(src: text, idx: int, n: int, sink: text, pos: int, want: int, ptxt: text) -> int {
    i = scan_skip(src, idx, n)
    hops = 0
    while hops < 4 {
        hops = hops + 1
        if byte(src, i) != 63 {
            break
        }
        if byte(src, i + 1) == 63 {
            break
        }
        if want == 2 {
            l_emit(sink, "  %qz{pos}_{hops} = icmp eq i8* %p{pos}, null")
            l_emit(sink, "  br i1 %qz{pos}_{hops}, label %qf{pos}_{hops}, label %qc{pos}_{hops}")
            l_emit(sink, "qf{pos}_{hops}:")
            if l_bag_has(ptxt, ":?p") {
                l_emit(sink, "  ret i8* null")
                done = 1
            } elif l_bag_has(ptxt, ":?i") {
                l_emit(sink, "  ret i32 0")
                done = 1
            } else {
                l_emit(sink, "  call void @buraaq_exit(i32 0)")
                l_emit(sink, "  unreachable")
                done = 1
            }
            l_emit(sink, "qc{pos}_{hops}:")
            done = 1
        } else {
            l_emit(sink, "  %qz{pos}_{hops} = icmp eq i32 %t{pos}l, 0")
            l_emit(sink, "  br i1 %qz{pos}_{hops}, label %qf{pos}_{hops}, label %qc{pos}_{hops}")
            l_emit(sink, "qf{pos}_{hops}:")
            if l_bag_has(ptxt, ":?p") {
                l_emit(sink, "  ret i8* null")
                done = 1
            } elif l_bag_has(ptxt, ":?i") {
                l_emit(sink, "  ret i32 0")
                done = 1
            } else {
                l_emit(sink, "  call void @buraaq_exit(i32 0)")
                l_emit(sink, "  unreachable")
                done = 1
            }
            l_emit(sink, "qc{pos}_{hops}:")
            done = 1
        }
        i = scan_skip(src, i + 1, n)
    }
    i
}

# `Name { f: expr, ... }` — allocate one slot per declared field and store into
# the ones given. Fields are written by name, so order in the literal need not
# match the declaration, and anything omitted keeps the zero calloc left.
fn l_struct_lit(src: text, sname: text, idx: int, n: int, sink: text, pos: int, ptxt: text, sigs: text) -> int {
    i = idx
    if byte(src, i) == 123 {
        i = i + 1
    }
    nf = l_field_count(src, n, sname)
    l_emit(sink, "  %p{pos} = call i8* @buraaq_obj_new(i32 {nf})")
    hops = 0
    i = scan_skip(src, i, n)
    while i < n {
        hops = hops + 1
        if hops > 64 {
            break
        }
        if byte(src, i) == 125 {
            i = i + 1
            break
        }
        if scan_is_ident_start(byte(src, i)) {
            fe = scan_ident_end(src, i, n)
            fname = slice(src, i, fe)
            off = l_field_off(src, n, sname, fname)
            j = scan_skip(src, fe, n)
            if byte(src, j) == 58 {
                j = scan_skip(src, j + 1, n)
            }
            w = 1
            if l_field_is_text(src, n, sname, fname) {
                w = 2
            }
            vpos = j
            j = l_or(src, j, n, sink, w, ptxt, sigs)
            l_store_field(sink, pos, off, w, l_val(w, l_arg_slot(src, vpos, j, w, n)))
            i = scan_skip(src, j, n)
            if byte(src, i) == 44 {
                i = scan_skip(src, i + 1, n)
            }
        } else {
            i = i + 1
        }
    }
    i
}

# The underscore matters: `%f{pos}{off}` would give the same name for pos 601
# offset 0 as for pos 60 offset 10, and LLVM rejects the duplicate.
fn l_store_field(sink: text, pos: int, off: int, w: int, val: text) {
    l_emit(sink, "  %f{pos}_{off} = getelementptr i8, i8* %p{pos}, i32 {off}")
    if w == 2 {
        l_emit(sink, "  %fp{pos}_{off} = bitcast i8* %f{pos}_{off} to i8**")
        l_emit(sink, "  store i8* {val}, i8** %fp{pos}_{off}")
        done = 1
    } else {
        l_emit(sink, "  %fi{pos}_{off} = bitcast i8* %f{pos}_{off} to i32*")
        l_emit(sink, "  store i32 {val}, i32* %fi{pos}_{off}")
        done = 1
    }
    done = 1
}

# `base.field` — the struct a local holds is recorded in the same bag that says
# it is pointer-shaped, so the field's offset and type come from its declaration.
fn l_field_read(src: text, base: text, idx: int, n: int, sink: text, want: int, pos: int, ptxt: text, sigs: text) -> int {
    i = idx + 1
    e = scan_ident_end(src, i, n)
    fname = slice(src, i, e)
    sname = l_bag_get(ptxt, base)
    off = l_field_off(src, n, sname, fname)
    if off < 0 {
        # Not a known field: fall back to loading the base so the emitter stays
        # total, and let the checker or clang report it.
        l_load(sink, base, want, pos, ptxt)
        return e
    }
    l_emit(sink, "  %b{pos} = load i8*, i8** %{base}.p")
    l_emit(sink, "  %g{pos} = getelementptr i8, i8* %b{pos}, i32 {off}")
    hop = 0
    while hop < 5 {
        k = scan_skip(src, e, n)
        if byte(src, k) != 46 {
            break
        }
        fe = scan_ident_end(src, k + 1, n)
        nxt = slice(src, k + 1, fe)
        j = scan_skip(src, fe, n)
        if byte(src, j) == 40 {
            break
        }
        ns = l_field_type_name(src, n, sname, fname)
        noff = l_field_off(src, n, ns, nxt)
        if noff < 0 {
            break
        }
        hop = hop + 1
        if hop == 1 {
            l_emit(sink, "  %pf{pos}_{hop} = bitcast i8* %g{pos} to i8**")
            done = 1
        } else {
            prev = hop - 1
            l_emit(sink, "  %pf{pos}_{hop} = bitcast i8* %g{pos}_{prev} to i8**")
            done = 1
        }
        l_emit(sink, "  %pb{pos}_{hop} = load i8*, i8** %pf{pos}_{hop}")
        l_emit(sink, "  %g{pos}_{hop} = getelementptr i8, i8* %pb{pos}_{hop}, i32 {noff}")
        sname = ns
        fname = nxt
        e = fe
    }
    if hop == 0 {
        if l_field_is_text(src, n, sname, fname) {
            l_emit(sink, "  %gp{pos} = bitcast i8* %g{pos} to i8**")
            l_emit(sink, "  %p{pos} = load i8*, i8** %gp{pos}")
            done = 1
        } else {
            l_emit(sink, "  %gi{pos} = bitcast i8* %g{pos} to i32*")
            l_emit(sink, "  %t{pos}l = load i32, i32* %gi{pos}")
            done = 1
        }
        done = 1
    } else {
        if l_field_is_text(src, n, sname, fname) {
            l_emit(sink, "  %gp{pos} = bitcast i8* %g{pos}_{hop} to i8**")
            l_emit(sink, "  %p{pos} = load i8*, i8** %gp{pos}")
            done = 1
        } else {
            l_emit(sink, "  %gi{pos} = bitcast i8* %g{pos}_{hop} to i32*")
            l_emit(sink, "  %t{pos}l = load i32, i32* %gi{pos}")
            done = 1
        }
        done = 1
    }
    e
}

# `xs[i]` reads one slot of a vector.
#
# A slot holds an int or a text and the vector does not record which, so nothing
# in `xs[i]` says what comes back. It reads an int; a text element needs
# `vec_get_text(xs, i)`, which says so at the call. Inferring it instead would
# mean guessing from the use, and guessing types from spelling is what the
# emitter spent two bootstrap miscompiles getting rid of.
fn l_index_read(src: text, base: text, idx: int, n: int, sink: text, want: int, pos: int, ptxt: text, sigs: text) -> int {
    ipos = scan_skip(src, idx + 1, n)
    tag = l_bag_get(ptxt, base)
    if eq(tag, "mi") {
        i = l_or(src, ipos, n, sink, 2, ptxt, sigs)
        kval = l_val(2, l_arg_slot(src, ipos, i, 2, n))
        i = scan_skip(src, i, n)
        if byte(src, i) == 93 {
            i = i + 1
        }
        l_emit(sink, "  %xb{pos} = load i8*, i8** %{base}.p")
        l_emit(sink, concat("  %t{pos}l = call i32 @buraaq_map_get_int(i8* %xb{pos}, i8* ", concat(kval, ")")))
        return i
    }
    if eq(tag, "mt") {
        i = l_or(src, ipos, n, sink, 2, ptxt, sigs)
        kval = l_val(2, l_arg_slot(src, ipos, i, 2, n))
        i = scan_skip(src, i, n)
        if byte(src, i) == 93 {
            i = i + 1
        }
        l_emit(sink, "  %xb{pos} = load i8*, i8** %{base}.p")
        l_emit(sink, concat("  %p{pos} = call i8* @buraaq_map_get_text(i8* %xb{pos}, i8* ", concat(kval, ")")))
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        return i
    }
    i = l_or(src, ipos, n, sink, 1, ptxt, sigs)
    ival = l_val(1, l_arg_slot(src, ipos, i, 1, n))
    i = scan_skip(src, i, n)
    if byte(src, i) == 93 {
        i = i + 1
    }
    l_emit(sink, "  %xb{pos} = load i8*, i8** %{base}.p")
    is_tv = 0
    if eq(tag, "vt") {
        is_tv = 1
    }
    if is_tv == 1 {
        l_emit(sink, concat("  %p{pos} = call i8* @buraaq_vec_get_text(i8* %xb{pos}, i32 ", concat(ival, ")")))
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        done = 1
    } else {
        l_emit(sink, concat("  %t{pos}l = call i32 @buraaq_vec_get_int(i8* %xb{pos}, i32 ", concat(ival, ")")))
        done = 1
    }
    i
}

# `xs[i] = v` writes one slot. Here the value is in hand, so its kind decides
# which store is emitted rather than the reader's expectation.
fn l_index_write(src: text, base: text, br: int, vidx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    ipos = scan_skip(src, br + 1, n)
    tag = l_bag_get(ptxt, base)
    is_map = 0
    if eq(tag, "mi") {
        is_map = 1
    }
    if eq(tag, "mt") {
        is_map = 1
    }
    if is_map == 1 {
        ie = l_or(src, ipos, n, sink, 2, ptxt, sigs)
        kval = l_val(2, l_arg_slot(src, ipos, ie, 2, n))
        vpos = scan_skip(src, vidx, n)
        w = l_peek_want(src, vpos, n, ptxt, sigs)
        i = l_or(src, vpos, n, sink, w, ptxt, sigs)
        val = l_val(w, l_arg_slot(src, vpos, i, w, n))
        l_emit(sink, "  %yb{vpos} = load i8*, i8** %{base}.p")
        if w == 2 {
            l_emit(sink, concat("  call void @buraaq_map_set_text(i8* %yb{vpos}, i8* ", concat(kval, concat(", i8* ", concat(val, ")")))))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_map_set_int(i8* %yb{vpos}, i8* ", concat(kval, concat(", i32 ", concat(val, ")")))))
            done = 1
        }
        return i
    }
    ie = l_or(src, ipos, n, sink, 1, ptxt, sigs)
    ival = l_val(1, l_arg_slot(src, ipos, ie, 1, n))
    vpos = scan_skip(src, vidx, n)
    w = l_peek_want(src, vpos, n, ptxt, sigs)
    i = l_or(src, vpos, n, sink, w, ptxt, sigs)
    val = l_val(w, l_arg_slot(src, vpos, i, w, n))
    l_emit(sink, "  %yb{vpos} = load i8*, i8** %{base}.p")
    if w == 2 {
        l_emit(sink, "  call void @buraaq_vec_set_text(i8* %yb{vpos}, i32 {ival}, i8* {val})")
        done = 1
    } else {
        l_emit(sink, "  call void @buraaq_vec_set_int(i8* %yb{vpos}, i32 {ival}, i32 {val})")
        done = 1
    }
    i
}

fn l_call(src: text, name: text, idx: int, n: int, sink: text, pos: int, ptxt: text, sigs: text) -> int {
    hint = l_std_collide(name)
    if len(hint) > 0 {
        if eq(name, "connect") {
            if l_has_std_use(src, "db") == 0 {
                if l_has_std_use(src, "net") == 0 {
                    eprintln(concat("buraaq-boot: ", hint))
                }
            }
        } elif eq(name, "show") {
            if l_has_std_use(src, "lumen") == 0 {
                if l_has_std_use(src, "flowdesk") == 0 {
                    eprintln(concat("buraaq-boot: ", hint))
                }
            }
        } elif eq(name, "keep") {
            if l_has_std_use(src, "hold") == 0 {
                if l_has_std_use(src, "lumen") == 0 {
                    eprintln(concat("buraaq-boot: ", hint))
                }
            }
        }
    }
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    alist = ""
    a0 = "0"
    a1 = "0"
    na = 0
    w0 = 1
    hops = 0
    i = scan_skip(src, i, n)
    while i < n {
        hops = hops + 1
        if hops > 64 {
            break
        }
        if byte(src, i) == 41 {
            break
        }
        if na > 0 {
            if byte(src, i) == 44 {
                i = scan_skip(src, i + 1, n)
            } else {
                break
            }
        }
        isref = 0
        aspos = i
        w = 1
        if scan_word_is(src, i, n, "ref") {
            isref = 1
        }
        if isref == 1 {
            i = l_skip_mut(src, i, n)
            e = scan_ident_end(src, i, n)
            rnm = slice(src, i, e)
            aval = concat("%", concat(rnm, ".i"))
            aty = "i32*"
            i = e
            w = 1
            done = 1
        } else {
        w = l_peek_want(src, i, n, ptxt, sigs)
        aspos = i
        i = l_or(src, i, n, sink, w, ptxt, sigs)
        aval = l_val(w, l_arg_slot(src, aspos, i, w, n))
        aty = "i32"
        if w == 2 {
            aty = "i8*"
        }
        if w == 3 {
            aty = "double"
        }
        isprn = 0
        if eq(name, "print") {
            isprn = 1
        }
        if eq(name, "println") {
            isprn = 1
        }
        if isprn == 1 {
            if na > 0 {
                l_print_space(sink)
            }
            l_print_arg(sink, w, aval, 0)
        }
        }
        piece = concat(aty, concat(" ", aval))
        if na == 0 {
            w0 = w
            dtr = l_bag_get(sigs, concat("d$", name))
            if len(dtr) > 0 {
                a0nm = ""
                if scan_is_ident_start(byte(src, aspos)) {
                    ae0 = scan_ident_end(src, aspos, n)
                    a0nm = slice(src, aspos, ae0)
                    nx0 = scan_skip(src, ae0, n)
                    if byte(src, nx0) == 44 {
                        done = 1
                    } elif byte(src, nx0) == 41 {
                        done = 1
                    } else {
                        a0nm = ""
                    }
                }
                if len(l_bag_get(ptxt, a0nm)) > 0 {
                    if eq(l_bag_get(ptxt, a0nm), "d") {
                        done = 1
                    } else {
                        l_emit(sink, "  %bx{pos} = call i8* @buraaq_obj_new(i32 2)")
                        l_emit(sink, "  %vs{pos} = bitcast i8* %bx{pos} to i8**")
                        l_emit(sink, concat("  store i8* bitcast ([4 x i8*]* @vt_", concat(l_bag_get(ptxt, a0nm), concat("_", concat(dtr, " to i8*), i8** %vs{pos}")))))
                        l_emit(sink, "  %ds{pos} = getelementptr i8, i8* %bx{pos}, i32 8")
                        l_emit(sink, "  %dp{pos} = bitcast i8* %ds{pos} to i8**")
                        l_emit(sink, concat("  store i8* ", concat(aval, ", i8** %dp{pos}")))
                        aval = "%bx{pos}"
                        aty = "i8*"
                        piece = concat(aty, concat(" ", aval))
                        done = 1
                    }
                }
            }
            alist = piece
            a0 = aval
            done = 1
        }
        if na == 1 {
            a1 = aval
            done = 1
        }
        if na > 0 {
            alist = concat(alist, concat(", ", piece))
        }
        na = na + 1
        i = scan_skip(src, i, n)
    }
    if byte(src, i) == 41 {
        i = i + 1
    }
    rt = l_rt(name, sigs)
    did = 0
    if eq(name, "print") {
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "println") {
        l_print_nl(sink)
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "print_int") {
        l_print_arg(sink, 1, a0, 1)
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "print_float") {
        l_print_arg(sink, 3, a0, 1)
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "print_bool") {
        l_print_arg(sink, 4, a0, 1)
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "eq") {
        l_emit(sink, "  %eq{pos} = call i32 @buraaq_text_eq(i8* {a0}, i8* {a1})")
        l_emit(sink, "  %eqc{pos} = icmp eq i32 %eq{pos}, 0")
        l_emit(sink, "  %t{pos} = zext i1 %eqc{pos} to i32")
        did = 1
    }
    cal = name
    if eq(name, "read") {
        cal = "buraaq_file_read"
    }
    if eq(name, "len") {
        cal = "buraaq_text_len"
    }
    if eq(name, "byte") {
        cal = "buraaq_text_byte"
    }
    if eq(name, "slice") {
        cal = "buraaq_text_slice"
    }
    if eq(name, "concat") {
        cal = "buraaq_text_concat"
    }
    if eq(name, "write") {
        cal = "buraaq_file_write"
    }
    if eq(name, "append") {
        cal = "buraaq_file_append"
    }
    if eq(name, "eprintln") {
        cal = "buraaq_eprint_str_ln"
    }
    if eq(name, "char_of") {
        cal = "buraaq_char"
    }
    if eq(name, "abs_int") {
        cal = "buraaq_math_abs_i32"
    }
    if eq(name, "sha256") {
        cal = "buraaq_crypto_sha256_hex"
    }
    if eq(name, "sin") {
        cal = "buraaq_math_sin"
    }
    if eq(name, "sqrt") {
        cal = "buraaq_math_sqrt"
    }
    if eq(name, "clamp") {
        cal = "buraaq_math_clamp"
    }
    if eq(name, "dot") {
        cal = "buraaq_grid_dot"
    }
    if eq(name, "at") {
        cal = "buraaq_grid_at"
    }
    if eq(name, "row") {
        cal = "buraaq_grid_row"
    }
    if eq(name, "eye") {
        cal = "buraaq_grid_eye"
    }
    if eq(name, "hold") {
        cal = "buraaq_hold_new"
    }
    if eq(name, "stow") {
        cal = "buraaq_hold_stow"
    }
    if eq(name, "rows") {
        cal = "buraaq_hold_rows"
    }
    if eq(name, "pick") {
        cal = "buraaq_hold_pick"
    }
    if eq(name, "col_mean") {
        cal = "buraaq_hold_col_mean"
    }
    if eq(name, "on") {
        cal = "buraaq_led_on"
    }
    if eq(name, "off") {
        cal = "buraaq_led_off"
    }
    if eq(name, "wait") {
        cal = "buraaq_led_wait_ms"
    }
    if eq(name, "printf") {
        cal = "printf"
    }
    if eq(name, "async_io_read_line") {
        cal = "buraaq_async_io_read_line"
    }
    if eq(name, "read_line") {
        cal = "buraaq_read_line"
    }
    if eq(name, "page") {
        cal = "buraaq_svc_page"
    }
    if eq(name, "api") {
        cal = "buraaq_svc_api"
    }
    if eq(name, "store") {
        cal = "buraaq_svc_store"
    }
    if eq(name, "key") {
        cal = "buraaq_svc_key"
    }
    if eq(name, "origin") {
        cal = "buraaq_svc_origin"
    }
    if eq(name, "call") {
        cal = "buraaq_http_get_body"
    }
    if eq(name, "zeros") {
        cal = "buraaq_grid_zeros"
    }
    if eq(name, "ones") {
        cal = "buraaq_grid_ones"
    }
    if eq(name, "from_csv") {
        cal = "buraaq_hold_from_csv"
    }
    if eq(name, "run") {
        l_emit(sink, "  call i32 @buraaq_svc_run(i32 0)")
        l_emit(sink, "  %t{pos} = add i32 0, 0")
        did = 1
    }
    if eq(name, "connect") {
        if l_has_std_use(src, "db") == 1 {
            cal = "buraaq_pg_connect"
        } else {
            l_emit(sink, "  %t{pos} = add i32 0, 0")
            did = 1
        }
    }
    if eq(name, "show") {
        if l_has_std_use(src, "lumen") == 1 {
            cal = "buraaq_ui_show"
        } else {
            l_emit(sink, "  %t{pos} = add i32 0, 0")
            did = 1
        }
    }
    if eq(name, "keep") {
        if l_has_std_use(src, "hold") == 1 {
            cal = "buraaq_hold_keep"
        } else {
            l_emit(sink, "  %t{pos} = add i32 0, 0")
            did = 1
        }
    }
    if eq(name, "parse") {
        l_emit(sink, concat("  %p{pos} = call i8* @buraaq_json_parse(i8* ", concat(a0, ")")))
        l_emit(sink, "  %vr{pos} = bitcast i8* %p{pos} to i8*")
        did = 1
    }
    if eq(name, "stringify") {
        l_emit(sink, concat("  %p{pos} = call i8* @buraaq_json_stringify(i8* ", concat(a0, ")")))
        did = 1
    }
    if eq(name, "lsp_read") {
        cal = "buraaq_lsp_read"
    }
    if eq(name, "lsp_write") {
        cal = "buraaq_lsp_write"
    }
    if eq(name, "bur_pack") {
        cal = "buraaq_bur_pack"
    }
    if eq(name, "bur_launch") {
        cal = "buraaq_bur_launch"
    }
    if eq(name, "put_file") {
        cal = "buraaq_http_put_file"
    }
    if eq(name, "dock_run") {
        cal = "buraaq_dock_run"
    }
    if eq(name, "index_run") {
        cal = "buraaq_index_run"
    }
    if eq(name, "jpath_int") {
        cal = "buraaq_json_path_int"
    }
    if eq(name, "jpath_text") {
        cal = "buraaq_json_path_text"
    }
    if eq(name, "set_new") {
        cal = "buraaq_set_new"
    }
    if eq(name, "set_add") {
        cal = "buraaq_set_add"
    }
    if eq(name, "set_has") {
        cal = "buraaq_set_has"
    }
    if eq(name, "set_add_csv") {
        cal = "buraaq_set_add_csv"
    }
    if eq(name, "set_free") {
        cal = "buraaq_set_free"
    }
    if eq(name, "vec_new") {
        cal = "buraaq_vec_new"
    }
    if eq(name, "vec_len") {
        cal = "buraaq_vec_len"
    }
    if eq(name, "vec_push_int") {
        cal = "buraaq_vec_push_int"
    }
    if eq(name, "vec_push_text") {
        cal = "buraaq_vec_push_text"
    }
    if eq(name, "vec_get_int") {
        cal = "buraaq_vec_get_int"
    }
    if eq(name, "vec_get_text") {
        cal = "buraaq_vec_get_text"
    }
    if eq(name, "vec_set_int") {
        cal = "buraaq_vec_set_int"
    }
    if eq(name, "vec_set_text") {
        cal = "buraaq_vec_set_text"
    }
    if eq(name, "vec_free") {
        cal = "buraaq_vec_free"
    }
    if eq(name, "exit") {
        cal = "buraaq_exit"
    }
    if eq(name, "arg") {
        cal = "buraaq_os_argv"
    }
    if eq(name, "args") {
        cal = "buraaq_os_argc"
    }
    if eq(name, "getenv") {
        cal = "buraaq_os_getenv"
    }
    if eq(name, "exists") {
        cal = "buraaq_file_exists"
    }
    if eq(name, "mkdir") {
        cal = "buraaq_mkdir"
    }
    if eq(name, "chdir") {
        cal = "buraaq_chdir"
    }
    if eq(name, "argv_new") {
        cal = "buraaq_argv_new"
    }
    if eq(name, "argv_push") {
        cal = "buraaq_argv_push"
    }
    if eq(name, "argv_run") {
        cal = "buraaq_process_run"
    }
    if eq(name, "argv_free") {
        cal = "buraaq_argv_free"
    }
    if eq(name, "stream") {
        cal = "buraaq_stream_bind"
    }
    if eq(name, "hail") {
        cal = "buraaq_stream_hail"
    }
    if eq(name, "wire") {
        cal = "buraaq_stream_wire"
    }
    if eq(name, "say") {
        cal = "buraaq_stream_say"
    }
    if eq(name, "hear") {
        cal = "buraaq_stream_hear"
    }
    if eq(name, "hangup") {
        cal = "buraaq_stream_hangup"
    }
    if eq(name, "run_stream") {
        cal = "buraaq_stream_run"
    }
    if eq(name, "clip") {
        cal = "buraaq_stream_clip"
    }
    if eq(name, "shot") {
        cal = "buraaq_stream_shot"
    }
    if eq(name, "heard") {
        cal = "buraaq_stream_heard"
    }
    if eq(name, "canvas") {
        cal = "buraaq_gfx_canvas"
    }
    if eq(name, "ink") {
        cal = "buraaq_gfx_ink"
    }
    if eq(name, "wipe") {
        cal = "buraaq_gfx_wipe"
    }
    if eq(name, "plot") {
        cal = "buraaq_gfx_plot"
    }
    if eq(name, "box") {
        cal = "buraaq_gfx_box"
    }
    if eq(name, "dash") {
        cal = "buraaq_gfx_dash"
    }
    if eq(name, "flip") {
        cal = "buraaq_gfx_flip"
    }
    if eq(name, "held") {
        cal = "buraaq_gfx_held"
    }
    if eq(name, "pulse") {
        cal = "buraaq_gfx_pulse"
    }
    if eq(name, "play") {
        cal = "buraaq_gfx_play"
    }
    if eq(name, "tone") {
        cal = "buraaq_gfx_tone"
    }
    if eq(name, "hush") {
        cal = "buraaq_gfx_hush"
    }
    ty = "i32"
    dst = "%t{pos}"
    if rt == 2 {
        ty = "i8*"
        dst = "%p{pos}"
    }
    if rt == 3 {
        ty = "double"
        dst = "%t{pos}f"
    }
    if eq(l_bag_get(sigs, concat("g$", name)), "1") {
        a0nm = ""
        if scan_is_ident_start(byte(src, aspos)) {
            ae0 = scan_ident_end(src, aspos, n)
            a0nm = slice(src, aspos, ae0)
            nx0 = scan_skip(src, ae0, n)
            if byte(src, nx0) == 44 {
                done = 1
            } elif byte(src, nx0) == 41 {
                done = 1
            } else {
                a0nm = ""
            }
        }
        if l_struct_body(src, n, l_bag_get(ptxt, a0nm)) >= 0 {
            cal = concat(name, concat("__", l_bag_get(ptxt, a0nm)))
            rt = 2
            ty = "i8*"
            dst = "%p{pos}"
            done = 1
        } elif eq(l_bag_get(ptxt, a0nm), "f") {
            cal = concat(name, "__float")
            rt = 3
            ty = "double"
            dst = "%t{pos}f"
            done = 1
        } elif w0 == 3 {
            cal = concat(name, "__float")
            rt = 3
            ty = "double"
            dst = "%t{pos}f"
            done = 1
        } elif w0 == 2 {
            cal = concat(name, "__text")
            rt = 2
            ty = "i8*"
            dst = "%p{pos}"
            done = 1
        }
    }
    if did == 0 {
        l_emit_call(sink, cal, ty, dst, rt, alist)
        did = 1
    }
    if rt == 1 {
        l_emit(sink, "  %t{pos}l = add i32 %t{pos}, 0")
        done = 1
    }
    if rt == 0 {
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        done = 1
    }
    if rt == 2 {
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        done = 1
    }
    if rt == 3 {
        l_emit(sink, "  %t{pos}l = add i32 0, 0")
        done = 1
    }
    return i
}

fn l_emit_call(sink: text, cal: text, ty: text, dst: text, rt: int, alist: text) {
    if rt == 0 {
        l_emit(sink, "  call void @{cal}({alist})")
        done = 1
    }
    if rt == 1 {
        l_emit(sink, "  {dst} = call {ty} @{cal}({alist})")
        done = 1
    }
    if rt == 2 {
        l_emit(sink, "  {dst} = call {ty} @{cal}({alist})")
        done = 1
    }
    if rt == 3 {
        l_emit(sink, "  {dst} = call {ty} @{cal}({alist})")
        done = 1
    }
    done = 1
}

fn l_seta(sink: text, pos: int, kindt: int, cur: int) {
    if kindt == 1 {
        l_emit(sink, "  %t{pos}a = add i32 %and{cur}, 0")
        done = 1
    }
    if kindt == 0 {
        l_emit(sink, "  %t{pos}a = add i32 %t{pos}q, 0")
        done = 1
    }
    done = 1
}

fn l_setc(sink: text, pos: int, kindt: int, cur: int) {
    if kindt == 1 {
        l_emit(sink, "  %t{pos}c = add i32 %or{cur}, 0")
        done = 1
    }
    if kindt == 0 {
        l_emit(sink, "  %t{pos}c = add i32 %t{pos}a, 0")
        done = 1
    }
    done = 1
}

fn l_fadd(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    pos = idx
    i = l_prefix(src, idx, n, sink, 3, ptxt, sigs)
    acc = scan_skip(src, idx, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > 32 {
            break
        }
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 43 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 3, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus}f = fadd double %t{acc}f, %t{rp}f")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 45 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 3, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus}f = fsub double %t{acc}f, %t{rp}f")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 42 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 3, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus}f = fmul double %t{acc}f, %t{rp}f")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 47 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 3, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus}f = fdiv double %t{acc}f, %t{rp}f")
            acc = plus
            i = scan_skip(src, i, n)
        } else {
            break
        }
    }
    i
}

fn l_add(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    pos = idx
    i = l_prefix(src, idx, n, sink, 1, ptxt, sigs)
    acc = scan_skip(src, idx, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > 32 {
            break
        }
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == 43 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 1, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus} = add i32 %t{acc}l, %t{rp}l")
            l_emit(sink, "  %t{plus}l = add i32 %t{plus}, 0")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 45 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 1, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus} = sub i32 %t{acc}l, %t{rp}l")
            l_emit(sink, "  %t{plus}l = add i32 %t{plus}, 0")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 42 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 1, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus} = mul i32 %t{acc}l, %t{rp}l")
            l_emit(sink, "  %t{plus}l = add i32 %t{plus}, 0")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 47 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 1, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus} = sdiv i32 %t{acc}l, %t{rp}l")
            l_emit(sink, "  %t{plus}l = add i32 %t{plus}, 0")
            acc = plus
            i = scan_skip(src, i, n)
        } elif c == 37 {
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 1, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %t{plus} = srem i32 %t{acc}l, %t{rp}l")
            l_emit(sink, "  %t{plus}l = add i32 %t{plus}, 0")
            acc = plus
            i = scan_skip(src, i, n)
        } else {
            break
        }
    }
    return i
}

fn l_cmp(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    pos = idx
    lw = l_peek_want(src, idx, n, ptxt, sigs)
    if lw == 2 {
        i = l_prefix(src, idx, n, sink, 2, ptxt, sigs)
        i = scan_skip(src, i, n)
        if byte(src, i) == 61 {
            if byte(src, i + 1) == 61 {
                rpos = scan_skip(src, i + 2, n)
                i = l_prefix(src, rpos, n, sink, 2, ptxt, sigs)
                lp = scan_skip(src, idx, n)
                rp = scan_skip(src, rpos, n)
                l_emit(sink, "  %eqt{pos} = call i32 @buraaq_text_eq(i8* %p{lp}, i8* %p{rp})")
                l_emit(sink, "  %eqc{pos} = icmp eq i32 %eqt{pos}, 0")
                l_emit(sink, "  %t{pos}q = zext i1 %eqc{pos} to i32")
                return i
            }
        }
        if byte(src, i) == 33 {
            if byte(src, i + 1) == 61 {
                rpos = scan_skip(src, i + 2, n)
                i = l_prefix(src, rpos, n, sink, 2, ptxt, sigs)
                lp = scan_skip(src, idx, n)
                rp = scan_skip(src, rpos, n)
                l_emit(sink, "  %eqt{pos} = call i32 @buraaq_text_eq(i8* %p{lp}, i8* %p{rp})")
                l_emit(sink, "  %eqc{pos} = icmp ne i32 %eqt{pos}, 0")
                l_emit(sink, "  %t{pos}q = zext i1 %eqc{pos} to i32")
                return i
            }
        }
        accp = scan_skip(src, idx, n)
        l_emit(sink, "  %t{pos}q = add i32 0, 0")
        return i
    }
    i = l_add(src, idx, n, sink, ptxt, sigs)
    i = scan_skip(src, i, n)
    c = byte(src, i)
    nxt = byte(src, i + 1)
    pred = "_"
    step = 0
    if c == 61 {
        if nxt == 61 {
            pred = "eq"
            step = 2
        }
        done = 1
    }
    if c == 33 {
        if nxt == 61 {
            pred = "ne"
            step = 2
        }
        done = 1
    }
    if c == 62 {
        pred = "sgt"
        step = 1
        if nxt == 61 {
            pred = "sge"
            step = 2
        }
        done = 1
    }
    if c == 60 {
        pred = "slt"
        step = 1
        if nxt == 61 {
            pred = "sle"
            step = 2
        }
        done = 1
    }
    if step == 0 {
        # A bare operand is still named after its last top-level operator, so
        # `(a + b)` reads the sum and not the load of `a` that started it.
        accp = l_arg_slot(src, scan_skip(src, idx, n), i, 1, n)
        l_emit(sink, "  %t{pos}q = add i32 %t{accp}l, 0")
        return i
    }
    rpos = i + step
    i = l_add(src, rpos, n, sink, ptxt, sigs)
    lp = l_arg_slot(src, scan_skip(src, idx, n), rpos, 1, n)
    rp = l_arg_slot(src, scan_skip(src, rpos, n), i, 1, n)
    l_emit(sink, "  %cm{pos} = icmp {pred} i32 %t{lp}l, %t{rp}l")
    l_emit(sink, "  %t{pos}q = zext i1 %cm{pos} to i32")
    return i
}

fn l_and(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    pos = idx
    i = l_cmp(src, idx, n, sink, ptxt, sigs)
    i = scan_skip(src, i, n)
    accp = scan_skip(src, idx, n)
    kindt = 0
    cur = accp
    while byte(src, i) == 38 {
        if byte(src, i + 1) != 38 {
            break
        }
        rpos = scan_skip(src, i + 2, n)
        i = l_cmp(src, rpos, n, sink, ptxt, sigs)
        rp = scan_skip(src, rpos, n)
        left = "%t{cur}q"
        if kindt == 1 {
            left = "%and{cur}"
        }
        l_emit(sink, "  %and{i} = and i32 {left}, %t{rp}q")
        cur = i
        kindt = 1
        oldand = rpos
        i = scan_skip(src, i, n)
        if oldand > i {
            break
        }
        if i == oldand {
            break
        }
    }
    l_seta(sink, pos, kindt, cur)
    return i
}

fn l_print_space(sink: text) {
    l_emit(sink, "  call void @buraaq_print_str(i8* getelementptr ([2 x i8], [2 x i8]* @.sp, i32 0, i32 0))")
    done = 1
}

fn l_print_nl(sink: text) {
    l_emit(sink, "  call void @buraaq_print_str_ln(i8* getelementptr ([1 x i8], [1 x i8]* @.z, i32 0, i32 0))")
    done = 1
}

fn l_print_arg(sink: text, want: int, aval: text, ln: int) {
    if want == 2 {
        if ln == 1 {
            l_emit(sink, concat("  call void @buraaq_print_str_ln(i8* ", concat(aval, ")")))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_print_str(i8* ", concat(aval, ")")))
            done = 1
        }
    } elif want == 3 {
        if ln == 1 {
            l_emit(sink, concat("  call void @buraaq_print_f64_ln(double ", concat(aval, ")")))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_print_f64(double ", concat(aval, ")")))
            done = 1
        }
    } elif want == 4 {
        if ln == 1 {
            l_emit(sink, concat("  call void @buraaq_print_bool_ln(i32 ", concat(aval, ")")))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_print_bool(i32 ", concat(aval, ")")))
            done = 1
        }
    } else {
        if ln == 1 {
            l_emit(sink, concat("  call void @buraaq_print_i32_ln(i32 ", concat(aval, ")")))
            done = 1
        } else {
            l_emit(sink, concat("  call void @buraaq_print_i32(i32 ", concat(aval, ")")))
            done = 1
        }
    }
}

fn l_or(src: text, idx: int, n: int, sink: text, want: int, ptxt: text, sigs: text) -> int {
    pos = idx
    if want == 2 {
        i = l_prefix(src, idx, n, sink, 2, ptxt, sigs)
        acc = scan_skip(src, idx, n)
        hops = 0
        while hops < 8 {
            hops = hops + 1
            i = scan_skip(src, i, n)
            if byte(src, i) != 43 {
                break
            }
            plus = i
            rpos = scan_skip(src, i + 1, n)
            i = l_prefix(src, rpos, n, sink, 2, ptxt, sigs)
            rp = scan_skip(src, rpos, n)
            l_emit(sink, "  %p{plus} = call i8* @buraaq_text_concat(i8* %p{acc}, i8* %p{rp})")
            acc = plus
            i = scan_skip(src, i, n)
        }
        i = l_coalesce(src, i, n, sink, pos, acc, 2, ptxt, sigs)
        return i
    }
    if want == 3 {
        return l_fadd(src, idx, n, sink, ptxt, sigs)
    }
    if want == 4 {
        return l_prefix(src, idx, n, sink, 4, ptxt, sigs)
    }
    i = l_and(src, idx, n, sink, ptxt, sigs)
    i = scan_skip(src, i, n)
    accp = scan_skip(src, idx, n)
    kindt = 0
    cur = accp
    while byte(src, i) == 124 {
        if byte(src, i + 1) != 124 {
            break
        }
        rpos = scan_skip(src, i + 2, n)
        i = l_and(src, rpos, n, sink, ptxt, sigs)
        rp = scan_skip(src, rpos, n)
        left = "%t{cur}a"
        if kindt == 1 {
            left = "%or{cur}"
        }
        l_emit(sink, "  %or{i} = or i32 {left}, %t{rp}a")
        cur = i
        kindt = 1
        oldor = rpos
        i = scan_skip(src, i, n)
        if oldor > i {
            break
        }
        if i == oldor {
            break
        }
    }
    l_setc(sink, pos, kindt, cur)
    i = l_coalesce(src, i, n, sink, pos, cur, 1, ptxt, sigs)
    return i
}

# `a ?? b` — use `b` when `a` is 0 / null. Result is named after `??`.
fn l_coalesce(src: text, idx: int, n: int, sink: text, pos: int, acc: int, want: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 63 {
        if byte(src, i + 1) == 63 {
            qq = i
            rpos = scan_skip(src, i + 2, n)
            i = l_or(src, rpos, n, sink, want, ptxt, sigs)
            rp = l_arg_slot(src, rpos, i, want, n)
            if want == 2 {
                l_emit(sink, "  %cn{qq} = icmp eq i8* %p{acc}, null")
                l_emit(sink, "  %p{qq} = select i1 %cn{qq}, i8* %p{rp}, i8* %p{acc}")
                done = 1
            } else {
                l_emit(sink, "  %cn{qq} = icmp eq i32 %t{acc}l, 0")
                l_emit(sink, "  %t{qq}l = select i1 %cn{qq}, i32 %t{rp}l, i32 %t{acc}l")
                done = 1
            }
            return i
        }
    }
    i
}

fn l_local(sink: text, nm: text) {
    l_emit(sink, "  %{nm}.i = alloca i32")
    l_emit(sink, "  %{nm}.p = alloca i8*")
    l_emit(sink, "  %{nm}.f = alloca double")
    done = 1
}

# Declare `nm` once per function. `seen` is a set: this used to be a comma bag
# that was scanned to test membership and rebuilt to add, so a function with a
# thousand locals spent most of the compile here.
fn l_need_local(sink: text, seen: text, nm: text) -> text {
    if set_add(seen, nm) == 1 {
        l_local(sink, nm)
    }
    seen
}

fn l_seed_locals(sink: text, pall: text) -> text {
    seen = set_new()
    set_add_csv(seen, pall)
    seen = l_need_local(sink, seen, "c")
    seen = l_need_local(sink, seen, "i")
    seen = l_need_local(sink, seen, "n")
    seen = l_need_local(sink, seen, "idx")
    seen = l_need_local(sink, seen, "nxt")
    seen = l_need_local(sink, seen, "start")
    seen = l_need_local(sink, seen, "end")
    seen = l_need_local(sink, seen, "ch")
    seen = l_need_local(sink, seen, "e")
    seen = l_need_local(sink, seen, "k")
    seen = l_need_local(sink, seen, "src")
    seen = l_need_local(sink, seen, "path")
    seen = l_need_local(sink, seen, "name")
    seen = l_need_local(sink, seen, "kind")
    seen = l_need_local(sink, seen, "w")
    seen = l_need_local(sink, seen, "done")
    seen = l_need_local(sink, seen, "ln")
    seen = l_need_local(sink, seen, "s")
    seen = l_need_local(sink, seen, "g")
    seen = l_need_local(sink, seen, "q")
    seen
}

# Past the `{ ... }` that follows idx, matching nesting.
# Directory part of `path`, separator included, or "" when there is none.
fn l_dir_of(path: text) -> text {
    n = len(path)
    cut = 0 - 1
    i = 0
    while i < n {
        c = byte(path, i)
        if c == 47 {
            cut = i
        }
        if c == 92 {
            cut = i
        }
        i = i + 1
    }
    if cut < 0 {
        return ""
    }
    slice(path, 0, cut + 1)
}

# Read a source file and refuse constructs this emitter cannot lower, with line
# numbers in THAT file. Checking the concatenated unit used to report a line in
# `main.bq` for an error that lived in `llvm.bq`.
fn l_load_file(path: text) -> text {
    t = read(path)
    if len(t) > 0 {
        l_check(t, len(t), path)
    }
    t
}

# Source of module `m`, looked for beside the entry file and then under `src/`.
# An entry point can therefore sit at the root of a project whose modules live in
# `src/`, which is where this compiler's own do.
fn l_module_src(dir: text, m: text) -> text {
    leaf = concat(m, ".bq")
    p = concat(dir, leaf)
    t = l_load_file(p)
    if len(t) > 0 {
        return t
    }
    p = concat(dir, concat("src/", leaf))
    t = l_load_file(p)
    if len(t) > 0 {
        return t
    }
    eprintln(concat("buraaq-boot: cannot find module ", m))
    exit(1)
    ""
}

# Record every `use` of a project module. `use std.io` and `use io` are std
# unless the project has src/io.bq. `seen` keeps each module to one entry.
fn l_uses_into(src: text, seen: text, order: text, dir: text) {
    n = len(src)
    i = 0
    while i < n {
        kw = 0
        if scan_word_is(src, i, n, "use") {
            kw = 3
        }
        if scan_word_is(src, i, n, "import") {
            kw = 6
        }
        if kw > 0 {
            k = scan_skip(src, i + kw, n)
            e = scan_ident_end(src, k, n)
            m = slice(src, k, e)
            if eq(m, "std") {
                done = 1
            } elif l_std_mod(m) == 1 {
                if l_user_module(dir, m) == 1 {
                    if set_add(seen, m) == 1 {
                        vec_push_text(order, m)
                    }
                }
            } else {
                if len(m) > 0 {
                    if set_add(seen, m) == 1 {
                        vec_push_text(order, m)
                    }
                }
            }
        }
        while i < n {
            if byte(src, i) == 10 {
                i = i + 1
                break
            }
            i = i + 1
        }
    }
    done = 1
}

# The whole program as one text: the entry file preceded by every module it
# reaches through `use`, transitively.
#
# The emitter reads a single string, so a program spread across files used to be
# glued together by hand before it could be compiled. Names are resolved by the
# emitter from the text it is given, so the order modules appear in does not
# matter; only that they are all present.
fn l_unit(path: text) -> text {
    dir = l_dir_of(path)
    entry = l_load_file(path)
    if len(entry) == 0 {
        eprintln(concat("buraaq-boot: cannot read ", path))
        exit(1)
    }
    seen = set_new()
    order = vec_new()
    l_uses_into(entry, seen, order, dir)
    body = ""
    i = 0
    # vec_len is re-read each turn: a module can pull in further modules.
    while i < vec_len(order) {
        m = vec_get_text(order, i)
        t = l_module_src(dir, m)
        l_uses_into(t, seen, order, dir)
        body = concat(body, concat(t, "\n"))
        i = i + 1
    }
    concat(body, entry)
}

fn l_skip_braced(src: text, idx: int, n: int) -> int {
    i = idx
    d = 0
    seenb = 0
    while i < n {
        c = byte(src, i)
        if c == 123 {
            d = d + 1
            seenb = 1
        }
        if c == 125 {
            d = d - 1
            if d == 0 {
                return i + 1
            }
        }
        if seenb == 1 {
            if d == 0 {
                return i + 1
            }
        }
        i = i + 1
    }
    i
}

fn l_skip_stmt(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 123 {
        return l_skip_braced(src, i, n)
    }
    d = 0
    while i < n {
        c = byte(src, i)
        if c == 40 {
            d = d + 1
        }
        if c == 41 {
            d = d - 1
        }
        if c == 123 {
            if d == 0 {
                return l_skip_braced(src, i, n)
            }
        }
        if c == 10 {
            if d == 0 {
                return i + 1
            }
        }
        if c == 59 {
            if d == 0 {
                return i + 1
            }
        }
        if c == 125 {
            if d == 0 {
                return i
            }
        }
        i = i + 1
    }
    i
}

# Could `nm {` begin a struct literal?
#
# `while i < n {` also puts an identifier before a brace, so the name alone is
# ambiguous with the head of a loop or an if. Struct names are capitalised
# throughout Buraaq — `Point`, `Command`, `File` — and requiring that here both
# resolves the ambiguity and keeps the declaration scan off the common path.
fn l_looks_struct(nm: text) -> bool {
    if len(nm) == 0 {
        return false
    }
    c = byte(nm, 0)
    c >= 65 && c <= 90
}

# Struct named by a `Name { ... }` literal at idx, or "" if there is not one.
fn l_lit_struct(src: text, idx: int, n: int) -> text {
    i = scan_skip(src, idx, n)
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        nm = slice(src, i, e)
        j = scan_skip(src, e, n)
        if byte(src, j) == 91 {
            j = l_bracket_end(src, j, n)
            j = scan_skip(src, j, n)
        }
        if byte(src, j) == 123 {
            if l_looks_struct(nm) {
                if l_struct_body(src, n, nm) >= 0 {
                    return nm
                }
            }
        }
    }
    ""
}

# One walk over a function body, adding every local whose right-hand side yields
# text to `bag`. Mirrors l_prescan's skipping of comments, strings and braces.
fn l_text_locals_once(src: text, idx: int, n: int, bag: text, sigs: text) -> text {
    i = idx
    d = 0
    while i < n {
        c = byte(src, i)
        step = 1
        go = 1
        if c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
            go = 0
            step = 0
        }
        if c == 34 {
            if go == 1 {
                i = i + 1
                while i < n {
                    if byte(src, i) == 34 {
                        i = i + 1
                        break
                    }
                    if byte(src, i) == 92 {
                        if i + 1 < n {
                            i = i + 2
                        } else {
                            i = i + 1
                        }
                    } else {
                        i = i + 1
                    }
                }
                go = 0
                step = 0
            }
        }
        if go == 1 {
            if c == 123 {
                d = d + 1
            }
            if c == 125 {
                d = d - 1
            }
            if c == 125 {
                if d == 0 {
                    return bag
                }
            }
            if scan_word_is(src, i, n, "mut") {
                i = i + 3
                step = 0
            } elif scan_is_ident_start(c) {
                e = scan_ident_end(src, i, n)
                j = scan_skip(src, e, n)
                tw = 0
                mark_vt = 0
                if byte(src, j) == 58 {
                    te = scan_skip_type(src, j + 1, n)
                    tstart = scan_skip(src, j + 1, n)
                    tn = slice(src, tstart, scan_ident_end(src, tstart, n))
                    tw = l_want_of_type(tn)
                    if eq(tn, "List") {
                        tb = scan_skip(src, scan_ident_end(src, tstart, n), n)
                        if byte(src, tb) == 91 {
                            inner = scan_skip(src, tb + 1, n)
                            inn = slice(src, inner, scan_ident_end(src, inner, n))
                            if eq(inn, "text") {
                                tw = 2
                                mark_vt = 1
                            }
                        }
                    }
                    j = scan_skip(src, te, n)
                }
                isas = 0
                if byte(src, j) == 61 {
                    if byte(src, j + 1) != 61 {
                        isas = 1
                    }
                }
                if byte(src, j) == 46 {
                    me = scan_ident_end(src, j + 1, n)
                    meth = slice(src, j + 1, me)
                    mj = scan_skip(src, me, n)
                    if eq(meth, "push") {
                        if byte(src, mj) == 40 {
                            pwpush = l_peek_want(src, scan_skip(src, mj + 1, n), n, bag, sigs)
                            if pwpush == 2 {
                                pnm = slice(src, i, e)
                                if l_bag_has(bag, pnm) {
                                    done = 1
                                } else {
                                    bag = concat(bag, concat(pnm, ","))
                                }
                                if eq(l_bag_get(bag, pnm), "vt") {
                                    done = 1
                                } else {
                                    bag = concat(bag, concat(pnm, ":vt,"))
                                }
                            }
                        }
                    }
                    e = me
                }
                if isas == 1 {
                    nm = slice(src, i, e)
                    pw = l_peek_want(src, j + 1, n, bag, sigs)
                    ew = l_array_elem_want(src, j + 1, n, bag, sigs)
                    if ew == 2 {
                        mark_vt = 1
                    }
                    if tw == 2 {
                        pw = 2
                    }
                    if tw == 3 {
                        pw = 3
                    }
                    if tw == 4 {
                        pw = 4
                    }
                    if pw == 2 {
                        if l_bag_has(bag, nm) {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ","))
                        }
                    }
                    if mark_vt == 1 {
                        if eq(l_bag_get(bag, nm), "vt") {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ":vt,"))
                        }
                    }
                    mw = l_map_val_want(src, j + 1, n, bag, sigs)
                    if mw > 0 {
                        if l_bag_has(bag, nm) {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ","))
                        }
                        if mw == 2 {
                            if eq(l_bag_get(bag, nm), "mt") {
                                done = 1
                            } else {
                                bag = concat(bag, concat(nm, ":mt,"))
                            }
                        } else {
                            if eq(l_bag_get(bag, nm), "mi") {
                                done = 1
                            } else {
                                bag = concat(bag, concat(nm, ":mi,"))
                            }
                        }
                    }
                    rhs = scan_skip(src, j + 1, n)
                    if scan_word_is(src, rhs, n, "spawn") {
                        if l_bag_has(bag, nm) {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ","))
                        }
                        if eq(l_bag_get(bag, nm), "h") {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ":h,"))
                        }
                    }
                    if scan_word_is(src, rhs, n, "spawn_task") {
                        if l_bag_has(bag, nm) {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ","))
                        }
                        if eq(l_bag_get(bag, nm), "h") {
                            done = 1
                        } else {
                            bag = concat(bag, concat(nm, ":h,"))
                        }
                    }
                    if pw == 3 {
                        if len(l_bag_get(bag, nm)) == 0 {
                            bag = concat(bag, concat(nm, ":f,"))
                        }
                    }
                    if pw == 4 {
                        if len(l_bag_get(bag, nm)) == 0 {
                            bag = concat(bag, concat(nm, ":b,"))
                        }
                    }
                    # A struct local is pointer-shaped like text, and also needs
                    # its type remembered so `nm.field` can find an offset.
                    sn = l_lit_struct(src, j + 1, n)
                    if len(sn) > 0 {
                        if len(l_bag_get(bag, nm)) == 0 {
                            bag = concat(bag, concat(nm, concat(":", concat(sn, ","))))
                        }
                    }
                }
                if e == i {
                    e = i + 1
                }
                i = e
                step = 0
            }
        }
        i = i + step
    }
    bag
}

# Which locals of this function hold text, decided by what is assigned to them.
#
# This replaces a hardcoded list of names that inferred a type from spelling: a
# local called `line` was assumed to hold text and one called `w` an int,
# wherever either appeared. Any function that disagreed loaded from the wrong
# slot, which is how two of the bootstrap miscompiles happened.
#
# Repeated because `b = a` can be read before `a = concat(...)` is; each pass
# propagates one more link of such a chain and three settles what occurs here.
fn l_text_locals(src: text, idx: int, n: int, ptxt: text, sigs: text) -> text {
    bag = ptxt
    pass = 0
    while pass < 3 {
        bag = l_text_locals_once(src, idx, n, bag, sigs)
        pass = pass + 1
    }
    bag
}

# Names bound by `.Variant(x)` / `.Move { x, y }` / `Some(n)` so they have slots.
fn l_prescan_binds(src: text, idx: int, n: int, sink: text, seen: text) -> text {
    i = idx
    close = 41
    if byte(src, i) == 123 {
        close = 125
    }
    if byte(src, i) == 40 {
        close = 41
    }
    i = i + 1
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > 64 {
            break
        }
        i = scan_skip(src, i, n)
        c = byte(src, i)
        if c == close {
            break
        }
        if c == 44 {
            i = i + 1
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            if eq(nm, "mut") {
                i = e
            } else {
                seen = l_need_local(sink, seen, nm)
                i = scan_skip(src, e, n)
                if byte(src, i) == 58 {
                    i = scan_skip_type(src, i + 1, n)
                }
            }
        } else {
            i = i + 1
        }
    }
    seen
}

# Declare every local the function assigns to, before emitting its body.
# `seen` is the set built by l_seed_locals, so a name already declared there is
# not declared again.
fn l_prescan(src: text, idx: int, n: int, sink: text, seen: text) -> int {
    i = idx
    d = 0
    while i < n {
        c = byte(src, i)
        step = 1
        go = 1
        if c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
            go = 0
            step = 0
            done = 1
        }
        if c == 34 {
            if go == 1 {
                i = i + 1
                while i < n {
                    if byte(src, i) == 34 {
                        i = i + 1
                        break
                    }
                    if byte(src, i) == 92 {
                        if i + 1 < n {
                            i = i + 2
                        } else {
                            i = i + 1
                        }
                    } else {
                        i = i + 1
                    }
                }
                go = 0
                step = 0
            }
            done = 1
        }
        if go == 1 {
            if c == 123 {
                d = d + 1
                done = 1
            }
            if c == 125 {
                d = d - 1
                done = 1
            }
            if c == 125 {
                if d == 0 {
                    return i + 1
                }
                done = 1
            }
            # `for v in ...` binds v without assigning to it, so the assignment
            # scan below never sees it and it would have no slot.
            if scan_word_is(src, i, n, "for") {
                fv = l_skip_mut(src, scan_skip(src, i + 3, n), n)
                fe = scan_ident_end(src, fv, n)
                if fe > fv {
                    seen = l_need_local(sink, seen, slice(src, fv, fe))
                }
            }
            # `.Move { x, y }` / `.Write(t)` bind names that are never assigned.
            if c == 46 {
                if scan_is_ident_start(byte(src, i + 1)) {
                    ve = scan_ident_end(src, i + 1, n)
                    j2 = scan_skip(src, ve, n)
                    if byte(src, j2) == 40 {
                        seen = l_prescan_binds(src, j2, n, sink, seen)
                    }
                    if byte(src, j2) == 123 {
                        seen = l_prescan_binds(src, j2, n, sink, seen)
                    }
                }
            }
            if scan_word_is(src, i, n, "mut") {
                i = i + 3
                step = 0
            } elif scan_is_ident_start(c) {
                e = scan_ident_end(src, i, n)
                j = scan_skip(src, e, n)
                ctor = slice(src, i, e)
                is_ctor = 0
                if eq(ctor, "Some") {
                    is_ctor = 1
                }
                if eq(ctor, "some") {
                    is_ctor = 1
                }
                if eq(ctor, "Ok") {
                    is_ctor = 1
                }
                if eq(ctor, "Err") {
                    is_ctor = 1
                }
                if is_ctor == 1 {
                    if byte(src, j) == 40 {
                        seen = l_prescan_binds(src, j, n, sink, seen)
                    }
                }
                # `name: T = expr` declares a local too. Without this the colon
                # stopped the scan and the local was never allocated.
                if byte(src, j) == 58 {
                    j = scan_skip(src, scan_skip_type(src, j + 1, n), n)
                }
                isas = 0
                if byte(src, j) == 61 {
                    if byte(src, j + 1) != 61 {
                        isas = 1
                    }
                    done = 1
                }
                # `base.field = v` assigns through the struct, not to a local
                # named after the field; stepping over it avoids declaring one.
                if byte(src, j) == 46 {
                    e = scan_ident_end(src, j + 1, n)
                }
                if isas == 1 {
                    nm = slice(src, i, e)
                    seen = l_need_local(sink, seen, nm)
                    done = 1
                }
                if e == i {
                    e = i + 1
                }
                i = e
                step = 0
                done = 1
            }
            done = 1
        }
        i = i + step
    }
    i
}

fn l_flush_defers(src: text, n: int, dv: text, sink: text, ptxt: text, sigs: text) {
    k = vec_len(dv)
    while k > 0 {
        k = k - 1
        rec = vec_get_text(dv, k)
        start = l_int_of(rec)
        l_stmt_expr(src, start, n, sink, ptxt, 1, sigs)
        done = 1
    }
    done = 1
}

# Store one if-arm's value into the merge slots named after `mpos`.
fn l_if_arm_store(src: text, idx: int, n: int, sink: text, want: int, mpos: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    last = 0
    lastp = 0
    if byte(src, i) == 123 {
        i = i + 1
        hops = 0
        while i < n {
            hops = hops + 1
            if hops > n + 8 {
                break
            }
            i = scan_skip(src, i, n)
            if byte(src, i) == 125 {
                i = i + 1
                break
            }
            epos = i
            i = l_stmt_expr(src, i, n, sink, ptxt, want, sigs)
            last = l_plus_in(src, epos, i)
            lastp = l_arg_slot(src, epos, i, 2, n)
            i = scan_skip(src, i, n)
        }
        done = 1
    } else {
        epos = i
        i = l_or(src, i, n, sink, want, ptxt, sigs)
        last = l_plus_in(src, epos, i)
        lastp = l_arg_slot(src, epos, i, 2, n)
        done = 1
    }
    if want == 2 {
        if lastp > 0 {
            l_emit(sink, "  store i8* %p{lastp}, i8** %im{mpos}p")
            done = 1
        } else {
            l_emit(sink, "  store i8* null, i8** %im{mpos}p")
            done = 1
        }
        done = 1
    } else {
        if last > 0 {
            l_emit(sink, "  store i32 %t{last}l, i32* %im{mpos}i")
            done = 1
        } else {
            l_emit(sink, "  store i32 0, i32* %im{mpos}i")
            done = 1
        }
        done = 1
    }
    i
}

# `if cond { a } else { b }` as a value. Arms store into allocas, then the
# join loads them so each SSA name is defined once.
fn l_if_expr(src: text, idx: int, n: int, sink: text, want: int, ptxt: text, sigs: text, kw: int) -> int {
    pos = idx
    l_emit(sink, "  %im{pos}i = alloca i32")
    l_emit(sink, "  %im{pos}p = alloca i8*")
    i = scan_skip(src, idx + kw, n)
    cpos = i
    i = l_or(src, i, n, sink, 1, ptxt, sigs)
    l_emit(sink, "  %ik{pos} = icmp ne i32 %t{cpos}c, 0")
    l_emit(sink, "  br i1 %ik{pos}, label %ith_{pos}, label %inx_{pos}")
    l_emit(sink, "ith_{pos}:")
    i = l_if_arm_store(src, i, n, sink, want, pos, ptxt, sigs)
    l_emit(sink, "  br label %ij_{pos}")
    l_emit(sink, "inx_{pos}:")
    i = scan_skip(src, i, n)
    is_el = 0
    if scan_word_is(src, i, n, "elif") {
        is_el = 1
    }
    is_es = 0
    if scan_word_is(src, i, n, "else") {
        is_es = 1
    }
    if is_el == 1 {
        epos = i
        i = l_if_expr(src, i, n, sink, want, ptxt, sigs, 4)
        if want == 2 {
            l_emit(sink, "  store i8* %p{epos}, i8** %im{pos}p")
            done = 1
        } else {
            l_emit(sink, "  store i32 %t{epos}l, i32* %im{pos}i")
            done = 1
        }
        l_emit(sink, "  br label %ij_{pos}")
        done = 1
    }
    if is_es == 1 {
        i = scan_skip(src, i + 4, n)
        i = l_if_arm_store(src, i, n, sink, want, pos, ptxt, sigs)
        l_emit(sink, "  br label %ij_{pos}")
        done = 1
    }
    if is_el == 0 {
        if is_es == 0 {
            if want == 2 {
                l_emit(sink, "  store i8* null, i8** %im{pos}p")
                done = 1
            } else {
                l_emit(sink, "  store i32 0, i32* %im{pos}i")
                done = 1
            }
            l_emit(sink, "  br label %ij_{pos}")
            done = 1
        }
    }
    l_emit(sink, "ij_{pos}:")
    l_emit(sink, "  %t{pos}l = load i32, i32* %im{pos}i")
    l_emit(sink, "  %p{pos} = load i8*, i8** %im{pos}p")
    return i
}

fn l_unsafe_expr(src: text, idx: int, n: int, sink: text, want: int, ptxt: text, sigs: text) -> int {
    pos = idx
    i = scan_skip(src, idx + 6, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    inner = scan_skip(src, i, n)
    last = inner
    lastp = inner
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 125 {
            i = i + 1
            break
        }
        epos = i
        i = l_stmt_expr(src, i, n, sink, ptxt, want, sigs)
        last = l_plus_in(src, epos, i)
        lastp = l_arg_slot(src, epos, i, 2, n)
    }
    if want == 2 {
        l_emit(sink, "  %p{pos} = bitcast i8* %p{lastp} to i8*")
        done = 1
    } else {
        l_emit(sink, "  %t{pos}l = add i32 %t{last}l, 0")
        done = 1
    }
    i
}

fn l_if(src: text, idx: int, n: int, sink: text, rty: int, wend: int, ptxt: text, kw: int, sigs: text, dv: text, tailret: int) -> int {
    pos = idx
    i = scan_skip(src, idx + kw, n)
    cpos = i
    i = l_or(src, i, n, sink, 1, ptxt, sigs)
    l_emit(sink, "  %k{pos} = icmp ne i32 %t{cpos}c, 0")
    l_emit(sink, "  br i1 %k{pos}, label %then_{pos}, label %nxt_{pos}")
    l_emit(sink, "then_{pos}:")
    i = l_block(src, i, n, sink, rty, wend, pos, ptxt, 0, sigs, dv, tailret)
    l_emit(sink, "nxt_{pos}:")
    i = scan_skip(src, i, n)
    is_el = 0
    if scan_word_is(src, i, n, "elif") {
        is_el = 1
    }
    is_es = 0
    if scan_word_is(src, i, n, "else") {
        is_es = 1
    }
    need_br = 1
    if is_el == 1 {
        i = l_if(src, i, n, sink, rty, wend, ptxt, 4, sigs, dv, tailret)
        need_br = 1
        done = 1
    }
    if is_es == 1 {
        i = scan_skip(src, i + 4, n)
        i = l_block(src, i, n, sink, rty, wend, pos, ptxt, 0, sigs, dv, tailret)
        need_br = 0
        done = 1
    }
    if need_br == 1 {
        l_emit(sink, "  br label %j_{pos}")
        done = 1
    }
    l_emit(sink, "j_{pos}:")
    return i
}

# `match expr { pat => arm ... }`.
#
# The subject is evaluated once and each arm compares against it, which is a
# chain of branches rather than a jump table. Tags are small and contiguous, so a
# table would be faster, but it needs the arms sorted and the gaps filled, and
# the emitter has nowhere to hold that while it is streaming out a block.
#
# A pattern is an integer, an `Enum.Variant`, or `_`. Arms are tried in order and
# nothing checks exhaustiveness: an unmatched subject falls out of the match with
# no arm taken.
fn l_match(src: text, idx: int, n: int, sink: text, rty: int, wend: int, ptxt: text, sigs: text, dv: text, want: int) -> int {
    pos = idx
    l_emit(sink, "  %im{pos}i = alloca i32")
    l_emit(sink, "  %im{pos}p = alloca i8*")
    i = scan_skip(src, idx + 5, n)
    spos = i
    sw = l_peek_want(src, spos, n, ptxt, sigs)
    if sw == 2 {
        i = l_or(src, spos, n, sink, 2, ptxt, sigs)
        subjp = l_val(2, l_arg_slot(src, spos, i, 2, n))
        l_emit(sink, concat("  %ms{pos}p = bitcast i8* ", concat(subjp, " to i8*")))
        l_emit(sink, "  %ms{pos} = add i32 0, 0")
        done = 1
    } else {
        i = l_or(src, spos, n, sink, 1, ptxt, sigs)
        subj = l_val(1, l_arg_slot(src, spos, i, 1, n))
        l_emit(sink, "  %ms{pos} = add i32 {subj}, 0")
        l_emit(sink, "  %ms{pos}p = bitcast i8* null to i8*")
        done = 1
    }
    i = scan_skip(src, i, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    arm = 0
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 125 {
            i = i + 1
            break
        }
        arm = arm + 1
        wild = 0
        tag = 0
        ename = ""
        bnm = ""
        if byte(src, i) == 95 {
            wild = 1
            i = i + 1
        } elif byte(src, i) == 46 {
            ve = scan_ident_end(src, i + 1, n)
            ename = slice(src, i + 1, ve)
            tag = l_enum_tag_any(src, n, ename)
            if tag < 0 {
                tag = 0
            }
            i = ve
        } elif scan_is_digit(byte(src, i)) {
            e = i
            while e < n {
                if scan_is_digit(byte(src, e)) {
                    e = e + 1
                } else {
                    break
                }
            }
            tag = l_int_of(slice(src, i, e))
            i = e
        } elif scan_is_ident_start(byte(src, i)) {
            e = scan_ident_end(src, i, n)
            typn = slice(src, i, e)
            ename = typn
            i = e
            if byte(src, i) == 46 {
                ve = scan_ident_end(src, i + 1, n)
                ename = slice(src, i + 1, ve)
                tag = l_enum_tag(src, n, typn, ename)
                if tag < 0 {
                    tag = 0
                }
                i = ve
            }
        } else {
            i = i + 1
        }
        i = scan_skip(src, i, n)
        i = scan_skip(src, i, n)
        if byte(src, i) == 40 {
            i = scan_skip(src, i + 1, n)
            if scan_is_ident_start(byte(src, i)) {
                be = scan_ident_end(src, i, n)
                bnm = slice(src, i, be)
                i = be
                done = 1
            }
            while i < n {
                if byte(src, i) == 41 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        }
        if byte(src, i) == 123 {
            inner = scan_skip(src, i + 1, n)
            if scan_is_ident_start(byte(src, inner)) {
                be = scan_ident_end(src, inner, n)
                bnm = slice(src, inner, be)
                done = 1
            }
            i = l_skip_braced(src, i, n)
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 61 {
            i = i + 1
        }
        if byte(src, i) == 62 {
            i = i + 1
        }
        i = scan_skip(src, i, n)
        is_none = 0
        if eq(ename, "None") {
            is_none = 1
        }
        if eq(ename, "none") {
            is_none = 1
        }
        is_some = 0
        if eq(ename, "Some") {
            is_some = 1
        }
        if eq(ename, "some") {
            is_some = 1
        }
        if wild == 0 {
            if sw == 2 {
                if is_none == 1 {
                    l_emit(sink, "  %mc{pos}_{arm} = icmp eq i8* %ms{pos}p, null")
                    done = 1
                } elif is_some == 1 {
                    l_emit(sink, "  %mc{pos}_{arm} = icmp ne i8* %ms{pos}p, null")
                    done = 1
                } else {
                    l_emit(sink, "  %mt{pos}_{arm} = bitcast i8* %ms{pos}p to i32*")
                    l_emit(sink, "  %mv{pos}_{arm} = load i32, i32* %mt{pos}_{arm}")
                    l_emit(sink, "  %mc{pos}_{arm} = icmp eq i32 %mv{pos}_{arm}, {tag}")
                    done = 1
                }
                done = 1
            } else {
                l_emit(sink, "  %mc{pos}_{arm} = icmp eq i32 %ms{pos}, {tag}")
                done = 1
            }
            l_emit(sink, "  br i1 %mc{pos}_{arm}, label %ma{pos}_{arm}, label %mn{pos}_{arm}")
            l_emit(sink, "ma{pos}_{arm}:")
            done = 1
        } else {
            l_emit(sink, "  br label %ma{pos}_{arm}")
            l_emit(sink, "ma{pos}_{arm}:")
            done = 1
        }
        if is_none == 0 {
            if len(bnm) > 0 {
                if sw == 2 {
                    l_emit(sink, "  %pl{pos}_{arm} = getelementptr i8, i8* %ms{pos}p, i32 8")
                    l_emit(sink, "  %pi{pos}_{arm} = bitcast i8* %pl{pos}_{arm} to i32*")
                    l_emit(sink, "  %nv{pos}_{arm} = load i32, i32* %pi{pos}_{arm}")
                    l_emit(sink, "  store i32 %nv{pos}_{arm}, i32* %{bnm}.i")
                    l_emit(sink, "  %pp{pos}_{arm} = bitcast i8* %pl{pos}_{arm} to i8**")
                    l_emit(sink, "  %pv{pos}_{arm} = load i8*, i8** %pp{pos}_{arm}")
                    l_emit(sink, "  store i8* %pv{pos}_{arm}, i8** %{bnm}.p")
                    ptxt = concat(ptxt, concat(bnm, ","))
                    done = 1
                }
            }
        }
        aw = want
        if aw == 0 {
            if rty == 2 {
                aw = 2
            } else {
                aw = 1
            }
        }
        i = l_if_arm_store(src, i, n, sink, aw, pos, ptxt, sigs)
        i = scan_skip(src, i, n)
        if byte(src, i) == 44 {
            i = i + 1
        }
        l_emit(sink, "  br label %j_{pos}")
        l_emit(sink, "mn{pos}_{arm}:")
    }
    l_emit(sink, "  br label %j_{pos}")
    l_emit(sink, "j_{pos}:")
    l_emit(sink, "  %t{pos}l = load i32, i32* %im{pos}i")
    l_emit(sink, "  %p{pos} = load i8*, i8** %im{pos}p")
    return i
}

fn l_while(src: text, idx: int, n: int, sink: text, rty: int, ptxt: text, sigs: text, dv: text) -> int {
    pos = idx
    l_emit(sink, "  br label %wh_{pos}")
    l_emit(sink, "wh_{pos}:")
    i = scan_skip(src, idx + 5, n)
    cpos = i
    i = l_or(src, i, n, sink, 1, ptxt, sigs)
    l_emit(sink, "  %wk{pos} = icmp ne i32 %t{cpos}c, 0")
    l_emit(sink, "  br i1 %wk{pos}, label %wb_{pos}, label %we_{pos}")
    l_emit(sink, "wb_{pos}:")
    i = l_block(src, i, n, sink, rty, pos, 0, ptxt, 0, sigs, dv, 0)
    l_emit(sink, "we_{pos}:")
    return i
}

# `loop { }` is `while true` with the same back-edge labels break already uses.
fn l_loop(src: text, idx: int, n: int, sink: text, rty: int, ptxt: text, sigs: text, dv: text) -> int {
    pos = idx
    l_emit(sink, "  br label %wh_{pos}")
    l_emit(sink, "wh_{pos}:")
    l_emit(sink, "  br label %wb_{pos}")
    l_emit(sink, "wb_{pos}:")
    i = scan_skip(src, idx + 4, n)
    i = l_block(src, i, n, sink, rty, pos, 0, ptxt, 0, sigs, dv, 0)
    l_emit(sink, "we_{pos}:")
    return i
}

# `unsafe { ... }` is a scope. The guest does not model raw pointers; it only
# unwraps the keyword so files that wrap runtime calls still compile.
fn l_unsafe(src: text, idx: int, n: int, sink: text, rty: int, wend: int, ptxt: text, sigs: text, dv: text) -> int {
    pos = idx
    i = scan_skip(src, idx + 6, n)
    l_emit(sink, "  br label %ub_{pos}")
    l_emit(sink, "ub_{pos}:")
    i = l_block(src, i, n, sink, rty, wend, pos, ptxt, 0, sigs, dv, 0)
    l_emit(sink, "j_{pos}:")
    return i
}

# `for v in a..b { }` and `for v in a..=b { }`.
#
# The counter starts one below `a` and is stepped at the top of the loop, so the
# back edge and the exit are the two a `while` already has: `l_block` closes a
# body by branching to `wh_`, and `break` by branching to `we_`, and a for-loop
# that incremented at the bottom would need a third place to land.
#
# The bound is re-evaluated each turn, like the condition of a `while`. Holding
# it would need somewhere to put it, and locals are only allocated in the entry
# block.
fn l_for(src: text, idx: int, n: int, sink: text, rty: int, ptxt: text, sigs: text, dv: text) -> int {
    pos = idx
    i = l_skip_mut(src, scan_skip(src, idx + 3, n), n)
    ve = scan_ident_end(src, i, n)
    var = slice(src, i, ve)
    i = scan_skip(src, ve, n)
    if scan_word_is(src, i, n, "in") {
        i = scan_skip(src, i + 2, n)
    }
    spos = i
    sw = l_peek_want(src, spos, n, ptxt, sigs)
    i = l_or(src, spos, n, sink, sw, ptxt, sigs)
    send = i
    i = scan_skip(src, i, n)
    isrange = 0
    incl = 0
    if byte(src, i) == 46 {
        if byte(src, i + 1) == 46 {
            isrange = 1
            i = i + 2
            if byte(src, i) == 61 {
                incl = 1
                i = i + 1
            }
        }
    }
    if isrange == 1 {
        sval = l_val(1, l_arg_slot(src, spos, send, 1, n))
        l_emit(sink, "  %fs{pos} = sub i32 {sval}, 1")
        l_emit(sink, "  store i32 %fs{pos}, i32* %{var}.i")
        l_emit(sink, "  br label %wh_{pos}")
        l_emit(sink, "wh_{pos}:")
        l_emit(sink, "  %fc{pos} = load i32, i32* %{var}.i")
        l_emit(sink, "  %fn{pos} = add i32 %fc{pos}, 1")
        l_emit(sink, "  store i32 %fn{pos}, i32* %{var}.i")
        epos = scan_skip(src, i, n)
        i = l_or(src, epos, n, sink, 1, ptxt, sigs)
        eval = l_val(1, l_arg_slot(src, epos, i, 1, n))
        if incl == 1 {
            l_emit(sink, "  %fk{pos} = icmp sle i32 %fn{pos}, {eval}")
            done = 1
        } else {
            l_emit(sink, "  %fk{pos} = icmp slt i32 %fn{pos}, {eval}")
            done = 1
        }
        l_emit(sink, "  br i1 %fk{pos}, label %wb_{pos}, label %we_{pos}")
        l_emit(sink, "wb_{pos}:")
        i = l_block(src, i, n, sink, rty, pos, 0, ptxt, 0, sigs, dv, 0)
        l_emit(sink, "we_{pos}:")
        return i
    }
    cptr = l_val(2, l_arg_slot(src, spos, send, 2, n))
    sn = ""
    c0 = scan_skip(src, spos, n)
    if byte(src, c0) == 91 {
        sn = l_lit_struct(src, scan_skip(src, c0 + 1, n), n)
    }
    is_tv = 0
    if len(sn) > 0 {
        is_tv = 1
        ptxt = concat(ptxt, concat(var, concat(":", concat(sn, ","))))
        done = 1
    }
    if l_array_elem_want(src, c0, n, ptxt, sigs) == 2 {
        is_tv = 1
    }
    if scan_is_ident_start(byte(src, c0)) {
        ce = scan_ident_end(src, c0, n)
        cnm = slice(src, c0, ce)
        if eq(l_bag_get(ptxt, cnm), "vt") {
            is_tv = 1
        }
    }
    if is_tv == 1 {
        if len(sn) == 0 {
            ptxt = concat(ptxt, concat(var, ","))
            done = 1
        }
    }
    l_emit(sink, "  %fi{pos} = alloca i32")
    l_emit(sink, "  store i32 -1, i32* %fi{pos}")
    l_emit(sink, "  %fl{pos} = call i32 @buraaq_vec_len(i8* {cptr})")
    l_emit(sink, "  br label %wh_{pos}")
    l_emit(sink, "wh_{pos}:")
    l_emit(sink, "  %fc{pos} = load i32, i32* %fi{pos}")
    l_emit(sink, "  %fn{pos} = add i32 %fc{pos}, 1")
    l_emit(sink, "  store i32 %fn{pos}, i32* %fi{pos}")
    l_emit(sink, "  %fk{pos} = icmp slt i32 %fn{pos}, %fl{pos}")
    l_emit(sink, "  br i1 %fk{pos}, label %wb_{pos}, label %we_{pos}")
    l_emit(sink, "wb_{pos}:")
    if is_tv == 1 {
        l_emit(sink, "  %fe{pos} = call i8* @buraaq_vec_get_text(i8* {cptr}, i32 %fn{pos})")
        l_emit(sink, "  store i8* %fe{pos}, i8** %{var}.p")
        done = 1
    } else {
        l_emit(sink, "  %fe{pos} = call i32 @buraaq_vec_get_int(i8* {cptr}, i32 %fn{pos})")
        l_emit(sink, "  store i32 %fe{pos}, i32* %{var}.i")
        done = 1
    }
    i = l_block(src, i, n, sink, rty, pos, 0, ptxt, 0, sigs, dv, 0)
    l_emit(sink, "we_{pos}:")
    return i
}

# Slot shape named by a type annotation: 2 text, 3 float, 4 bool, 1 integer.
# 0 means the name carries no shape the emitter models, so inference decides.
fn l_want_of_type(tn: text) -> int {
    if eq(tn, "text") {
        return 2
    }
    if eq(tn, "float") {
        return 3
    }
    if eq(tn, "f64") {
        return 3
    }
    if eq(tn, "f32") {
        return 3
    }
    if eq(tn, "bool") {
        return 4
    }
    if eq(tn, "int") {
        return 1
    }
    if eq(tn, "uint") {
        return 1
    }
    if eq(tn, "i8") {
        return 1
    }
    if eq(tn, "i16") {
        return 1
    }
    if eq(tn, "i32") {
        return 1
    }
    if eq(tn, "i64") {
        return 1
    }
    if eq(tn, "u8") {
        return 1
    }
    if eq(tn, "u16") {
        return 1
    }
    if eq(tn, "u32") {
        return 1
    }
    if eq(tn, "u64") {
        return 1
    }
    0
}

# Kind of value a statement leaves behind: 0 none, 1 int, 2 text, 3 float.
#
# l_peek_want answers 1 for a call whose signature says void, because a caller
# that wants an int is the common case. A block closing on such a call has no
# value to return, so it needs the distinction and asks here instead.
fn l_stmt_value_kind(src: text, idx: int, n: int, ptxt: text, sigs: text) -> int {
    i = scan_skip(src, idx, n)
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        j = scan_skip(src, e, n)
        if byte(src, j) == 40 {
            return l_rt(slice(src, i, e), sigs)
        }
    }
    l_peek_want(src, i, n, ptxt, sigs)
}

fn l_starts_assign(src: text, idx: int, n: int) -> int {
    i = l_skip_mut(src, idx, n)
    e = scan_ident_end(src, i, n)
    if e == i {
        return 0
    }
    j = scan_skip(src, e, n)
    if byte(src, j) == 61 {
        if byte(src, j + 1) != 61 {
            return 1
        }
    }
    0
}

# An arm of a tail `if` is the function's result, so it returns rather than
# joining. `tailret` is 1 only for an `if` written directly in a function body:
# an `if` inside a loop is control flow, and returning from it would leave the
# loop early. The arm must also end in a value of the function's own type — an
# assignment or a void call leaves nothing to return, and naming its slot is how
# this first shipped as IR clang rejected.
fn l_arm_returns(rty: int, join: int, last: int, lastp: int, lastas: int, lastvk: int, tailret: int) -> int {
    if tailret != 1 {
        return 0
    }
    if join < 1 {
        return 0
    }
    if lastas == 1 {
        return 0
    }
    if lastvk != rty {
        return 0
    }
    if rty == 1 {
        if last > 0 {
            return 1
        }
    }
    if rty == 2 {
        if lastp > 0 {
            return 1
        }
    }
    if rty == 3 {
        if last > 0 {
            return 1
        }
    }
    0
}

fn l_close_block(src: text, nsrc: int, sink: text, rty: int, wend: int, join: int, top: int, last: int, retflag: int, lastp: int, ptxt: text, sigs: text, dv: text, lastas: int, lastvk: int, tailret: int) {
    if top == 1 {
        if retflag == 0 {
            l_flush_defers(src, nsrc, dv, sink, ptxt, sigs)
            l_close_top(sink, rty, last, lastp)
        }
        done = 1
    }
    if top == 0 {
        if retflag == 0 {
            if l_arm_returns(rty, join, last, lastp, lastas, lastvk, tailret) == 1 {
                l_flush_defers(src, nsrc, dv, sink, ptxt, sigs)
                l_close_top(sink, rty, last, lastp)
                done = 1
            } else {
                l_close_join(sink, join, wend)
                done = 1
            }
        }
        done = 1
    }
    done = 1
}

# `last` is where an int result landed, `lastp` where a pointer one did.
#
# They differ. `l_block` moves `last` to the position of the last operator in the
# statement, because that is the slot an arithmetic result is written to. A call
# writes its result at the position the expression started, so returning
# `%p{last}` for something like `slice(s, 0, k + 1)` names the operator's slot
# and not the call's — a value the module never defines.
fn l_close_top(sink: text, rty: int, last: int, lastp: int) {
    if rty == 1 {
        if last > 0 {
            l_emit(sink, "  ret i32 %t{last}l")
            done = 1
        }
        if last == 0 {
            l_emit(sink, "  ret i32 0")
            done = 1
        }
        done = 1
    }
    if rty == 2 {
        if lastp > 0 {
            l_emit(sink, "  ret i8* %p{lastp}")
            done = 1
        }
        if lastp == 0 {
            l_emit(sink, "  ret i8* null")
            done = 1
        }
        done = 1
    }
    # A comparison writes its result at the position the expression started, the
    # same as a call does, so a bool tail follows `lastp` and not the operator.
    if rty == 4 {
        if lastp > 0 {
            l_emit(sink, "  ret i32 %t{lastp}c")
            done = 1
        }
        if lastp == 0 {
            l_emit(sink, "  ret i32 0")
            done = 1
        }
        done = 1
    }
    if rty == 3 {
        if last > 0 {
            l_emit(sink, "  ret double %t{last}f")
            done = 1
        }
        if last == 0 {
            l_emit(sink, "  ret double 0.0")
            done = 1
        }
        done = 1
    }
    if rty == 0 {
        l_emit(sink, "  ret void")
        done = 1
    }
    done = 1
}

fn l_close_join(sink: text, join: int, wend: int) {
    if join > 0 {
        l_emit(sink, "  br label %j_{join}")
        done = 1
    }
    if join == 0 {
        if wend > 0 {
            l_emit(sink, "  br label %wh_{wend}")
            done = 1
        }
        done = 1
    }
    done = 1
}

fn l_emit_return(src: text, i: int, n: int, sink: text, rty: int, ptxt: text, sigs: text, dv: text) -> int {
    i = scan_skip(src, i, n)
    if byte(src, i) == 125 {
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_close_top(sink, rty, 0, 0)
        return i
    }
    epos = i
    if rty == 2 {
        i = l_or(src, i, n, sink, 2, ptxt, sigs)
        rp = l_arg_slot(src, epos, i, 2, n)
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_emit(sink, "  ret i8* %p{rp}")
        done = 1
    }
    if rty == 1 {
        i = l_or(src, i, n, sink, 1, ptxt, sigs)
        rp = epos
        cal = l_is_call(src, epos, n)
        if cal == 0 {
            rp = l_plus_in(src, epos, i)
        }
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_emit(sink, "  ret i32 %t{rp}l")
        done = 1
    }
    if rty == 4 {
        i = l_or(src, i, n, sink, 1, ptxt, sigs)
        rp = l_plus_in(src, epos, i)
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_emit(sink, "  ret i32 %t{rp}c")
        done = 1
    }
    if rty == 0 {
        i = l_or(src, i, n, sink, 1, ptxt, sigs)
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_emit(sink, "  ret void")
        done = 1
    }
    if rty == 3 {
        i = l_or(src, i, n, sink, 3, ptxt, sigs)
        rp = l_arg_slot(src, epos, i, 3, n)
        l_flush_defers(src, n, dv, sink, ptxt, sigs)
        l_emit(sink, "  ret double %t{rp}f")
        done = 1
    }
    return i
}

# `base.field = expr` — evaluate the value, then store it through the struct
# pointer the local holds.
fn l_field_write(src: text, base: text, fname: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) -> int {
    sname = l_bag_get(ptxt, base)
    off = l_field_off(src, n, sname, fname)
    w = 1
    if l_field_is_text(src, n, sname, fname) {
        w = 2
    }
    vpos = scan_skip(src, idx, n)
    i = l_or(src, vpos, n, sink, w, ptxt, sigs)
    val = l_val(w, l_arg_slot(src, vpos, i, w, n))
    if off < 0 {
        # Unknown field: the value is still emitted so the block stays
        # well-formed, and the store is dropped.
        return i
    }
    l_emit(sink, "  %wb{vpos} = load i8*, i8** %{base}.p")
    l_emit(sink, "  %wg{vpos} = getelementptr i8, i8* %wb{vpos}, i32 {off}")
    if w == 2 {
        l_emit(sink, "  %wp{vpos} = bitcast i8* %wg{vpos} to i8**")
        l_emit(sink, "  store i8* {val}, i8** %wp{vpos}")
        done = 1
    } else {
        l_emit(sink, "  %wi{vpos} = bitcast i8* %wg{vpos} to i32*")
        l_emit(sink, "  store i32 {val}, i32* %wi{vpos}")
        done = 1
    }
    i
}

fn l_stmt_expr(src: text, i: int, n: int, sink: text, ptxt: text, swant: int, sigs: text) -> int {
    i = l_skip_mut(src, i, n)
    if byte(src, i) == 42 {
        rest = scan_skip(src, i + 1, n)
        if scan_is_ident_start(byte(src, rest)) {
            e2 = scan_ident_end(src, rest, n)
            j2 = scan_skip(src, e2, n)
            if byte(src, j2) == 61 {
                if byte(src, j2 + 1) != 61 {
                    nm = slice(src, rest, e2)
                    vpos = scan_skip(src, j2 + 1, n)
                    i2 = l_or(src, vpos, n, sink, 1, ptxt, sigs)
                    sp = l_plus_in(src, vpos, i2)
                    l_emit(sink, "  %ds{vpos} = load i8*, i8** %{nm}.p")
                    l_emit(sink, "  %di{vpos} = bitcast i8* %ds{vpos} to i32*")
                    l_emit(sink, "  store i32 %t{sp}l, i32* %di{vpos}")
                    return i2
                }
            }
        }
    }
    e = scan_ident_end(src, i, n)
    j = scan_skip(src, e, n)
    epos = i
    if scan_is_ident_start(byte(src, i)) {
        # `base.field = expr`. Without this the statement falls through to the
        # expression path, which reads the field and then cannot place the `=`,
        # so the module fails in clang rather than here.
        if byte(src, j) == 46 {
            fe = scan_ident_end(src, j + 1, n)
            k = scan_skip(src, fe, n)
            if byte(src, k) == 61 {
                if byte(src, k + 1) != 61 {
                    return l_field_write(src, slice(src, i, e), slice(src, j + 1, fe), k + 1, n, sink, ptxt, sigs)
                }
            }
        }
        # `xs[i] = v`. The subscript is measured without emitting anything,
        # because whether this is a read or a write is only known after it.
        if byte(src, j) == 91 {
            nxt = scan_skip(src, j + 1, n)
            be = l_bracket_end(src, j, n)
            k = scan_skip(src, be, n)
            if byte(src, k) == 61 {
                if byte(src, k + 1) != 61 {
                    if byte(src, nxt) == 93 {
                        nm = slice(src, i, e)
                        vpos = scan_skip(src, k + 1, n)
                        i2 = l_or(src, vpos, n, sink, 1, ptxt, sigs)
                        sp = l_plus_in(src, vpos, i2)
                        if l_bag_has(ptxt, nm) {
                            l_emit(sink, "  %ys{vpos} = load i8*, i8** %{nm}.p")
                            l_emit(sink, "  %yi{vpos} = bitcast i8* %ys{vpos} to i32*")
                            l_emit(sink, "  store i32 %t{sp}l, i32* %yi{vpos}")
                            done = 1
                        } elif eq(l_bag_get(ptxt, nm), "r") {
                            l_emit(sink, "  store i32 %t{sp}l, i32* %{nm}")
                            done = 1
                        } else {
                            l_emit(sink, "  store i32 %t{sp}l, i32* %{nm}.i")
                            done = 1
                        }
                        return i2
                    }
                    return l_index_write(src, slice(src, i, e), j, k + 1, n, sink, ptxt, sigs)
                }
            }
        }
        # `name: T = expr`. The annotation also names the slot shape, which is
        # more reliable than inferring it from the right-hand side.
        tw = 0
        if byte(src, j) == 58 {
            te = scan_skip_type(src, j + 1, n)
            tn = slice(src, scan_skip(src, j + 1, n), te)
            tw = l_want_of_type(tn)
            j = scan_skip(src, te, n)
        }
        if byte(src, j) == 61 {
            if byte(src, j + 1) != 61 {
                nm = slice(src, i, e)
                i = scan_skip(src, j + 1, n)
                epos = i
                # Ask l_peek_want, the same classifier reads use. A hand kept
                # list of text returning callees leaves anything missing from
                # it stored in the int slot and read back from the pointer
                # slot, which was never written. A written annotation wins.
                want = l_peek_want(src, i, n, ptxt, sigs)
                if tw > 0 {
                    want = tw
                }
                i = l_or(src, i, n, sink, want, ptxt, sigs)
                if want == 2 {
                    sp = l_arg_slot(src, epos, i, 2, n)
                    l_emit(sink, "  store i8* %p{sp}, i8** %{nm}.p")
                    done = 1
                }
                if want == 1 {
                    sp = l_plus_in(src, epos, i)
                    l_emit(sink, "  store i32 %t{sp}l, i32* %{nm}.i")
                    done = 1
                }
                if want == 4 {
                    l_emit(sink, "  store i32 %t{epos}l, i32* %{nm}.i")
                    done = 1
                }
                if want == 3 {
                    sp = l_arg_slot(src, epos, i, 3, n)
                    l_emit(sink, "  store double %t{sp}f, double* %{nm}.f")
                    done = 1
                }
                return i
            }
            done = 1
        }
        done = 1
    }
    i = l_or(src, i, n, sink, swant, ptxt, sigs)
    return i
}

fn l_block(src: text, idx: int, n: int, sink: text, rty: int, wend: int, join: int, ptxt: text, top: int, sigs: text, dv: text, tailret: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    last = 0
    lastp = 0
    lastas = 0
    lastvk = 0
    retflag = 0
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + n + n + 8 {
            break
        }
        if byte(src, i) == 125 {
            l_close_block(src, n, sink, rty, wend, join, top, last, retflag, lastp, ptxt, sigs, dv, lastas, lastvk, tailret)
            return i + 1
        }
        oldi = i
        i = l_skip_mut(src, i, n)
        kind = 0
        if scan_word_is(src, i, n, "if") {
            kind = 1
        }
        if scan_word_is(src, i, n, "while") {
            kind = 2
        }
        if scan_word_is(src, i, n, "break") {
            kind = 3
        }
        if scan_word_is(src, i, n, "return") {
            kind = 4
        }
        if scan_word_is(src, i, n, "for") {
            kind = 5
        }
        if scan_word_is(src, i, n, "match") {
            kind = 6
        }
        if scan_word_is(src, i, n, "loop") {
            kind = 7
        }
        if scan_word_is(src, i, n, "unsafe") {
            kind = 8
        }
        if scan_word_is(src, i, n, "defer") {
            kind = 9
        }
        if scan_word_is(src, i, n, "continue") {
            kind = 10
        }
        if scan_word_is(src, i, n, "raise") {
            kind = 11
        }
        if scan_word_is(src, i, n, "parallel") {
            kind = 12
        }
        if byte(src, i) == 123 {
            kind = 13
        }
        if kind == 1 {
            i = l_if(src, i, n, sink, rty, wend, ptxt, 2, sigs, dv, top)
            last = 0
            lastp = 0
            lastas = 0
            lastvk = 0
            retflag = 0
            done = 1
        }
        if kind == 2 {
            i = l_while(src, i, n, sink, rty, ptxt, sigs, dv)
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 3 {
            l_emit(sink, "  br label %we_{wend}")
            i = i + 5
            last = 0
            lastp = 0
            retflag = 1
            done = 1
        }
        if kind == 4 {
            i = l_emit_return(src, i + 6, n, sink, rty, ptxt, sigs, dv)
            last = 0
            lastp = 0
            retflag = 1
            done = 1
        }
        if kind == 5 {
            i = l_for(src, i, n, sink, rty, ptxt, sigs, dv)
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 6 {
            mpos = i
            mw = 1
            if rty == 2 {
                mw = 2
            }
            i = l_match(src, i, n, sink, rty, wend, ptxt, sigs, dv, mw)
            last = mpos
            lastp = mpos
            lastvk = mw
            retflag = 0
            done = 1
        }
        if kind == 7 {
            i = l_loop(src, i, n, sink, rty, ptxt, sigs, dv)
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 8 {
            i = l_unsafe(src, i, n, sink, rty, wend, ptxt, sigs, dv)
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 9 {
            i = scan_skip(src, i + 5, n)
            start = i
            i = l_skip_stmt(src, i, n)
            vec_push_text(dv, concat("", "{start}"))
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 10 {
            l_emit(sink, "  br label %wh_{wend}")
            i = i + 8
            last = 0
            lastp = 0
            retflag = 1
            done = 1
        }
        if kind == 0 {
            last = i
            lastp = i
            lastas = l_starts_assign(src, i, n)
            lastvk = l_stmt_value_kind(src, i, n, ptxt, sigs)
            swant = 1
            if rty == 2 {
                swant = 2
            }
            if rty == 3 {
                swant = 3
            }
            k = i
            i = l_stmt_expr(src, i, n, sink, ptxt, swant, sigs)
            last = l_plus_in(src, k, i)
            lastp = l_arg_slot(src, k, i, 2, n)
            retflag = 0
            done = 1
        }
        if kind == 11 {
            i = scan_skip(src, i + 5, n)
            epos = i
            rw = l_peek_want(src, i, n, ptxt, sigs)
            if rw == 0 {
                rw = 1
            }
            i = l_or(src, i, n, sink, rw, ptxt, sigs)
            if rw == 2 {
                aval = l_val(2, l_arg_slot(src, epos, i, 2, n))
                l_emit(sink, concat("  call void @buraaq_eprint_str_ln(i8* ", concat(aval, ")")))
                done = 1
            } else {
                aval = l_val(1, l_arg_slot(src, epos, i, 1, n))
                l_emit(sink, concat("  %em{epos} = call i8* @buraaq_i32_to_text(i32 ", concat(aval, ")")))
                l_emit(sink, "  call void @buraaq_eprint_str_ln(i8* %em{epos})")
                done = 1
            }
            l_flush_defers(src, n, dv, sink, ptxt, sigs)
            l_close_top(sink, rty, 0, 0)
            last = 0
            lastp = 0
            retflag = 1
            done = 1
        }
        if kind == 12 {
            i = scan_skip(src, i + 8, n)
            if scan_word_is(src, i, n, "for") {
                i = l_for(src, i, n, sink, rty, ptxt, sigs, dv)
            }
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        if kind == 13 {
            i = l_block(src, i, n, sink, rty, wend, join, ptxt, 0, sigs, dv, 0)
            last = 0
            lastp = 0
            retflag = 0
            done = 1
        }
        i = scan_skip(src, i, n)
        if oldi > i {
            i = oldi + 1
        }
        if i == oldi {
            i = oldi + 1
        }
    }
    return i
}

fn l_spill(sink: text, name: text, t: int) {
    l_local(sink, name)
    if t == 2 {
        l_emit(sink, "  store i8* %{name}, i8** %{name}.p")
        done = 1
    }
    if t == 1 {
        l_emit(sink, "  store i32 %{name}, i32* %{name}.i")
        done = 1
    }
    if t == 3 {
        l_emit(sink, "  store double %{name}, double* %{name}.f")
        done = 1
    }
    done = 1
}

fn l_spill_params(sink: text, pall: text, ptxt: text) {
    i = 0
    n = len(pall)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        c = byte(pall, i)
        if scan_is_ident_start(c) {
            e = scan_ident_end(pall, i, n)
            nm = slice(pall, i, e)
            t = 1
            if eq(l_bag_get(ptxt, nm), "r") {
                t = 0
                done = 1
            }
            if l_bag_has(ptxt, nm) {
                t = 2
            }
            if eq(l_bag_get(ptxt, nm), "f") {
                t = 3
                done = 1
            } elif len(l_bag_get(ptxt, nm)) > 0 {
                if eq(l_bag_get(ptxt, nm), "r") {
                    done = 1
                } else {
                    t = 2
                    done = 1
                }
            }
            if t > 0 {
                l_spill(sink, nm, t)
                done = 1
            }
            i = e
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_spawn_caps(src: text, idx: int, n: int, ptxt: text) -> text {
    bag = ","
    i = idx
    d = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif c == 123 {
            d = d + 1
            i = i + 1
        } elif c == 125 {
            d = d - 1
            if d == 0 {
                return bag
            }
            i = i + 1
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            if l_bag_has(ptxt, nm) {
                if l_bag_has(bag, nm) {
                    done = 1
                } else {
                    bag = concat(bag, concat(nm, ","))
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    bag
}

fn l_spawn_unlocks(src: text, idx: int, n: int, sink: text) {
    i = idx
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        if byte(src, i) == 125 {
            break
        }
        if scan_is_ident_start(byte(src, i)) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            j = scan_skip(src, e, n)
            if byte(src, j) == 46 {
                fe = scan_ident_end(src, j + 1, n)
                meth = slice(src, j + 1, fe)
                if eq(meth, "lock") {
                    l_emit(sink, "  %ul_{i} = load i8*, i8** %{nm}.p")
                    l_emit(sink, "  %us_{i} = getelementptr i8, i8* %ul_{i}, i32 8")
                    l_emit(sink, "  %up_{i} = bitcast i8* %us_{i} to i8**")
                    l_emit(sink, "  %um_{i} = load i8*, i8** %up_{i}")
                    l_emit(sink, "  call void @buraaq_mutex_unlock(i8* %um_{i})")
                    done = 1
                }
                i = fe
            } else {
                i = e
            }
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_caps_pack(sink: text, caps: text, pos: int) {
    i = 0
    cn = len(caps)
    slot = 1
    while i < cn {
        if scan_is_ident_start(byte(caps, i)) {
            e = scan_ident_end(caps, i, cn)
            nm = slice(caps, i, e)
            off = slot * 8
            l_emit(sink, "  %ck{pos}_{slot} = load i8*, i8** %{nm}.p")
            l_emit(sink, "  %cs{pos}_{slot} = getelementptr i8, i8* %en{pos}, i32 {off}")
            l_emit(sink, "  %cp{pos}_{slot} = bitcast i8* %cs{pos}_{slot} to i8**")
            l_emit(sink, "  store i8* %ck{pos}_{slot}, i8** %cp{pos}_{slot}")
            slot = slot + 1
            i = e
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_caps_unpack(sink: text, caps: text, pos: int) {
    i = 0
    cn = len(caps)
    slot = 1
    while i < cn {
        if scan_is_ident_start(byte(caps, i)) {
            e = scan_ident_end(caps, i, cn)
            nm = slice(caps, i, e)
            off = slot * 8
            l_emit(sink, "  %us{pos}_{slot} = getelementptr i8, i8* %env, i32 {off}")
            l_emit(sink, "  %up{pos}_{slot} = bitcast i8* %us{pos}_{slot} to i8**")
            l_emit(sink, "  %uv{pos}_{slot} = load i8*, i8** %up{pos}_{slot}")
            l_emit(sink, "  store i8* %uv{pos}_{slot}, i8** %{nm}.p")
            slot = slot + 1
            i = e
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_caps_need(sink: text, caps: text, seen: text) -> text {
    i = 0
    cn = len(caps)
    out = seen
    while i < cn {
        if scan_is_ident_start(byte(caps, i)) {
            e = scan_ident_end(caps, i, cn)
            out = l_need_local(sink, out, slice(caps, i, e))
            i = e
        } else {
            i = i + 1
        }
    }
    out
}

fn l_emit_one_spawn(src: text, pos: int, brace: int, n: int, sink: text, ptxt: text, sigs: text) {
    end = l_skip_braced(src, brace, n)
    caps = l_spawn_caps(src, brace, end, ptxt)
    l_emit(sink, concat("define void @bq_sp_{pos}(i8* %env) ", l_open(src, n)))
    l_emit(sink, "entry:")
    seen = set_new()
    seen = l_caps_need(sink, caps, seen)
    seen = l_prescan(src, brace, n, sink, seen)
    l_caps_unpack(sink, caps, pos)
    inner = scan_skip(src, brace + 1, n)
    after = l_skip_stmt(src, inner, n)
    after = scan_skip(src, after, n)
    if byte(src, after) == 125 {
        ww = l_peek_want(src, inner, n, ptxt, sigs)
        if ww == 0 {
            ww = 1
        }
        i = l_or(src, inner, n, sink, ww, ptxt, sigs)
        ip = l_arg_slot(src, inner, i, ww, n)
        if ww == 2 {
            l_emit(sink, "  %rr{pos} = bitcast i8* %env to i8**")
            l_emit(sink, "  store i8* %p{ip}, i8** %rr{pos}")
            done = 1
        } else {
            l_emit(sink, "  %ri{pos} = bitcast i8* %env to i32*")
            l_emit(sink, "  store i32 %t{ip}l, i32* %ri{pos}")
            done = 1
        }
        done = 1
    } else {
        dv = vec_new()
        i = l_block(src, brace, n, sink, 0, 0, 0, ptxt, 0, sigs, dv, 0)
        vec_free(dv)
        done = 1
    }
    l_spawn_unlocks(src, brace, end, sink)
    l_emit(sink, "  ret void")
    l_emit(sink, l_close(src, n))
    done = 1
}

fn l_emit_spawn_fns(src: text, idx: int, n: int, sink: text, ptxt: text, sigs: text) {
    i = idx
    d = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif c == 123 {
            d = d + 1
            i = i + 1
        } elif c == 125 {
            d = d - 1
            if d == 0 {
                return
            }
            i = i + 1
        } elif scan_word_is(src, i, n, "spawn") {
            pos = i
            i = scan_skip(src, i + 5, n)
            if scan_word_is(src, i, n, "async") {
                i = scan_skip(src, i + 5, n)
            }
            if byte(src, i) == 123 {
                l_emit_one_spawn(src, pos, i, n, sink, ptxt, sigs)
                i = l_skip_braced(src, i, n)
            }
        } elif scan_word_is(src, i, n, "spawn_task") {
            pos = i
            i = scan_skip(src, i + 10, n)
            if scan_word_is(src, i, n, "async") {
                i = scan_skip(src, i + 5, n)
            }
            if byte(src, i) == 123 {
                l_emit_one_spawn(src, pos, i, n, sink, ptxt, sigs)
                i = l_skip_braced(src, i, n)
            }
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_fn_generic(src: text, idx: int, n: int) -> int {
    i = idx
    hops = 0
    while hops < 6 {
        hops = hops + 1
        if scan_word_is(src, i, n, "pub") {
            i = scan_skip(src, i + 3, n)
        } elif scan_word_is(src, i, n, "async") {
            i = scan_skip(src, i + 5, n)
        } elif scan_word_is(src, i, n, "unsafe") {
            i = scan_skip(src, i + 6, n)
        } else {
            break
        }
    }
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "fn") {
        i = scan_skip(src, i + 2, n)
    }
    e = scan_ident_end(src, i, n)
    i = scan_skip(src, e, n)
    if byte(src, i) == 91 {
        return 1
    }
    0
}

fn l_fn_name_at(src: text, idx: int, n: int) -> text {
    i = idx
    hops = 0
    while hops < 6 {
        hops = hops + 1
        if scan_word_is(src, i, n, "pub") {
            i = scan_skip(src, i + 3, n)
        } elif scan_word_is(src, i, n, "async") {
            i = scan_skip(src, i + 5, n)
        } elif scan_word_is(src, i, n, "unsafe") {
            i = scan_skip(src, i + 6, n)
        } else {
            break
        }
    }
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "fn") {
        i = scan_skip(src, i + 2, n)
    }
    e = scan_ident_end(src, i, n)
    slice(src, i, e)
}

fn l_assign_struct(src: text, n: int, lname: text) -> text {
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            j = scan_skip(src, e, n)
            if eq(nm, lname) {
                if byte(src, j) == 61 {
                    j = scan_skip(src, j + 1, n)
                    if scan_is_ident_start(byte(src, j)) {
                        se = scan_ident_end(src, j, n)
                        sn = slice(src, j, se)
                        j = scan_skip(src, se, n)
                        if byte(src, j) == 123 {
                            if l_struct_body(src, n, sn) >= 0 {
                                return sn
                            }
                        }
                    }
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    ""
}

fn l_gcall_structs(src: text, n: int, fname: text) -> text {
    bag = ","
    i = 0
    while i < n {
        c = byte(src, i)
        if c == 35 {
            i = l_skip_line(src, i, n)
        } elif c == 34 {
            i = i + 1
            while i < n {
                if byte(src, i) == 34 {
                    i = i + 1
                    break
                }
                i = l_str_skip_esc(src, i, n)
            }
        } elif scan_is_ident_start(c) {
            e = scan_ident_end(src, i, n)
            nm = slice(src, i, e)
            j = scan_skip(src, e, n)
            if eq(nm, fname) {
                if byte(src, j) == 40 {
                    j = scan_skip(src, j + 1, n)
                    if scan_is_ident_start(byte(src, j)) {
                        ae = scan_ident_end(src, j, n)
                        an = slice(src, j, ae)
                        j = scan_skip(src, ae, n)
                        if byte(src, j) == 44 {
                            st = l_assign_struct(src, n, an)
                            if len(st) > 0 {
                                if l_bag_has(bag, st) {
                                    done = 1
                                } else {
                                    bag = concat(bag, concat(st, ","))
                                }
                            }
                        } elif byte(src, j) == 41 {
                            st = l_assign_struct(src, n, an)
                            if len(st) > 0 {
                                if l_bag_has(bag, st) {
                                    done = 1
                                } else {
                                    bag = concat(bag, concat(st, ","))
                                }
                            }
                        }
                    }
                }
            }
            i = e
        } else {
            i = i + 1
        }
    }
    bag
}

fn l_fn(src: text, idx: int, n: int, sink: text, sigs: text, sname: text) -> int {
    i = l_fn_one(src, idx, n, sink, sigs, sname, 0, "")
    if l_fn_generic(src, idx, n) == 1 {
        if len(sname) == 0 {
            l_fn_one(src, idx, n, sink, sigs, sname, 1, "")
            l_fn_one(src, idx, n, sink, sigs, sname, 2, "")
            fname = l_fn_name_at(src, idx, n)
            sts = l_gcall_structs(src, n, fname)
            k = 0
            hn = len(sts)
            while k < hn {
                if scan_is_ident_start(byte(sts, k)) {
                    e = scan_ident_end(sts, k, hn)
                    st = slice(sts, k, e)
                    if len(st) > 0 {
                        l_fn_one(src, idx, n, sink, sigs, sname, 3, st)
                        done = 1
                    }
                    k = e
                } else {
                    k = k + 1
                }
            }
            done = 1
        }
    }
    i
}

fn l_fn_one(src: text, idx: int, n: int, sink: text, sigs: text, sname: text, spec: int, stype: text) -> int {
    i = idx
    hops = 0
    while hops < 6 {
        hops = hops + 1
        if scan_word_is(src, i, n, "pub") {
            i = scan_skip(src, i + 3, n)
        } elif scan_word_is(src, i, n, "async") {
            i = scan_skip(src, i + 5, n)
        } elif scan_word_is(src, i, n, "unsafe") {
            i = scan_skip(src, i + 6, n)
        } else {
            break
        }
    }
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "fn") {
        i = scan_skip(src, i + 2, n)
    }
    e = scan_ident_end(src, i, n)
    fname = slice(src, i, e)
    i = scan_skip(src, e, n)
    gnames = ","
    if byte(src, i) == 91 {
        i = i + 1
        while i < n {
            i = scan_skip(src, i, n)
            if byte(src, i) == 93 {
                i = i + 1
                break
            }
            if scan_is_ident_start(byte(src, i)) {
                ge = scan_ident_end(src, i, n)
                gnames = concat(gnames, concat(slice(src, i, ge), ","))
                i = ge
            } else {
                i = i + 1
            }
        }
        i = scan_skip(src, i, n)
    }
    if byte(src, i) == 40 {
        i = i + 1
    }
    ptxt = ","
    pall = ","
    plist = ""
    np = 0
    i = scan_skip(src, i, n)
    while i < n {
        if byte(src, i) == 41 {
            i = i + 1
            break
        }
        isref = 0
        if scan_word_is(src, i, n, "ref") {
            isref = 1
        }
        i = l_skip_mut(src, i, n)
        e = scan_ident_end(src, i, n)
        if e == i {
            i = i + 1
        } else {
            pname = slice(src, i, e)
            pall = concat(pall, concat(pname, ","))
            i = scan_skip(src, e, n)
            pty = "i32"
            if isref == 1 {
                pty = "i32*"
                ptxt = concat(ptxt, concat(pname, ":r,"))
                done = 1
            }
            if eq(pname, "self") {
                pty = "i8*"
                if len(sname) > 0 {
                    ptxt = concat(ptxt, concat("self:", concat(sname, ",")))
                    done = 1
                } else {
                    ptxt = concat(ptxt, "self,")
                    done = 1
                }
                done = 1
            }
            if byte(src, i) == 58 {
                i = scan_skip(src, i + 1, n)
                if scan_word_is(src, i, n, "dyn") {
                    i = scan_skip(src, i + 3, n)
                    pty = "i8*"
                    ptxt = concat(ptxt, concat(pname, ":d,"))
                    i = scan_skip_type(src, i, n)
                    done = 1
                } elif byte(src, i) == 42 {
                    pty = "i8*"
                    ptxt = concat(ptxt, concat(pname, ","))
                    i = scan_skip_type(src, i, n)
                    done = 1
                } else {
                    t0 = i
                    te = scan_ident_end(src, i, n)
                    i = scan_skip_type(src, i, n)
                    if eq(slice(src, t0, te), "text") {
                        pty = "i8*"
                        ptxt = concat(ptxt, concat(pname, ","))
                    } elif l_bag_has(gnames, slice(src, t0, te)) {
                        if spec == 1 {
                            pty = "i8*"
                            ptxt = concat(ptxt, concat(pname, ","))
                            done = 1
                        } elif spec == 2 {
                            pty = "double"
                            ptxt = concat(ptxt, concat(pname, ":f,"))
                            done = 1
                        } elif spec == 3 {
                            pty = "i8*"
                            ptxt = concat(ptxt, concat(pname, concat(":", concat(stype, ","))))
                            done = 1
                        }
                    } elif eq(slice(src, t0, te), "dyn") {
                        pty = "i8*"
                        ptxt = concat(ptxt, concat(pname, ":d,"))
                        done = 1
                    } elif l_struct_body(src, n, slice(src, t0, te)) >= 0 {
                        pty = "i8*"
                        ptxt = concat(ptxt, concat(pname, concat(":", concat(slice(src, t0, te), ","))))
                        done = 1
                    } elif l_type_is_ptr(src, n, slice(src, t0, te)) {
                        pty = "i8*"
                        ptxt = concat(ptxt, concat(pname, ","))
                        done = 1
                    }
                    done = 1
                }
                done = 1
            }
            piece = concat(pty, concat(" %", pname))
            if np == 0 {
                plist = piece
                done = 1
            }
            if np > 0 {
                plist = concat(plist, concat(", ", piece))
                done = 1
            }
            np = np + 1
            i = scan_skip(src, i, n)
            if byte(src, i) == 44 {
                i = scan_skip(src, i + 1, n)
            }
            done = 1
        }
    }
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "throws") {
        i = scan_skip(src, i + 6, n)
        i = scan_skip_type(src, i, n)
        i = scan_skip(src, i, n)
    }
    rty = 0
    rtyt = "void"
    if byte(src, i) == 45 {
        if byte(src, i + 1) == 62 {
            i = scan_skip(src, i + 2, n)
            t0 = i
            te = scan_ident_end(src, i, n)
            i = scan_skip_type(src, i, n)
            if eq(slice(src, t0, te), "text") {
                rty = 2
                rtyt = "i8*"
                done = 1
            }
            if eq(slice(src, t0, te), "bool") {
                rty = 4
                rtyt = "i32"
                done = 1
            }
            if eq(slice(src, t0, te), "int") {
                rty = 1
                rtyt = "i32"
                done = 1
            }
            if eq(slice(src, t0, te), "Option") {
                rty = 2
                rtyt = "i8*"
                done = 1
            }
            if eq(slice(src, t0, te), "Result") {
                rty = 2
                rtyt = "i8*"
                done = 1
            }
            if spec == 1 {
                if l_bag_has(gnames, slice(src, t0, te)) {
                    rty = 2
                    rtyt = "i8*"
                    done = 1
                }
            }
            if spec == 2 {
                if l_bag_has(gnames, slice(src, t0, te)) {
                    rty = 3
                    rtyt = "double"
                    done = 1
                }
            }
            if spec == 3 {
                if l_bag_has(gnames, slice(src, t0, te)) {
                    rty = 2
                    rtyt = "i8*"
                    done = 1
                }
            }
            if rty == 0 {
                rty = 1
                rtyt = "i32"
                done = 1
            }
            done = 1
        }
        done = 1
    }
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "where") {
        i = scan_skip(src, i + 5, n)
        while i < n {
            if byte(src, i) == 123 {
                break
            }
            i = i + 1
        }
    }
    is_main = 0
    iname = fname
    if eq(fname, "main") {
        is_main = 1
        iname = "buraaq_main"
        rty = 0
        rtyt = "void"
    } elif spec == 1 {
        iname = concat(fname, "__text")
        done = 1
    } elif spec == 2 {
        iname = concat(fname, "__float")
        done = 1
    } elif spec == 3 {
        iname = concat(fname, concat("__", stype))
        done = 1
    } elif len(sname) > 0 {
        iname = concat(sname, concat("_", fname))
        done = 1
    }
    done = 1
    bodyi = scan_skip(src, i, n)
    ptxt_sp = l_text_locals(src, bodyi, n, ptxt, sigs)
    l_emit_spawn_fns(src, bodyi, n, sink, ptxt_sp, sigs)
    def = concat("define {rtyt} @{iname}({plist}) ", l_open(src, n))
    l_emit(sink, def)
    l_emit(sink, "entry:")
    l_spill_params(sink, pall, ptxt)
    i = scan_skip(src, i, n)
    seen = l_seed_locals(sink, pall)
    seen = l_spill_consts(sink, seen, src, n)
    l_prescan(src, i, n, sink, seen)
    ptxt = l_text_locals(src, i, n, ptxt, sigs)
    if rty == 2 {
        ptxt = concat(ptxt, ":?p,")
        done = 1
    } elif rty == 1 {
        ptxt = concat(ptxt, ":?i,")
        done = 1
    } elif rty == 4 {
        ptxt = concat(ptxt, ":?i,")
        done = 1
    } elif rty == 3 {
        ptxt = concat(ptxt, ":?f,")
        done = 1
    } else {
        ptxt = concat(ptxt, ":?v,")
        done = 1
    }
    dv = vec_new()
    i = l_block(src, i, n, sink, rty, 0, 0, ptxt, 1, sigs, dv, 0)
    vec_free(dv)
    l_emit(sink, l_close(src, n))
    if is_main == 1 {
        l_emit(sink, concat("define i32 @main(i32 %argc, i8** %argv) ", l_open(src, n)))
        l_emit(sink, "entry:")
        l_emit(sink, "  call void @buraaq_rt_set_args(i32 %argc, i8** %argv)")
        l_emit(sink, "  call void @buraaq_main()")
        l_emit(sink, "  ret i32 0")
        l_emit(sink, l_close(src, n))
    }
    return i
}

fn l_emit_strings(src: text, n: int, sink: text) {
    q = l_quote(src, n)
    i = 0
    while i < n {
        if byte(src, i) == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        } elif byte(src, i) == 34 {
            i = i + 1
            s = i
            while i < n {
                if byte(src, i) == 34 {
                    if s <= i {
                        l_intern_span(src, s, i, sink, q)
                    }
                    i = i + 1
                    break
                }
                if byte(src, i) == 123 {
                    if s < i {
                        l_intern_span(src, s, i, sink, q)
                    }
                    j = i + 1
                    closed = 0
                    while j < n {
                        if byte(src, j) == 125 {
                            i = j + 1
                            s = i
                            closed = 1
                            break
                        }
                        j = j + 1
                    }
                    # An unterminated interpolation is the whole rest of the
                    # file. Leaving `i` on the brace spun this loop forever on
                    # a three byte input.
                    if closed == 0 {
                        i = n
                        s = n
                    }
                } else {
                    i = l_str_skip_esc(src, i, n)
                }
            }
        } else {
            i = i + 1
        }
    }
    done = 1
}

fn l_emit_struct_fns(src: text, idx: int, n: int, sink: text, sigs: text) -> int {
    i = scan_skip(src, idx + 6, n)
    e = scan_ident_end(src, i, n)
    sname = slice(src, i, e)
    i = scan_skip(src, e, n)
    if byte(src, i) == 91 {
        i = l_bracket_end(src, i, n)
        i = scan_skip(src, i, n)
    }
    if byte(src, i) == 123 {
        i = i + 1
    }
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 125 {
            return i + 1
        }
        if scan_word_is(src, i, n, "fn") {
            i = l_fn(src, i, n, sink, sigs, sname)
        } elif scan_word_is(src, i, n, "drop") {
            i = l_skip_braced(src, i, n)
        } elif scan_is_ident_start(byte(src, i)) {
            i = scan_ident_end(src, i, n)
            i = scan_skip(src, i, n)
            if byte(src, i) == 58 {
                i = scan_skip_type(src, i + 1, n)
            }
        } else {
            i = i + 1
        }
    }
    i
}

fn l_c_type(tn: text) -> text {
    if eq(tn, "text") {
        return "i8*"
    }
    if eq(tn, "void") {
        return "void"
    }
    if eq(tn, "float") {
        return "double"
    }
    if eq(tn, "f64") {
        return "double"
    }
    "i32"
}

fn l_emit_extern(src: text, idx: int, n: int, sink: text) -> int {
    i = scan_skip(src, idx + 6, n)
    if scan_word_is(src, i, n, "c") {
        i = scan_skip(src, i + 1, n)
    }
    if byte(src, i) == 123 {
        i = i + 1
    }
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 8 {
            break
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 125 {
            return i + 1
        }
        if scan_word_is(src, i, n, "fn") {
            i = scan_skip(src, i + 2, n)
            e = scan_ident_end(src, i, n)
            fname = slice(src, i, e)
            i = scan_skip(src, e, n)
            if byte(src, i) == 40 {
                i = i + 1
            }
            plist = ""
            np = 0
            i = scan_skip(src, i, n)
            phops = 0
            while i < n {
                phops = phops + 1
                if phops > 64 {
                    break
                }
                if byte(src, i) == 41 {
                    i = i + 1
                    break
                }
                # `...` is LLVM varargs. A lone `.` is not a parameter name, so
                # the old loop never moved `i` and concat'd `, i32` until RAM died.
                if byte(src, i) == 46 {
                    if byte(src, i + 1) == 46 {
                        if byte(src, i + 2) == 46 {
                            if np == 0 {
                                plist = "..."
                                done = 1
                            }
                            if np > 0 {
                                plist = concat(plist, ", ...")
                                done = 1
                            }
                            np = np + 1
                            i = scan_skip(src, i + 3, n)
                            if byte(src, i) == 44 {
                                i = scan_skip(src, i + 1, n)
                            }
                            continue
                        }
                    }
                    i = i + 1
                    continue
                }
                i = l_skip_mut(src, i, n)
                if scan_is_ident_start(byte(src, i)) {
                    i = scan_ident_end(src, i, n)
                    i = scan_skip(src, i, n)
                }
                pty = "i32"
                if byte(src, i) == 58 {
                    i = scan_skip(src, i + 1, n)
                    if scan_word_is(src, i, n, "c") {
                        i = scan_skip(src, i + 1, n)
                        if byte(src, i) == 46 {
                            i = i + 1
                        }
                    }
                    te = scan_ident_end(src, i, n)
                    pty = l_c_type(slice(src, i, te))
                    i = scan_skip_type(src, i, n)
                }
                if np == 0 {
                    plist = pty
                    done = 1
                }
                if np > 0 {
                    plist = concat(plist, concat(", ", pty))
                    done = 1
                }
                np = np + 1
                i = scan_skip(src, i, n)
                if byte(src, i) == 44 {
                    i = scan_skip(src, i + 1, n)
                }
            }
            i = scan_skip(src, i, n)
            rtyt = "i32"
            if byte(src, i) == 45 {
                if byte(src, i + 1) == 62 {
                    i = scan_skip(src, i + 2, n)
                    if scan_word_is(src, i, n, "c") {
                        i = scan_skip(src, i + 1, n)
                        if byte(src, i) == 46 {
                            i = i + 1
                        }
                    }
                    te = scan_ident_end(src, i, n)
                    rtyt = l_c_type(slice(src, i, te))
                    i = scan_skip_type(src, i, n)
                }
            }
            if eq(fname, "printf") {
                done = 1
            } elif len(fname) >= 7 {
                if eq(slice(fname, 0, 7), "buraaq_") {
                    # Runtime symbols are declared once in ll_emit_module; skip
                    # duplicates from each module's extern c { } block (fixpoint link).
                    done = 1
                } else {
                    l_emit(sink, "declare {rtyt} @{fname}({plist})")
                    done = 1
                }
            } else {
                l_emit(sink, "declare {rtyt} @{fname}({plist})")
                done = 1
            }
        } else {
            i = i + 1
        }
    }
    i
}

fn l_skip_src(src: text, i: int, n: int) -> int {
    c = byte(src, i)
    if c == 35 {
        return l_skip_line(src, i, n)
    }
    if c == 34 {
        i = i + 1
        while i < n {
            if byte(src, i) == 34 {
                return i + 1
            }
            i = l_str_skip_esc(src, i, n)
        }
        return i
    }
    i
}

fn l_trait_meth_idx(src: text, n: int, meth: text) -> int {
    i = 0
    idx = 0
    while i < n {
        nx = l_skip_src(src, i, n)
        if nx != i {
            i = nx
        } elif scan_word_is(src, i, n, "trait") {
            i = scan_skip(src, i + 5, n)
            i = scan_ident_end(src, i, n)
            i = scan_skip(src, i, n)
            if byte(src, i) == 123 {
                i = i + 1
            }
            slot = 0
            hops = 0
            while i < n {
                hops = hops + 1
                if hops > n {
                    break
                }
                i = scan_skip(src, i, n)
                if byte(src, i) == 125 {
                    i = i + 1
                    break
                }
                if scan_word_is(src, i, n, "fn") {
                    i = scan_skip(src, i + 2, n)
                    e = scan_ident_end(src, i, n)
                    nm = slice(src, i, e)
                    if eq(nm, meth) {
                        idx = slot
                    }
                    slot = slot + 1
                    i = e
                    while i < n {
                        if byte(src, i) == 125 {
                            break
                        }
                        if scan_word_is(src, i, n, "fn") {
                            break
                        }
                        if byte(src, i) == 123 {
                            i = l_skip_braced(src, i, n)
                            break
                        }
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            }
        } elif scan_is_ident_start(byte(src, i)) {
            i = scan_ident_end(src, i, n)
        } else {
            i = i + 1
        }
    }
    idx
}

fn l_emit_vtables(src: text, n: int, sink: text, sigs: text) {
    i = 0
    while i < n {
        nx = l_skip_src(src, i, n)
        if nx != i {
            i = nx
        } elif scan_word_is(src, i, n, "impl") {
            i = scan_skip(src, i + 4, n)
            tname = ""
            sname = ""
            if scan_is_ident_start(byte(src, i)) {
                e = scan_ident_end(src, i, n)
                tname = slice(src, i, e)
                sname = tname
                i = e
            }
            i = scan_skip(src, i, n)
            if scan_word_is(src, i, n, "for") {
                i = scan_skip(src, i + 3, n)
                if scan_is_ident_start(byte(src, i)) {
                    e = scan_ident_end(src, i, n)
                    sname = slice(src, i, e)
                    i = e
                }
            } else {
                tname = ""
            }
            if len(tname) > 0 {
                if len(sname) > 0 {
                    l_emit(sink, concat("@vt_", concat(sname, concat("_", concat(tname, " = private unnamed_addr constant [4 x i8*] [")))))
                    slot = 0
                    ti = 0
                    while ti < n {
                        tnx = l_skip_src(src, ti, n)
                        if tnx != ti {
                            ti = tnx
                        } elif scan_word_is(src, ti, n, "trait") {
                            ti = scan_skip(src, ti + 5, n)
                            te = scan_ident_end(src, ti, n)
                            tn = slice(src, ti, te)
                            ti = scan_skip(src, te, n)
                            if eq(tn, tname) {
                                if byte(src, ti) == 123 {
                                    ti = ti + 1
                                }
                                hops2 = 0
                                while ti < n {
                                    hops2 = hops2 + 1
                                    if hops2 > n {
                                        break
                                    }
                                    ti = scan_skip(src, ti, n)
                                    if byte(src, ti) == 125 {
                                        ti = ti + 1
                                        break
                                    }
                                    if scan_word_is(src, ti, n, "fn") {
                                        ti = scan_skip(src, ti + 2, n)
                                        me = scan_ident_end(src, ti, n)
                                        meth = slice(src, ti, me)
                                        cal = concat(sname, concat("_", meth))
                                        rt = l_rt(meth, sigs)
                                        if slot > 0 {
                                            l_emit(sink, ",")
                                        }
                                        if rt == 2 {
                                            l_emit(sink, concat("i8* bitcast (i8* (i8*)* @", concat(cal, " to i8*)")))
                                        } elif rt == 0 {
                                            l_emit(sink, concat("i8* bitcast (void (i8*)* @", concat(cal, " to i8*)")))
                                        } else {
                                            l_emit(sink, concat("i8* bitcast (i32 (i8*)* @", concat(cal, " to i8*)")))
                                        }
                                        slot = slot + 1
                                        ti = me
                                        while ti < n {
                                            if byte(src, ti) == 125 {
                                                break
                                            }
                                            if scan_word_is(src, ti, n, "fn") {
                                                break
                                            }
                                            if byte(src, ti) == 123 {
                                                ti = l_skip_braced(src, ti, n)
                                                break
                                            }
                                            ti = ti + 1
                                        }
                                    } else {
                                        ti = ti + 1
                                    }
                                }
                                break
                            }
                            ti = te
                        } elif scan_is_ident_start(byte(src, ti)) {
                            ti = scan_ident_end(src, ti, n)
                        } else {
                            ti = ti + 1
                        }
                    }
                    while slot < 4 {
                        if slot > 0 {
                            l_emit(sink, ",")
                        }
                        l_emit(sink, "i8* null")
                        slot = slot + 1
                    }
                    l_emit(sink, "]")
                }
            }
        } elif scan_is_ident_start(byte(src, i)) {
            i = scan_ident_end(src, i, n)
        } else {
            i = i + 1
        }
    }
}

fn ll_emit_module(path: text, sink: text) {
    src = l_unit(path)
    n = len(src)
    sigs = l_collect_sigs(src, n, ",")
    sigs = l_collect_dyn(src, n, sigs)
    sigs = concat(sigs, l_builtin_sigs())
    l_emit(sink, "; buraaq-boot llvm")
    l_emit(sink, "declare void @buraaq_print_i32(i32)")
    l_emit(sink, "declare void @buraaq_print_i32_ln(i32)")
    l_emit(sink, "declare void @buraaq_print_str(i8*)")
    l_emit(sink, "declare void @buraaq_print_str_ln(i8*)")
    l_emit(sink, "declare void @buraaq_print_f64(double)")
    l_emit(sink, "declare void @buraaq_print_f64_ln(double)")
    l_emit(sink, "declare void @buraaq_print_bool(i32)")
    l_emit(sink, "declare void @buraaq_print_bool_ln(i32)")
    l_emit(sink, "@.sp = private unnamed_addr constant [2 x i8] [i8 32, i8 0]")
    l_emit(sink, "@.z = private unnamed_addr constant [1 x i8] [i8 0]")
    l_emit(sink, "@.true = private unnamed_addr constant [5 x i8] [i8 116, i8 114, i8 117, i8 101, i8 0]")
    l_emit(sink, "@.false = private unnamed_addr constant [6 x i8] [i8 102, i8 97, i8 108, i8 115, i8 101, i8 0]")
    l_emit(sink, "declare i8* @buraaq_file_read(i8*)")
    l_emit(sink, "declare i32 @buraaq_file_write(i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_file_append(i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_text_len(i8*)")
    l_emit(sink, "declare i32 @buraaq_text_byte(i8*, i32)")
    l_emit(sink, "declare i32 @buraaq_text_eq(i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_text_lt(i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_json_path_int(i8*, i8*)")
    l_emit(sink, "declare i8* @buraaq_json_path_text(i8*, i8*)")
    l_emit(sink, "declare i8* @buraaq_lsp_read()")
    l_emit(sink, "declare void @buraaq_lsp_write(i8*)")
    l_emit(sink, "declare i32 @buraaq_bur_pack(i8*, i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_bur_launch(i8*)")
    l_emit(sink, "declare i32 @buraaq_http_put_file(i8*, i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_dock_run(i32)")
    l_emit(sink, "declare i32 @buraaq_index_run(i8*)")
    l_emit(sink, "declare i8* @buraaq_text_slice(i8*, i32, i32)")
    l_emit(sink, "declare i8* @buraaq_text_concat(i8*, i8*)")
    l_emit(sink, "declare i8* @buraaq_i32_to_text(i32)")
    l_emit(sink, "declare i8* @buraaq_f64_to_text(double)")
    l_emit(sink, "declare i8* @buraaq_os_argv(i32)")
    l_emit(sink, "declare i32 @buraaq_os_argc()")
    l_emit(sink, "declare i8* @buraaq_os_getenv(i8*)")
    l_emit(sink, "declare i32 @buraaq_file_exists(i8*)")
    l_emit(sink, "declare i32 @buraaq_mkdir(i8*)")
    l_emit(sink, "declare i32 @buraaq_chdir(i8*)")
    l_emit(sink, "declare i32 @buraaq_argv_new()")
    l_emit(sink, "declare i32 @buraaq_argv_push(i32, i8*)")
    l_emit(sink, "declare i32 @buraaq_process_run(i32)")
    l_emit(sink, "declare void @buraaq_argv_free(i32)")
    l_emit(sink, "declare void @buraaq_rt_set_args(i32, i8**)")
    l_emit(sink, "declare void @buraaq_eprint_str_ln(i8*)")
    l_emit(sink, "declare void @buraaq_exit(i32)")
    l_emit(sink, "declare i8* @buraaq_obj_new(i32)")
    l_emit(sink, "declare i8* @buraaq_mutex_new()")
    l_emit(sink, "declare void @buraaq_mutex_lock(i8*)")
    l_emit(sink, "declare void @buraaq_mutex_unlock(i8*)")
    l_emit(sink, "declare i8* @buraaq_thread_spawn(i8*, i8*)")
    l_emit(sink, "declare void @buraaq_thread_join(i8*)")
    l_emit(sink, "declare i8* @buraaq_chan_new(i32)")
    l_emit(sink, "declare i32 @buraaq_chan_send(i8*, i32)")
    l_emit(sink, "declare i32 @buraaq_chan_recv(i8*)")
    l_emit(sink, "declare i8* @buraaq_async_io_read_line()")
