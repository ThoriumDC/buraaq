    l_emit(sink, "declare i32 @buraaq_hold_keep(i32, i8*, i8*)")
    l_emit(sink, "declare i32 @buraaq_stream_bind(i32)")
    l_emit(sink, "declare i32 @buraaq_stream_hail()")
    l_emit(sink, "declare i32 @buraaq_stream_wire(i8*)")
    l_emit(sink, "declare i32 @buraaq_stream_say(i32, i8*)")
    l_emit(sink, "declare i8* @buraaq_stream_hear(i32)")
    l_emit(sink, "declare void @buraaq_stream_hangup(i32)")
    l_emit(sink, "declare void @buraaq_stream_run()")
    l_emit(sink, "declare i32 @buraaq_stream_clip(i32, i8*)")
    l_emit(sink, "declare i32 @buraaq_stream_shot(i32, i8*)")
    l_emit(sink, "declare i8* @buraaq_stream_heard()")
    l_emit(sink, "declare i32 @buraaq_gfx_canvas(i32, i32, i8*)")
    l_emit(sink, "declare void @buraaq_gfx_ink(i32, i32, i32)")
    l_emit(sink, "declare void @buraaq_gfx_wipe()")
    l_emit(sink, "declare void @buraaq_gfx_plot(i32, i32)")
    l_emit(sink, "declare void @buraaq_gfx_box(i32, i32, i32, i32)")
    l_emit(sink, "declare void @buraaq_gfx_dash(i32, i32, i32, i32)")
    l_emit(sink, "declare void @buraaq_gfx_flip()")
    l_emit(sink, "declare i32 @buraaq_gfx_held(i8*)")
    l_emit(sink, "declare i32 @buraaq_gfx_pulse()")
    l_emit(sink, "declare void @buraaq_gfx_play(i8*)")
    l_emit(sink, "declare void @buraaq_gfx_tone(i32, i32)")
    l_emit(sink, "declare void @buraaq_gfx_hush()")
    l_emit(sink, "declare i32 @buraaq_pg_connect(i8*)")
    l_emit(sink, "declare i32 @buraaq_ui_show()")
    l_emit_strings(src, n, sink)
    i = scan_skip(src, 0, n)
    steps = 0
    while i < n {
        steps = steps + 1
        if steps > n + n + n + 8 {
            break
        }
        old = i
        if scan_word_is(src, i, n, "struct") {
            i = l_emit_struct_fns(src, i, n, sink, sigs)
        } elif scan_word_is(src, i, n, "enum") {
            # Same: a variant is looked up in `src` wherever it is named.
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "trait") {
            i = l_skip_braced(src, i, n)
        } elif scan_word_is(src, i, n, "impl") {
            i = scan_skip(src, i + 4, n)
            iname = ""
            if scan_is_ident_start(byte(src, i)) {
                e = scan_ident_end(src, i, n)
                iname = slice(src, i, e)
                i = e
            }
            i = scan_skip(src, i, n)
            if scan_word_is(src, i, n, "for") {
                i = scan_skip(src, i + 3, n)
                if scan_is_ident_start(byte(src, i)) {
                    e = scan_ident_end(src, i, n)
                    iname = slice(src, i, e)
                    i = e
                }
                i = scan_skip(src, i, n)
            }
            if byte(src, i) == 123 {
                i = i + 1
            }
            hops2 = 0
            while i < n {
                hops2 = hops2 + 1
                if hops2 > n + 8 {
                    break
                }
                i = scan_skip(src, i, n)
                if byte(src, i) == 125 {
                    i = i + 1
                    break
                }
                if scan_word_is(src, i, n, "fn") {
                    i = l_fn(src, i, n, sink, sigs, iname)
                } else {
                    i = i + 1
                }
            }
        } elif scan_word_is(src, i, n, "async") {
            i = scan_skip(src, i + 5, n)
        } elif scan_word_is(src, i, n, "pub") {
            i = l_fn(src, i, n, sink, sigs, "")
        } elif scan_word_is(src, i, n, "fn") {
            i = l_fn(src, i, n, sink, sigs, "")
        } elif scan_word_is(src, i, n, "use") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "import") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "module") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "const") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "static") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "type") {
            i = l_skip_line(src, i, n)
        } elif scan_word_is(src, i, n, "extern") {
            i = l_emit_extern(src, i, n, sink)
        } else {
            i = i + 1
        }
        if old > i {
            i = old + 1
        }
        if i == old {
            i = old + 1
        }
        i = scan_skip(src, i, n)
    }
    l_emit_vtables(src, n, sink, sigs)
    done = 1
}

pub fn dump_llvm(path: text) {
    ll_emit_module(path, "-")
}

fn l_pick_file(a: text, b: text, c: text, d: text, e: text, f: text) -> text {
    if exists(a) {
        return a
    }
    if exists(b) {
        return b
    }
    if exists(c) {
        return c
    }
    if exists(d) {
        return d
    }
    if exists(e) {
        return e
    }
    if exists(f) {
        return f
    }
    ""
}

# clang: BURAAQ_CLANG, the install sidecar, a stock LLVM install, then PATH.
pub fn find_clang() -> text {
    env = getenv("BURAAQ_CLANG")
    if len(env) > 0 {
        if exists(env) {
            return env
        }
        done = 1
    }
    home = getenv("LOCALAPPDATA")
    sidecar = concat(home, "\\buraaq\\llvm\\bin\\clang.exe")
    stock = "C:\\Program Files\\LLVM\\bin\\clang.exe"
    posix = "/usr/bin/clang"
    local = concat(getenv("HOME"), "/.local/share/buraaq/llvm/bin/clang")
    hit = l_pick_file(sidecar, stock, posix, local, "clang.exe", "clang")
    if len(hit) > 0 {
        return hit
    }
    "clang"
}

pub fn find_rt() -> text {
    root = getenv("BURAAQ_ROOT")
    if len(root) > 0 {
        p = concat(root, "/stdlib/runtime/buraaq_rt.c")
        if exists(p) {
            return p
        }
        p = concat(root, "/dist/sysroot/runtime/buraaq_rt.c")
        if exists(p) {
            return p
        }
        done = 1
    }
    sys = getenv("BURAAQ_SYSROOT")
    if len(sys) > 0 {
        p = concat(sys, "/runtime/buraaq_rt.c")
        if exists(p) {
            return p
        }
        done = 1
    }
    here = l_dir_of(arg(0))
    hit = l_pick_file(
        concat(here, "sysroot/runtime/buraaq_rt.c"),
        concat(here, "../stdlib/runtime/buraaq_rt.c"),
        concat(here, "../../stdlib/runtime/buraaq_rt.c"),
        "stdlib/runtime/buraaq_rt.c",
        "../stdlib/runtime/buraaq_rt.c",
        "../../stdlib/runtime/buraaq_rt.c"
    )
    if len(hit) > 0 {
        return hit
    }
    eprintln("buraaq-boot: cannot find buraaq_rt.c")
    exit(1)
    ""
}

