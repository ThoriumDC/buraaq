# Bootstrap parser — AST events match Rust `buraaq_parser` on the golden.
#
# The events are emitted in source order, so `a + b * c` and `a * b + c` produce
# the same stream. That makes the comparison in `bootstrap_m4` a check on what
# was recognised and in what order, not on the shape of the tree; precedence is
# checked where it is actually decided, in the emitter, by running the program.
#
# The scanner and the operator table live in `scan.bq`. They used to be copied
# here and again in `mir.bq`, which is how the MIR walker came to know three
# operators while this one knew thirteen.
use scan.scan_ident_end
use scan.scan_is_digit
use scan.scan_is_ident_start
use scan.scan_op_at
use scan.scan_op_len
use scan.scan_skip
use scan.scan_skip_string
use scan.scan_word_is
use std.fs.read
use std.io.println
use std.text.byte
use std.text.eq
use std.text.len
use std.text.slice

fn parse_type_name(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    e = scan_ident_end(src, i, n)
    println(slice(src, i, e))
    e
}

fn parse_prefix(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    c = byte(src, i)
    if c == 40 {
        i = parse_expr(src, i + 1, n)
        i = scan_skip(src, i, n)
        if byte(src, i) == 41 {
            i = i + 1
        }
        return i
    }
    if c == 45 {
        println("neg")
        return parse_prefix(src, i + 1, n)
    }
    if c == 33 {
        println("not")
        return parse_prefix(src, i + 1, n)
    }
    if c == 34 {
        println("str")
        return scan_skip_string(src, i, n)
    }
    if scan_is_digit(c) {
        e = i
        while e < n {
            if scan_is_digit(byte(src, e)) {
                e = e + 1
            } else {
                break
            }
        }
        println("int")
        println(slice(src, i, e))
        return e
    }
    if scan_is_ident_start(c) {
        e = scan_ident_end(src, i, n)
        name = slice(src, i, e)
        if eq(name, "true") {
            println("true")
            return e
        }
        if eq(name, "false") {
            println("false")
            return e
        }
        i = scan_skip(src, e, n)
        if byte(src, i) == 40 {
            println("app")
            println(name)
            return parse_args(src, i, n)
        }
        # The second byte has to be an identifier start or this is the `..` of a
        # range rather than a field.
        if byte(src, i) == 46 {
            if scan_is_ident_start(byte(src, i + 1)) {
                fe = scan_ident_end(src, i + 1, n)
                println("field")
                println(name)
                println(slice(src, i + 1, fe))
                return fe
            }
        }
        if byte(src, i) == 91 {
            println("index")
            println(name)
            i = parse_expr(src, i + 1, n)
            i = scan_skip(src, i, n)
            if byte(src, i) == 93 {
                i = i + 1
            }
            return i
        }
        println("ident")
        println(name)
        return e
    }
    i
}

fn parse_args(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    i = parse_expr(src, i, n)
    i = scan_skip(src, i, n)
    while byte(src, i) == 44 {
        i = parse_expr(src, i + 1, n)
        i = scan_skip(src, i, n)
    }
    if byte(src, i) == 41 {
        i = i + 1
    }
    i
}

fn parse_expr(src: text, idx: int, n: int) -> int {
    i = parse_prefix(src, idx, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 4 {
            break
        }
        i = scan_skip(src, i, n)
        op = scan_op_at(src, i, n)
        if eq(op, "") {
            return i
        }
        println("bin")
        println(op)
        i = parse_prefix(src, i + scan_op_len(op), n)
    }
    i
}

fn parse_block(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 4 {
            break
        }
        if byte(src, i) == 125 {
            return i + 1
        }
        i = parse_stmt(src, i, n)
        i = scan_skip(src, i, n)
    }
    i
}

fn parse_stmt(src: text, idx: int, n: int) -> int {
    i = idx
    if scan_word_is(src, i, n, "if") {
        return parse_if(src, i, n)
    }
    if scan_word_is(src, i, n, "while") {
        i = scan_skip(src, i + 5, n)
        println("while")
        i = parse_expr(src, i, n)
        return parse_block(src, i, n)
    }
    if scan_word_is(src, i, n, "for") {
        i = scan_skip(src, i + 3, n)
        e = scan_ident_end(src, i, n)
        println("for")
        println(slice(src, i, e))
        i = scan_skip(src, e, n)
        if scan_word_is(src, i, n, "in") {
            i = scan_skip(src, i + 2, n)
        }
        i = parse_expr(src, i, n)
        i = scan_skip(src, i, n)
        # `..` or `..=` separates the bounds; parse_expr stopped before it.
        if byte(src, i) == 46 {
            i = i + 2
            if byte(src, i) == 61 {
                i = i + 1
            }
        }
        i = parse_expr(src, i, n)
        return parse_block(src, i, n)
    }
    if scan_word_is(src, i, n, "break") {
        println("break")
        return i + 5
    }
    if scan_word_is(src, i, n, "continue") {
        println("continue")
        return i + 8
    }
    if scan_word_is(src, i, n, "return") {
        i = scan_skip(src, i + 6, n)
        println("return")
        if byte(src, i) == 125 {
            return i
        }
        return parse_expr(src, i, n)
    }
    # `name = expr`, but not `name == expr`.
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        j = scan_skip(src, e, n)
        if byte(src, j) == 61 {
            if byte(src, j + 1) != 61 {
                println("assign")
                println(slice(src, i, e))
                return parse_expr(src, j + 1, n)
            }
        }
    }
    parse_expr(src, i, n)
}

fn parse_if(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx + 2, n)
    println("if")
    i = parse_expr(src, i, n)
    i = parse_block(src, i, n)
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "elif") {
        println("else")
        return parse_if(src, i + 2, n)
    }
    if scan_word_is(src, i, n, "else") {
        println("else")
        i = scan_skip(src, i + 4, n)
        return parse_block(src, i, n)
    }
    i
}

fn parse_params(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    while i < n {
        i = scan_skip(src, i, n)
        e = scan_ident_end(src, i, n)
        println("param")
        println(slice(src, i, e))
        i = scan_skip(src, e, n)
        if byte(src, i) == 58 {
            i = scan_skip(src, i + 1, n)
            i = parse_type_name(src, i, n)
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 44 {
            i = i + 1
        } elif byte(src, i) == 41 {
            return i + 1
        } else {
            break
        }
    }
    i
}

fn parse_fn(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx + 2, n)
    e = scan_ident_end(src, i, n)
    println("fn")
    println(slice(src, i, e))
    i = parse_params(src, e, n)
    i = scan_skip(src, i, n)
    if byte(src, i) == 45 {
        if byte(src, i + 1) == 62 {
            i = scan_skip(src, i + 2, n)
            println("ret")
            i = parse_type_name(src, i, n)
        }
    }
    parse_block(src, i, n)
}

pub fn parse_file(path: text) {
    src = read(path)
    n = len(src)
    i = scan_skip(src, 0, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 4 {
            break
        }
        if scan_word_is(src, i, n, "fn") {
            i = parse_fn(src, i, n)
        } elif scan_word_is(src, i, n, "use") {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        } else {
            i = i + 1
        }
        i = scan_skip(src, i, n)
    }
}
