# M18 — MIR events across every construct the emitter can lower.
#
# A store for a binding, an icmp for a branch, a loop for `while` and `for`, a
# br for `break` and `continue`, and one operand stream per expression. It used
# to carry its own copy of the scanner and know three operators, so anything past
# `if`/`return` on the golden was read as an expression and lost. The scanner now
# comes from `scan.bq`, the same one the parser and the name table use.
use scan.scan_ident_end
use scan.scan_is_digit
use scan.scan_is_ident_start
use scan.scan_op_at
use scan.scan_op_len
use scan.scan_skip
use scan.scan_skip_string
use scan.scan_skip_type
use scan.scan_word_is
use std.fs.read
use std.io.println
use std.text.byte
use std.text.eq
use std.text.len
use std.text.slice

# The instruction each source operator lowers to. `scan_op_at` names the token;
# this names the machine.
fn g_emit_op(op: text) -> int {
    if eq(op, "Plus") {
        println("add")
        return 0
    }
    if eq(op, "Minus") {
        println("sub")
        return 0
    }
    if eq(op, "Star") {
        println("mul")
        return 0
    }
    if eq(op, "Slash") {
        println("sdiv")
        return 0
    }
    if eq(op, "Percent") {
        println("srem")
        return 0
    }
    if eq(op, "Gt") {
        println("sgt")
        return 0
    }
    if eq(op, "Ge") {
        println("sge")
        return 0
    }
    if eq(op, "Lt") {
        println("slt")
        return 0
    }
    if eq(op, "Le") {
        println("sle")
        return 0
    }
    if eq(op, "EqEq") {
        println("eq")
        return 0
    }
    if eq(op, "NotEq") {
        println("ne")
        return 0
    }
    if eq(op, "AndAnd") {
        println("and")
        return 0
    }
    if eq(op, "OrOr") {
        println("or")
        return 0
    }
    println("bin")
    0
}

fn g_args(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    i = g_expr(src, i, n)
    i = scan_skip(src, i, n)
    while byte(src, i) == 44 {
        i = g_expr(src, i + 1, n)
        i = scan_skip(src, i, n)
    }
    if byte(src, i) == 41 {
        i = i + 1
    }
    i
}

fn g_prefix(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    c = byte(src, i)
    if c == 40 {
        i = g_expr(src, i + 1, n)
        i = scan_skip(src, i, n)
        if byte(src, i) == 41 {
            i = i + 1
        }
        return i
    }
    if c == 45 {
        println("neg")
        return g_prefix(src, i + 1, n)
    }
    if c == 33 {
        println("not")
        return g_prefix(src, i + 1, n)
    }
    # A string is a constant the MIR holds by reference, not a value to read.
    if c == 34 {
        println("str")
        return scan_skip_string(src, i, n)
    }
    if scan_is_digit(c) {
        e = i
        while e < n {
            if scan_is_digit(byte(src, e)) {
                e = e + 1
            } else {
                break
            }
        }
        println("const")
        println(slice(src, i, e))
        return e
    }
    if scan_is_ident_start(c) {
        e = scan_ident_end(src, i, n)
        name = slice(src, i, e)
        if eq(name, "true") {
            println("const")
            println("1")
            return e
        }
        if eq(name, "false") {
            println("const")
            println("0")
            return e
        }
        i = scan_skip(src, e, n)
        if byte(src, i) == 40 {
            println("call")
            println(name)
            return g_args(src, i, n)
        }
        # The second byte has to be an identifier start or this is the `..` of a
        # range rather than a field.
        if byte(src, i) == 46 {
            if scan_is_ident_start(byte(src, i + 1)) {
                fe = scan_ident_end(src, i + 1, n)
                println("load")
                println(name)
                println(slice(src, i + 1, fe))
                return fe
            }
        }
        if byte(src, i) == 91 {
            println("load")
            println(name)
            i = g_expr(src, i + 1, n)
            i = scan_skip(src, i, n)
            if byte(src, i) == 93 {
                i = i + 1
            }
            return i
        }
        println(name)
        return e
    }
    i
}

fn g_expr(src: text, idx: int, n: int) -> int {
    i = g_prefix(src, idx, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 4 {
            break
        }
        i = scan_skip(src, i, n)
        op = scan_op_at(src, i, n)
        if eq(op, "") {
            return i
        }
        g_emit_op(op)
        i = g_prefix(src, i + scan_op_len(op), n)
    }
    i
}

fn g_stmt(src: text, idx: int, n: int) -> int {
    i = idx
    if scan_word_is(src, i, n, "if") {
        return g_if(src, i, n)
    }
    if scan_word_is(src, i, n, "while") {
        i = scan_skip(src, i + 5, n)
        println("loop")
        println("icmp")
        i = g_expr(src, i, n)
        return g_block(src, i, n)
    }
    if scan_word_is(src, i, n, "for") {
        i = scan_skip(src, i + 3, n)
        e = scan_ident_end(src, i, n)
        println("loop")
        println("store")
        println(slice(src, i, e))
        i = scan_skip(src, e, n)
        if scan_word_is(src, i, n, "in") {
            i = scan_skip(src, i + 2, n)
        }
        i = g_expr(src, i, n)
        i = scan_skip(src, i, n)
        if byte(src, i) == 46 {
            i = i + 2
            if byte(src, i) == 61 {
                i = i + 1
            }
        }
        i = g_expr(src, i, n)
        return g_block(src, i, n)
    }
    # Both leave the block by an unconditional branch.
    if scan_word_is(src, i, n, "break") {
        println("br")
        return i + 5
    }
    if scan_word_is(src, i, n, "continue") {
        println("br")
        return i + 8
    }
    if scan_word_is(src, i, n, "return") {
        i = scan_skip(src, i + 6, n)
        println("ret")
        if byte(src, i) == 125 {
            return i
        }
        return g_expr(src, i, n)
    }
    if scan_is_ident_start(byte(src, i)) {
        e = scan_ident_end(src, i, n)
        j = scan_skip(src, e, n)
        if byte(src, j) == 61 {
            if byte(src, j + 1) != 61 {
                println("store")
                println(slice(src, i, e))
                return g_expr(src, j + 1, n)
            }
        }
    }
    g_expr(src, i, n)
}

fn g_block(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    hops = 0
    while i < n {
        hops = hops + 1
        if hops > n + 4 {
            break
        }
        if byte(src, i) == 125 {
            return i + 1
        }
        i = g_stmt(src, i, n)
        i = scan_skip(src, i, n)
    }
    i
}

fn g_if(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx + 2, n)
    println("icmp")
    i = g_expr(src, i, n)
    i = g_block(src, i, n)
    i = scan_skip(src, i, n)
    if scan_word_is(src, i, n, "elif") {
        return g_if(src, i + 2, n)
    }
    if scan_word_is(src, i, n, "else") {
        i = scan_skip(src, i + 4, n)
        return g_block(src, i, n)
    }
    i
}

fn g_params(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = scan_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    while i < n {
        i = scan_skip(src, i, n)
        e = scan_ident_end(src, i, n)
        println("param")
        println(slice(src, i, e))
        i = scan_skip(src, e, n)
        if byte(src, i) == 58 {
            i = scan_skip_type(src, i + 1, n)
        }
        i = scan_skip(src, i, n)
        if byte(src, i) == 44 {
            i = i + 1
        } elif byte(src, i) == 41 {
            return i + 1
        } else {
            break
        }
    }
    i
}

fn g_fn(src: text, idx: int, n: int) -> int {
    i = scan_skip(src, idx + 2, n)
    e = scan_ident_end(src, i, n)
    println("fn")
    println(slice(src, i, e))
    i = g_params(src, e, n)
    i = scan_skip(src, i, n)
    if byte(src, i) == 45 {
        if byte(src, i + 1) == 62 {
            i = scan_skip_type(src, i + 2, n)
        }
    }
    i = g_block(src, i, n)
    # Every body falls out to a return, whether or not it was written.
    println("ret")
    i
}

pub fn dump_mir(path: text) {
    src = read(path)
    n = len(src)
    i = scan_skip(src, 0, n)
    while i < n {
        if scan_word_is(src, i, n, "fn") {
            i = g_fn(src, i, n)
        } elif scan_word_is(src, i, n, "use") {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        } else {
            i = i + 1
        }
        i = scan_skip(src, i, n)
    }
}
